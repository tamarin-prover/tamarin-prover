                      next
                        case case_3
                        by contradiction /* from formulas */
                      qed
                    qed
                  next
                    case Server_ReceiveOTP_NewSession
                    solve( !KU( senc(<~sid, (otc add z), ~pr.2>, ~k) ) @ #vk.16 )
                      case Yubikey_PressButton
                      solve( Server( ~pid, ~sid, otc2 ) ▶₀ #t2 )
                        case Server_ReceiveOTP_NewSession
                        solve( ((#vr.11 < #t1) ∧
                                (∃ z.3. ((otc.1 add z.2 add z.3) = (otc add z add z.1))))  ∥
