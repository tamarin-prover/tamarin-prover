theory untraceable

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, snd/1, unionUD/1 [destructor], add/2 [AC]
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    unionUD((x add y)) = x

rule (modulo E) setup:
   [ Fr( key1 ), Fr( key2 ) ]
  --[ Setup( ) ]->
   [
   Reader( ('1' add diff((key1 add key2), (key1 add key1))) ),
   Tag( ('1' add diff((key1 add key2), (key1 add key1))) )
   ]

rule (modulo E) select_tag:
   [ Tag( (~k add z) ) ]
  --[ Tag( (~k add z) ) ]->
   [ TagRun( ~k ), Tag( z ) ]

rule (modulo E) select_reader:
   [ Reader( (~k add z) ) ]
  --[ Reader( (~k add z) ) ]->
   [ ReaderRun( ~k ), Reader( z ) ]

rule (modulo E) reader1:
   [ Fr( ~nr ) ] --> [ Reader1( ~nr ), Out( ~nr ) ]

rule (modulo E) tag1:
   [ In( x ), TagRun( k ), Fr( ~nt ) ]
  --[ TagRun( k ) ]->
   [ Out( <~nt, h(<x, k, ~nt>)> ) ]

rule (modulo E) reader2:
   [ Reader1( ~nr ), ReaderRun( k ), In( <nt, h(<~nr, k, nt>)> ) ]
  --[ Finished( ) ]->
   [ ]

restriction max_number_of_tags_tag [right]:
  "∀ a b c d #i. (Tag( (a add b add c add d) ) @ #i) ⇒ (⊥)"
  // safety formula

restriction max_number_of_tags_tag [left]:
  "∀ a b c d #i. (Tag( (a add b add c add d) ) @ #i) ⇒ (⊥)"
  // safety formula

restriction max_number_of_tags_tag_reader [right]:
  "∀ a b c d #i. (Reader( (a add b add c add d) ) @ #i) ⇒ (⊥)"
  // safety formula

restriction max_number_of_tags_tag_reader [left]:
  "∀ a b c d #i. (Reader( (a add b add c add d) ) @ #i) ⇒ (⊥)"
  // safety formula

lemma executable [right]:
  exists-trace "∃ #i. Finished( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Finished( ) @ #i)"
*/
simplify
solve( Reader1( ~nr ) ▶₀ #i )
  case reader1
  solve( ReaderRun( k ) ▶₁ #i )
    case select_reader
    solve( !KU( h(<~nr, ~k, nt>) ) @ #vk.2 )
      case tag1
      solve( Reader( (~k add z) ) ▶₀ #vr.1 )
        case select_reader
        solve( Tag( (~k add z.1) ) ▶₀ #vr.4 )
          case select_tag
          solve( Reader( (~k add z add ~k.1) ) ▶₀ #vr.5 )
            case setup
            solve( Tag( (~k add z add ~k.1) ) ▶₀ #vr.6 )
              case setup
              solve( !KU( ~nr ) @ #vk.3 )
                case reader1
                solve( !KU( ~nt ) @ #vk.3 )
                  case tag1
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable [left]:
  exists-trace "∃ #i. Finished( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Finished( ) @ #i)"
*/
simplify
solve( Reader1( ~nr ) ▶₀ #i )
  case reader1
  solve( ReaderRun( k ) ▶₁ #i )
    case select_reader
    solve( !KU( h(<~nr, ~k, nt>) ) @ #vk.2 )
      case tag1
      solve( Reader( (~k add z) ) ▶₀ #vr.1 )
        case select_reader
        solve( Tag( (~k add z.1) ) ▶₀ #vr.4 )
          case select_tag
          solve( Reader( (~k add z add ~k.1) ) ▶₀ #vr.5 )
            case setup_case_1
            solve( Tag( (~k add z add ~k.2) ) ▶₀ #vr.6 )
              case setup
              solve( !KU( ~nr ) @ #vk.3 )
                case reader1
                solve( !KU( ~nt ) @ #vk.3 )
                  case tag1
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

