theory alethea_selectionphase_anonymity

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, h/1, pair/2, pk/1, sdec/2, senc/2,
           sign/2, snd/1, true/0, unionUD/1 [destructor], verify/3, add/2 [AC]
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    unionUD((x add y)) = x,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) ChanOut_S:
   [ Out_S( $A, $B, x ) ]
  --[ ChanOut_S( $A, $B, x ) ]->
   [ !Sec( $A, $B, x ) ]

rule (modulo E) ChanIn_S:
   [ !Sec( $A, $B, x ) ] --[ ChanIn_S( $A, $B, x ) ]-> [ In_S( $A, $B, x ) ]

rule (modulo E) ChanOut_A:
   [ Out_A( $A, x ) ]
  --[ ChanOut_A( $A, x ) ]->
   [ !Auth( $A, x ), Out( <$A, x> ) ]

rule (modulo E) ChanIn_A:
   [ !Auth( $A, x ) ] --[ ChanIn_A( $A, x ) ]-> [ In_A( $A, x ) ]

rule (modulo E) publickeyinfrastructure:
   [ Fr( ~skX ) ]
  --[ LongtermKey( $X, ~skX ) ]->
   [ !Ltk( $X, ~skX ), !Pk( $X, pk(~skX) ), Out( pk(~skX) ) ]

rule (modulo E) Setup:
   [
   Fr( ~x1 ), Fr( ~x2 ), !Ltk( 'S', ~skS ), !Ltk( 'D1', ~skD1 ),
   !Ltk( 'D2', ~skD2 )
   ]
  --[
  Setup( ),
  Comm_S_Ys( 'S',
             <'ys', 
              (diff(h(<'H1', ~x1>), h(<'H2', ~x2>)) add 
               diff(h(<'H2', ~x2>), h(<'H1', ~x1>)))
             >
  ),
  Running( 'S', 'D1', <pk(~skD1), 'H1', ~x1> ),
  Running( 'S', 'D2', <pk(~skD2), 'H2', ~x2> ),
  BB_Ys( 'BB', 'ys',
         (diff(h(<'H1', ~x1>), h(<'H2', ~x2>)) add 
          diff(h(<'H2', ~x2>), h(<'H1', ~x1>)))
  )
  ]->
   [
   AgSt_D0( diff(<'D1', ~skD1, 'S', pk(~skS), 'H1'>, <'D2', ~skD2, 'S', 
                                                      pk(~skS), 'H2'>)
   ),
   AgSt_D0( diff(<'D2', ~skD2, 'S', pk(~skS), 'H2'>, <'D1', ~skD1, 'S', 
                                                      pk(~skS), 'H1'>)
   ),
   AgSt_S0( 'S', 'BB', ~skS,
            diff(<'H1', 'D1', pk(~skD1), ~x1>, <'H2', 'D2', pk(~skD2), ~x2>),
            diff(<'H2', 'D2', pk(~skD2), ~x2>, <'H1', 'D1', pk(~skD1), ~x1>)
   ),
   AgSt_H0( diff(<'H1', 'D1', 'S', 'BB'>, <'H2', 'D2', 'S', 'BB'>) ),
   AgSt_H0( diff(<'H2', 'D2', 'S', 'BB'>, <'H1', 'D1', 'S', 'BB'>) ),
   Out_A( 'S', diff(aenc(~x1, pk(~skD1)), aenc(~x2, pk(~skD2))) ),
   Out_A( 'S', diff(aenc(~x2, pk(~skD2)), aenc(~x1, pk(~skD1))) ),
   Out_A( $BB,
          <'ys', 
           (diff(h(<'H1', ~x1>), h(<'H2', ~x2>)) add 
            diff(h(<'H2', ~x2>), h(<'H1', ~x1>)))
          >
   )
   ]

rule (modulo E) D_4:
   [ AgSt_D0( <$D, ~skD, $S, pkS, $H> ), In_A( $S, aenc(x, pk(~skD)) ) ]
  --[
  Commit( $D, $S, <pk(~skD), $H, x> ), Comm_D_Y( $D, h(<$H, x>) ),
  Secret( $D, x )
  ]->
   [ Out_S( $D, $H, h(<$H, x>) ) ]

rule (modulo E) H_5:
   [
   AgSt_H0( <$H, $D, $S, $BB> ), In_S( $D, $H, yD ),
   In_A( $BB, <'ys', (y1 add y2)> )
   ]
  --[ Learn_H_yD( $H, $D, yD ), Learn_H_Ys( $H, $S, <'ys', (y1 add y2)> )
  ]->
   [ AgSt_H5( $H, <$D, $S, $BB, yD, y1, y2> ) ]

rule (modulo E) S_7:
   [
   AgSt_S0( $S, $BB, ~skS, <$HSel, $DSel, pkDSel, ~xSel>,
            <$HNotsel, $DNotsel, pkDNotsel, ~xNotsel>
   )
   ]
  --[
  Comm_S_ySG( $S, <'ySG', h(<$HSel, ~xSel>)> ),
  BB_ySG( $BB, <'ySG', h(<$HSel, ~xSel>)> )
  ]->
   [ Out_A( $BB, <'ySG', h(<$HSel, ~xSel>)> ) ]

rule (modulo E) H_9:
   [ AgSt_H5( $H, <$D, $S, $BB, yD, y1, y2> ), In_A( $BB, <'ySG', ySG> ) ]
  --[ Learn_H_ySG( $H, $S, <'ySG', ySG> ) ]->
   [ ]

restriction OneSetup [right]:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OneSetup [left]:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma functional [right]:
  exists-trace
  "(∀ #s1 #s2. ((Setup( ) @ #s1) ∧ (Setup( ) @ #s2)) ⇒ (#s1 = #s2)) ∧
   (∃ #i #j1 #j2 #k1 #k2 #l #m1 #m2 S H1 H2 D1 D2 x1 x2 ySG.
     ((((((((((¬(H1 = H2)) ∧
              (Comm_S_Ys( S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #i)) ∧
             (Comm_D_Y( D1, h(<H1, x1>) ) @ #j1)) ∧
            (Comm_D_Y( D2, h(<H2, x2>) ) @ #j2)) ∧
           (Learn_H_yD( H1, D1, h(<H1, x1>) ) @ #k1)) ∧
          (Learn_H_yD( H2, D2, h(<H2, x2>) ) @ #k2)) ∧
         (Learn_H_Ys( H1, S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #k1)) ∧
        (Learn_H_Ys( H2, S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #k2)) ∧
       (Comm_S_ySG( S, <'ySG', ySG> ) @ #l)) ∧
      (Learn_H_ySG( H1, S, <'ySG', ySG> ) @ #m1)) ∧
     (Learn_H_ySG( H2, S, <'ySG', ySG> ) @ #m2))"
/*
guarded formula characterizing all satisfying traces:
"(∀ #s1 #s2. (Setup( ) @ #s1) ∧ (Setup( ) @ #s2) ⇒ #s1 = #s2) ∧
 (∃ #i #j1 #j2 #k1 #k2 #l #m1 #m2 S H1 H2 D1 D2 x1 x2 ySG.
   (Comm_S_Ys( S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #i) ∧
   (Comm_D_Y( D1, h(<H1, x1>) ) @ #j1) ∧
   (Comm_D_Y( D2, h(<H2, x2>) ) @ #j2) ∧
   (Learn_H_yD( H1, D1, h(<H1, x1>) ) @ #k1) ∧
   (Learn_H_yD( H2, D2, h(<H2, x2>) ) @ #k2) ∧
   (Learn_H_Ys( H1, S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #k1) ∧
   (Learn_H_Ys( H2, S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #k2) ∧
   (Comm_S_ySG( S, <'ySG', ySG> ) @ #l) ∧
   (Learn_H_ySG( H1, S, <'ySG', ySG> ) @ #m1) ∧
   (Learn_H_ySG( H2, S, <'ySG', ySG> ) @ #m2)
  ∧
   ¬(H1 = H2))"
*/
simplify
  case 1
  solve( !Ltk( 'S', ~skS ) ▶₂ #i )
    case publickeyinfrastructure
    solve( !Ltk( 'D1', ~skD1 ) ▶₃ #i )
      case publickeyinfrastructure
      solve( !Ltk( 'D2', ~skD2 ) ▶₄ #i )
        case publickeyinfrastructure
        solve( AgSt_D0( <$D, ~skD, $S, pkS, 'H1'> ) ▶₀ #j1 )
          case Setup
          solve( In_A( 'S', aenc(~x1, pk(~skD)) ) ▶₁ #j1 )
            case ChanIn_A
            solve( AgSt_D0( <$D, ~skD.1, $S, pkS, 'H2'> ) ▶₀ #j2 )
              case Setup
              solve( In_A( 'S', aenc(~x2, pk(~skD2)) ) ▶₁ #j2 )
                case ChanIn_A
                solve( AgSt_H0( <'H1', 'D1', 'S', $BB.1> ) ▶₀ #k1 )
                  case Setup
                  solve( In_S( 'D1', 'H1', h(<'H1', ~x1>) ) ▶₁ #k1 )
                    case ChanIn_S
                    solve( In_A( 'BB', <'ys', (h(<'H1', ~x1>) add h(<'H2', ~x2>))> ) ▶₂ #k1 )
                      case ChanIn_A
                      solve( AgSt_H0( <'H2', 'D2', 'S', $BB> ) ▶₀ #k2 )
                        case Setup
                        solve( In_S( 'D2', 'H2', h(<'H2', ~x2>) ) ▶₁ #k2 )
                          case ChanIn_S
                          solve( In_A( 'BB', <'ys', (h(<'H1', ~x1>) add h(<'H2', ~x2>))> ) ▶₂ #k2 )
                            case ChanIn_A
                            solve( AgSt_S0( 'S', $BB, ~skS.1, <$HSel, $DSel, pkDSel, ~xSel>,
                                            <$HNotsel, $DNotsel, pkDNotsel, ~xNotsel>
                                   ) ▶₀ #l )
                              case Setup
                              solve( AgSt_H5( 'H1', <$D, 'S', $BB, yD, y1, y2> ) ▶₀ #m1 )
                                case H_5
                                solve( In_A( 'BB', <'ySG', h(<'H2', ~x2>)> ) ▶₁ #m1 )
                                  case ChanIn_A
                                  solve( AgSt_H5( 'H2', <$D, 'S', $BB, yD, y1, y2> ) ▶₀ #m2 )
                                    case H_5
                                    solve( In_A( 'BB', <'ySG', h(<'H2', ~x2>)> ) ▶₁ #m2 )
                                      case ChanIn_A
                                      SOLVED // trace found
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma functional [left]:
  exists-trace
  "(∀ #s1 #s2. ((Setup( ) @ #s1) ∧ (Setup( ) @ #s2)) ⇒ (#s1 = #s2)) ∧
   (∃ #i #j1 #j2 #k1 #k2 #l #m1 #m2 S H1 H2 D1 D2 x1 x2 ySG.
     ((((((((((¬(H1 = H2)) ∧
              (Comm_S_Ys( S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #i)) ∧
             (Comm_D_Y( D1, h(<H1, x1>) ) @ #j1)) ∧
            (Comm_D_Y( D2, h(<H2, x2>) ) @ #j2)) ∧
           (Learn_H_yD( H1, D1, h(<H1, x1>) ) @ #k1)) ∧
          (Learn_H_yD( H2, D2, h(<H2, x2>) ) @ #k2)) ∧
         (Learn_H_Ys( H1, S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #k1)) ∧
        (Learn_H_Ys( H2, S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #k2)) ∧
       (Comm_S_ySG( S, <'ySG', ySG> ) @ #l)) ∧
      (Learn_H_ySG( H1, S, <'ySG', ySG> ) @ #m1)) ∧
     (Learn_H_ySG( H2, S, <'ySG', ySG> ) @ #m2))"
/*
guarded formula characterizing all satisfying traces:
"(∀ #s1 #s2. (Setup( ) @ #s1) ∧ (Setup( ) @ #s2) ⇒ #s1 = #s2) ∧
 (∃ #i #j1 #j2 #k1 #k2 #l #m1 #m2 S H1 H2 D1 D2 x1 x2 ySG.
   (Comm_S_Ys( S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #i) ∧
   (Comm_D_Y( D1, h(<H1, x1>) ) @ #j1) ∧
   (Comm_D_Y( D2, h(<H2, x2>) ) @ #j2) ∧
   (Learn_H_yD( H1, D1, h(<H1, x1>) ) @ #k1) ∧
   (Learn_H_yD( H2, D2, h(<H2, x2>) ) @ #k2) ∧
   (Learn_H_Ys( H1, S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #k1) ∧
   (Learn_H_Ys( H2, S, <'ys', (h(<H1, x1>) add h(<H2, x2>))> ) @ #k2) ∧
   (Comm_S_ySG( S, <'ySG', ySG> ) @ #l) ∧
   (Learn_H_ySG( H1, S, <'ySG', ySG> ) @ #m1) ∧
   (Learn_H_ySG( H2, S, <'ySG', ySG> ) @ #m2)
  ∧
   ¬(H1 = H2))"
*/
simplify
  case 1
  solve( !Ltk( 'S', ~skS ) ▶₂ #i )
    case publickeyinfrastructure
    solve( !Ltk( 'D1', ~skD1 ) ▶₃ #i )
      case publickeyinfrastructure
      solve( !Ltk( 'D2', ~skD2 ) ▶₄ #i )
        case publickeyinfrastructure
        solve( AgSt_D0( <$D, ~skD, $S, pkS, 'H1'> ) ▶₀ #j1 )
          case Setup
          solve( In_A( 'S', aenc(~x1, pk(~skD)) ) ▶₁ #j1 )
            case ChanIn_A
            solve( AgSt_D0( <$D, ~skD.1, $S, pkS, 'H2'> ) ▶₀ #j2 )
              case Setup
              solve( In_A( 'S', aenc(~x2, pk(~skD2)) ) ▶₁ #j2 )
                case ChanIn_A
                solve( AgSt_H0( <'H1', 'D1', 'S', $BB.1> ) ▶₀ #k1 )
                  case Setup
                  solve( In_S( 'D1', 'H1', h(<'H1', ~x1>) ) ▶₁ #k1 )
                    case ChanIn_S
                    solve( In_A( 'BB', <'ys', (h(<'H1', ~x1>) add h(<'H2', ~x2>))> ) ▶₂ #k1 )
                      case ChanIn_A
                      solve( AgSt_H0( <'H2', 'D2', 'S', $BB> ) ▶₀ #k2 )
                        case Setup
                        solve( In_S( 'D2', 'H2', h(<'H2', ~x2>) ) ▶₁ #k2 )
                          case ChanIn_S
                          solve( In_A( 'BB', <'ys', (h(<'H1', ~x1>) add h(<'H2', ~x2>))> ) ▶₂ #k2 )
                            case ChanIn_A
                            solve( AgSt_S0( 'S', $BB, ~skS.1, <$HSel, $DSel, pkDSel, ~xSel>,
                                            <$HNotsel, $DNotsel, pkDNotsel, ~xNotsel>
                                   ) ▶₀ #l )
                              case Setup
                              solve( AgSt_H5( 'H1', <$D, 'S', $BB, yD, y1, y2> ) ▶₀ #m1 )
                                case H_5
                                solve( In_A( 'BB', <'ySG', h(<'H1', ~x1>)> ) ▶₁ #m1 )
                                  case ChanIn_A
                                  solve( AgSt_H5( 'H2', <$D, 'S', $BB, yD, y1, y2> ) ▶₀ #m2 )
                                    case H_5
                                    solve( In_A( 'BB', <'ySG', h(<'H1', ~x1>)> ) ▶₁ #m2 )
                                      case ChanIn_A
                                      SOLVED // trace found
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma individualVerifiability_votercode [right]:
  all-traces
  "∀ H D yD #h1 S yOther #h2.
    ((Learn_H_yD( H, D, yD ) @ #h1) ∧
     (Learn_H_Ys( H, S, <'ys', (yD add yOther)> ) @ #h2)) ⇒
    (∃ x BB y2 #b1.
      (BB_Ys( BB, 'ys', (y2 add yD) ) @ #b1) ∧ (yD = h(<H, x>)))"
/*
guarded formula characterizing all counter-examples:
"∃ H D yD #h1 S yOther #h2.
  (Learn_H_yD( H, D, yD ) @ #h1) ∧
  (Learn_H_Ys( H, S, <'ys', (yD add yOther)> ) @ #h2)
 ∧
  ∀ x BB y2 #b1.
   (BB_Ys( BB, 'ys', (y2 add yD) ) @ #b1) ∧ (yD = h(<H, x>)) ⇒ ⊥"
*/
simplify
  case 1
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    solve( In_S( 'D2', 'H2', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  next
    case Setup_case_2
    solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  qed
next
  case 2
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    solve( In_S( 'D2', 'H2', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  next
    case Setup_case_2
    solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  qed
next
  case 3
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    solve( In_S( 'D2', 'H2', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  next
    case Setup_case_2
    solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  qed
next
  case 4
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    solve( In_S( 'D2', 'H2', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  next
    case Setup_case_2
    solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  qed
next
  case 5
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    by solve( In_S( 'D2', 'H2', (x add y1) ) ▶₁ #h1 )
  next
    case Setup_case_2
    by solve( In_S( 'D1', 'H1', (x add y1) ) ▶₁ #h1 )
  qed
next
  case 6
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    by solve( In_S( 'D2', 'H2', (x add y2) ) ▶₁ #h1 )
  next
    case Setup_case_2
    by solve( In_S( 'D1', 'H1', (x add y2) ) ▶₁ #h1 )
  qed
next
  case 7
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    by solve( In_S( 'D2', 'H2', (x add x.1) ) ▶₁ #h1 )
  next
    case Setup_case_2
    by solve( In_S( 'D1', 'H1', (x add x.1) ) ▶₁ #h1 )
  qed
qed

lemma individualVerifiability_votercode [left]:
  all-traces
  "∀ H D yD #h1 S yOther #h2.
    ((Learn_H_yD( H, D, yD ) @ #h1) ∧
     (Learn_H_Ys( H, S, <'ys', (yD add yOther)> ) @ #h2)) ⇒
    (∃ x BB y2 #b1.
      (BB_Ys( BB, 'ys', (y2 add yD) ) @ #b1) ∧ (yD = h(<H, x>)))"
/*
guarded formula characterizing all counter-examples:
"∃ H D yD #h1 S yOther #h2.
  (Learn_H_yD( H, D, yD ) @ #h1) ∧
  (Learn_H_Ys( H, S, <'ys', (yD add yOther)> ) @ #h2)
 ∧
  ∀ x BB y2 #b1.
   (BB_Ys( BB, 'ys', (y2 add yD) ) @ #b1) ∧ (yD = h(<H, x>)) ⇒ ⊥"
*/
simplify
  case 1
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  next
    case Setup_case_2
    solve( In_S( 'D2', 'H2', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  qed
next
  case 2
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  next
    case Setup_case_2
    solve( In_S( 'D2', 'H2', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  qed
next
  case 3
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  next
    case Setup_case_2
    solve( In_S( 'D2', 'H2', yD ) ▶₁ #h1 )
      case ChanIn_S
      by contradiction /* from formulas */
    qed
  qed
next
  case 4
  solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
    case Setup_case_1
    solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
      case ChanIn_S
