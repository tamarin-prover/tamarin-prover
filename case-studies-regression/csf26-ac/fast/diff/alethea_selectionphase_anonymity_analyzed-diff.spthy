lemma secret_x [right]:
  all-traces "∀ D x #i. (Secret( D, x ) @ #i) ⇒ (¬(∃ #j. K( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ D x #i. (Secret( D, x ) @ #i) ∧ ∃ #j. (K( x ) @ #j)"
*/
simplify
solve( AgSt_D0( <$D, ~skD, $S, pkS, $H> ) ▶₀ #i )
  case Setup_case_1
  solve( In_A( 'S', aenc(x, pk(~skD)) ) ▶₁ #i )
    case ChanIn_A
    solve( !KU( ~x2 ) @ #vk )
      case ChanOut_A
      by solve( !KU( ~skD ) @ #vk.1 )
    qed
  qed
next
  case Setup_case_2
  solve( In_A( 'S', aenc(x, pk(~skD)) ) ▶₁ #i )
    case ChanIn_A
    solve( !KU( ~x1 ) @ #vk )
      case ChanOut_A
      by solve( !KU( ~skD ) @ #vk.1 )
    qed
  qed
qed

