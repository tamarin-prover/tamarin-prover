lemma agreementHwrtS [right]:
  all-traces
  "(∀ H S x #i.
     (Learn_H_Ys( H, S, x ) @ #i) ⇒
     (∃ #j. (Comm_S_Ys( S, x ) @ #j) ∧ (#j < #i))) ∧
   (∀ H S x #i.
     (Learn_H_ySG( H, S, x ) @ #i) ⇒
     (∃ #j. (Comm_S_ySG( S, x ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"((∃ H S x #i.
    (Learn_H_Ys( H, S, x ) @ #i)
   ∧
    ∀ #j. (Comm_S_Ys( S, x ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ H S x #i.
    (Learn_H_ySG( H, S, x ) @ #i)
   ∧
    ∀ #j. (Comm_S_ySG( S, x ) @ #j) ⇒ ¬(#j < #i)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (∃ H S x #i.
           (Learn_H_Ys( H, S, x ) @ #i)
          ∧
           ∀ #j. (Comm_S_Ys( S, x ) @ #j) ⇒ ¬(#j < #i))  ∥
         (∃ H S x #i.
           (Learn_H_ySG( H, S, x ) @ #i)
          ∧
           ∀ #j. (Comm_S_ySG( S, x ) @ #j) ⇒ ¬(#j < #i)) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #j.
             (Comm_S_Ys( $S, <'ys', (y1 add y2)> ) @ #j)
            ∧
             (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #i )
        case Setup_case_1
        solve( In_S( 'D2', 'H2', yD ) ▶₁ #i )
          case ChanIn_S
          solve( In_A( 'BB', <'ys', (y1 add y2)> ) ▶₂ #i )
            case ChanIn_A_case_1
            by contradiction /* from formulas */
          next
            case ChanIn_A_case_2
            by contradiction /* from formulas */
          qed
        qed
      next
        case Setup_case_2
        solve( In_S( 'D1', 'H1', yD ) ▶₁ #i )
          case ChanIn_S
          solve( In_A( 'BB', <'ys', (y1 add y2)> ) ▶₂ #i )
            case ChanIn_A_case_1
            by contradiction /* from formulas */
          next
            case ChanIn_A_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2_case_1
      by contradiction /* from formulas */
    next
      case case_2_case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (last(#i))  ∥
           (∃ #j.
             (Comm_S_ySG( $S, <'ySG', ySG> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( AgSt_H5( $H, <$D, $S, $BB, yD, y1, y2> ) ▶₀ #i )
        case H_5_case_1
        solve( In_A( 'BB', <'ySG', ySG> ) ▶₁ #i )
          case ChanIn_A
          by contradiction /* from formulas */
        qed
      next
        case H_5_case_2
        solve( In_A( 'BB', <'ySG', ySG> ) ▶₁ #i )
          case ChanIn_A
          by contradiction /* from formulas */
        qed
      next
        case H_5_case_3
        solve( In_A( 'BB', <'ySG', ySG> ) ▶₁ #i )
          case ChanIn_A
          by contradiction /* from formulas */
        qed
      next
        case H_5_case_4
        solve( In_A( 'BB', <'ySG', ySG> ) ▶₁ #i )
          case ChanIn_A
          by contradiction /* from formulas */
        qed
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  qed
qed

