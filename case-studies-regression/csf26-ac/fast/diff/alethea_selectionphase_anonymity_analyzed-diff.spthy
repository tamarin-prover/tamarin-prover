lemma individualVerifiability_sel [right]:
  all-traces
  "∀ H D yD #h1 S #h2.
    ((Learn_H_yD( H, D, yD ) @ #h1) ∧
     (Learn_H_ySG( H, S, <'ySG', yD> ) @ #h2)) ⇒
    (∃ x BB #b1. (BB_ySG( BB, <'ySG', yD> ) @ #b1) ∧ (yD = h(<H, x>)))"
/*
guarded formula characterizing all counter-examples:
"∃ H D yD #h1 S #h2.
  (Learn_H_yD( H, D, yD ) @ #h1) ∧ (Learn_H_ySG( H, S, <'ySG', yD> ) @ #h2)
 ∧
  ∀ x BB #b1. (BB_ySG( BB, <'ySG', yD> ) @ #b1) ∧ (yD = h(<H, x>)) ⇒ ⊥"
*/
simplify
solve( AgSt_H0( <$H, $D, $S, $BB> ) ▶₀ #h1 )
  case Setup_case_1
  solve( In_S( 'D2', 'H2', yD ) ▶₁ #h1 )
    case ChanIn_S
    solve( In_A( 'BB', <'ys', (y1 add y2)> ) ▶₂ #h1 )
      case ChanIn_A_case_1
      solve( AgSt_H5( 'H2', <$D, $S, $BB, yD, y1, y2> ) ▶₀ #h2 )
        case H_5
        solve( In_A( 'BB', <'ySG', h(<'H2', ~x2>)> ) ▶₁ #h2 )
          case ChanIn_A
          by contradiction /* from formulas */
        qed
      qed
    next
      case ChanIn_A_case_2
      solve( AgSt_H5( 'H2', <$D, $S, $BB, yD, y1, y2> ) ▶₀ #h2 )
        case H_5
        solve( In_A( 'BB', <'ySG', h(<'H2', ~x2>)> ) ▶₁ #h2 )
          case ChanIn_A
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case Setup_case_2
  solve( In_S( 'D1', 'H1', yD ) ▶₁ #h1 )
    case ChanIn_S
    solve( In_A( 'BB', <'ys', (y1 add y2)> ) ▶₂ #h1 )
      case ChanIn_A_case_1
      solve( AgSt_H5( 'H1', <$D, $S, $BB, yD, y1, y2> ) ▶₀ #h2 )
        case H_5
        by solve( In_A( 'BB', <'ySG', h(<'H1', ~x1>)> ) ▶₁ #h2 )
      qed
    next
      case ChanIn_A_case_2
      solve( AgSt_H5( 'H1', <$D, $S, $BB, yD, y1, y2> ) ▶₀ #h2 )
        case H_5
        by solve( In_A( 'BB', <'ySG', h(<'H1', ~x1>)> ) ▶₁ #h2 )
      qed
    qed
  qed
qed

