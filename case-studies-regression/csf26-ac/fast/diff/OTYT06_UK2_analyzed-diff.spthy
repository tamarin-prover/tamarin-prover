diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Equality
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case tag1
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case h
        step( solve( Tag( ~k, x ) ▶₁ #vr ) )
          case Setup
          step( solve( !KU( h(z) ) @ #vk ) )
            case Setup
            step( solve( splitEqs(0) ) )
              case split_case_2
              step( solve( !KU( (~k xorr ~newKey1 xorr ~r) ) @ #vk.1 ) )
                case c_xorr_case_3
                step( solve( !KU( ~r ) @ #vk.2 ) )
                  case Setup
                  step( solve( !KU( (~k xorr ~newKey1) ) @ #vk.3 ) )
                    case coerce
                    step( solve( !KD( (~k xorr ~newKey1) ) ▶₀ #vk.3 ) )
                      case Setup
                      step( solve( (#vl.1, 0) ~~> (#vk.3, 0) ) )
                        case d_0_snd
                        step( solve( (#vr.5, 0) ~~> (#vk.3, 0) ) )
                          case d_0_snd
                          step( solve( (#vr.6, 0) ~~> (#vk.3, 0) ) )
                            case xorr
                            by ATTACK // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

