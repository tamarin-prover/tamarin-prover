theory exponentialMixnet

begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: expo/2 [NDC,NDC-diff], fst/1, pair/2, snd/1, true/0, verify/3,
           zkp/3, m/2 [AC]
equations:
    expo(expo(g, x), y) = expo(g, (x m y)),
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(zkp(expo(g, x), x, g), expo(g, x), g) = true

rule (modulo E) genKey:
   [ Fr( ~skA ), Fr( ~skB ) ]
  --[ OnlyOnce( ) ]->
   [
   FstKey( diff(expo('g', ~skA), expo('g', ~skB)) ),
   SndKey( diff(expo('g', ~skB), expo('g', ~skA)) ),
   Out( <'A', expo('g', ~skA)> ), Out( <'B', expo('g', ~skB)> )
   ]

rule (modulo E) mixnet:
   [ FstKey( n1 ), SndKey( n2 ), In( n3 ), Fr( ~r ) ]
  -->
   [ Out( <expo(n1, ~r), expo(n2, ~r), expo(n3, ~r)> ), Out( expo('g', ~r) )
   ]

restriction OnlyOnce [right]:
  "∀ #j #i. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OnlyOnce [left]:
  "∀ #j #i. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Destrd_0_0_verify_zkp
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( expo(x, x.1) ) ▶₀ #i ) )
      case genKey_case_1
      step( solve( (#vl, 0) ~~> (#i, 0) ) )
        case d_0_fst
        by step( solve( (#vr.1, 0) ~~> (#i, 0) ) )
      next
        case d_0_snd
        step( solve( (#vr.1, 0) ~~> (#i, 0) ) )
          case d_0_0_verify_zkp
          by step( solve( (#vr.2, 0) ~~> (#i, 0) ) )
        next
          case d_0_expo
          step( solve( (#vr.2, 0) ~~> (#i, 0) ) )
            case d_0_0_verify_zkp
            by step( solve( (#vr.3, 0) ~~> (#i, 0) ) )
          next
            case d_2_verify
            by step( solve( (#vr.3, 0) ~~> (#i, 0) ) )
          next
            case expo
            step( solve( !KU( (~skA m x) ) @ #vk.2 ) )
              case c_m_case_1
              by step( solve( !KU( ~skA ) @ #vk.4 ) )
            next
              case c_m_case_2
              step( solve( !KU( (~skA m x.1) ) @ #vk.5 ) )
                case c_m_case_1
                by step( contradiction /* forbidden AC constructor chain */ )
              next
                case c_m_case_2
                by step( contradiction /* forbidden AC constructor chain */ )
              next
                case coerce
                step( solve( !KD( (~skA m x.1) ) ▶₀ #vk.1 ) )
                  case genKey_case_1
                  by sorry // bound reached
                next
                  case genKey_case_2
                  by sorry // bound reached
                next
                  case mixnet_case_1
                  by sorry // bound reached
                next
                  case mixnet_case_2
                  by sorry // bound reached
                qed
              qed
            next
              case coerce
              step( solve( !KD( (~skA m x) ) ▶₀ #vk ) )
                case genKey_case_1
