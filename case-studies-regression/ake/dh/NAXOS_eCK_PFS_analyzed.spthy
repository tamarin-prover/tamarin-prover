rule (modulo E) Resp_1:
   [ Fr( ~ey ), !Ltk( $B, ~eb ), !Pk( $A, KA ), In( X ) ]
  --[
  Accept( ~ey, h2(<KA^h1(<~ey, ~eb>), X^~eb, X^h1(<~ey, ~eb>), $A, $B>) ),
  Sid( ~ey, <$B, $A, 'g'^h1(<~ey, ~eb>), X, 'Resp'> )
  ]->
   [
   Out( 'g'^h1(<~ey, ~eb>) ), !Ephk( ~ey, ~ey ),
   !Sessk( ~ey, h2(<KA^h1(<~ey, ~eb>), X^~eb, X^h1(<~ey, ~eb>), $A, $B>) )
   ]

  /*
