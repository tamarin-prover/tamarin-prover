theory SoundnessSapicStateAlias

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma alias_read:
  exists-trace "∃ #i. B( '0' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (B( '0' ) @ #i)"
*/
simplify
solve( State_1111111( StateChannel, lock, s, t, '0' ) ▶₀ #i )
  case lookuptasv_0_111111
  solve( Insert( t, '0' ) @ #t2 )
    case inserts_0_11
    solve( State_11( StateChannel, t ) ▶₀ #t2 )
      case newStateChannelchannel_0_1
      solve( !KU( ~n.2 ) @ #vk )
        case outs_0_111
        SOLVED // trace found
      qed
    qed
  qed
qed

lemma stored_value:
  all-traces "∀ v #i. (B( v ) @ #i) ⇒ (v = '0')"
/*
guarded formula characterizing all counter-examples:
"∃ v #i. (B( v ) @ #i) ∧ ¬(v = '0')"
*/
simplify
solve( State_1111111( StateChannel, lock, s, t, v ) ▶₀ #i )
  case lookuptasv_0_111111
  solve( Insert( t, v ) @ #t2 )
    case inserts_0_11
    by contradiction /* from formulas */
  next
    case inserttv_0_11111111
    solve( State_11111111( StateChannel, lock, s, t, v ) ▶₀ #t2 )
      case eventBv_0_1111111
      by contradiction /* cyclic */
    qed
  qed
qed

rule (modulo E) Init[color=#ffffff, process="new s.1;", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) news_0_[color=#ffffff, process="new s.1;", issapicrule,
                        role='Process']:
   [ State_( ), Fr( s.1 ) ] --> [ State_1( s.1 ) ]

  /*
  rule (modulo AC) news_0_[color=#ffffff, process="new s.1;", issapicrule,
                           role='Process']:
     [ State_( ), Fr( s ) ] --> [ State_1( s ) ]
  */

