theory SoundnessSapicStateEquivalentKey

begin

// Function signature and definition of the equational theory E

functions: fst/1, ident/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, ident(x) = x, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma setup_reachable:
  exists-trace "∃ #i. Setup( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Setup( ) @ #i)"
*/
simplify
solve( State_111111( StateChannel, StateChannel.1, s ) ▶₀ #i )
  case inserts_0_11111
  SOLVED // trace found
qed

lemma deletion_reaches_else:
  exists-trace
  "∃ #i #j.
    ((BeforeDelete( '0' ) @ #i) ∧ (MissingAfterDelete( ) @ #j)) ∧ (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j.
  (BeforeDelete( '0' ) @ #i) ∧ (MissingAfterDelete( ) @ #j) ∧ #i < #j"
*/
simplify
solve( State_2111111( '0', StateChannel, s, StateChannel.1 ) ▶₀ #i )
  case lookupsasbefore_0_211111
  solve( (#vr.1 < #t2)  ∥ (#vr.1 = #t2) )
    case case_2
    solve( State_21111111112( before, lock, StateChannel, s, StateChannel.1
           ) ▶₀ #j )
      case lookupsasv_1_2111111111
      solve( (∀ #t1 y. (Insert( ~n.1, y ) @ #t1) ⇒ #vr.7 < #t1)  ∥
             (∃ #t1.
               (Delete( ~n.1 ) @ #t1)
              ∧
               (#t1 < #vr.7) ∧
               (∀ #t2 y.
                 (Insert( ~n.1, y ) @ #t2) ⇒ ((¬(#t2 < #vr.7)) ∨ (#t2 < #t1)))) )
        case case_2
        solve( (#t2 < #t2.1)  ∥ (#t2 = #t2.1) )
          case case_2
          solve( Delete( ~n.1 ) @ #t1 )
            case deleteidents_0_21111111
            solve( State_21111111( before, StateChannel, ~n.1, StateChannel.1
                   ) ▶₀ #t1 )
              case eventBeforeDeletebefore_0_2111111
              solve( (#t2 < #t2.1)  ∥ (#t2 = #t2.1) )
                case case_2
                solve( Insert( ~n.1, '0' ) @ #t2 )
                  case inserts_0_21111
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma deleted_unreachable:
  all-traces "∀ v #i. (B( v ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ v #i. (B( v ) @ #i)"
*/
simplify
solve( State_1111111111( StateChannel, lock, StateChannel.1, s, v
       ) ▶₀ #i )
  case lookupsasv_0_111111111
  solve( Insert( ~n.3, v ) @ #t2 )
    case inserts_0_11111
    solve( State_11111( StateChannel, StateChannel.1, ~n.3 ) ▶₀ #t2 )
      case newStateChannelchannel_0_1111
      by contradiction /* cyclic */
    qed
  next
    case inserts_0_21111
    by contradiction /* cyclic */
  next
    case insertsv_0_11111111111
    by contradiction /* cyclic */
  next
    case insertsv_0_211111111111
    by contradiction /* cyclic */
  qed
qed

lemma control_deleted_unreachable:
  all-traces "∀ v #i. (UnexpectedRead( v ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ v #i. (UnexpectedRead( v ) @ #i)"
*/
simplify
solve( State_21111111111( before, lock, StateChannel, s, v,
                          StateChannel.1
       ) ▶₀ #i )
  case lookupsasv_0_2111111111
  solve( (#vr.5 < #t2.1)  ∥ (#vr.5 = #t2.1) )
    case case_1
    solve( Insert( ~n.2, v ) @ #t2 )
      case inserts_0_11111
      by contradiction /* cyclic */
    next
      case inserts_0_21111
      solve( State_21111( StateChannel, ~n.2, StateChannel.1 ) ▶₀ #t2 )
        case newStateChannelchannel_0_2111
        by contradiction /* cyclic */
      qed
    next
      case insertsv_0_11111111111
      by contradiction /* cyclic */
    next
      case insertsv_0_211111111111
      by contradiction /* cyclic */
    qed
  next
    case case_2
    solve( Insert( ~n.2, v ) @ #t2.1 )
      case inserts_0_11111
      by contradiction /* cyclic */
    next
      case inserts_0_21111
      solve( State_21111( StateChannel, ~n.2, StateChannel.1 ) ▶₀ #t2.1 )
        case newStateChannelchannel_0_2111
        by contradiction /* cyclic */
      qed
    next
      case insertsv_0_11111111111
      by contradiction /* cyclic */
    next
      case insertsv_0_211111111111
      by contradiction /* cyclic */
    qed
  qed
qed

rule (modulo E) Init[color=#ffffff, process="|", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) p_0_[color=#ffffff, process="|", issapicrule,
                     role='Process']:
   [ State_( ) ] --> [ State_1( ), State_2( ) ]

  /* has exactly the trivial AC variant */

