*/
simplify
solve( !KU( ~v ) @ #vk )
  case Consume___VARIANT_3
  solve( !KU( senc(<'tag', ~v>, ~k) ) @ #vk.1 )
    case Start
    SOLVED // trace found
  qed
qed

