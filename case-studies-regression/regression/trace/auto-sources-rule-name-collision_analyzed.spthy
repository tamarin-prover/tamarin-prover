theory AutoSourcesRuleNameCollision

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

rule (modulo E) Start:
   [ Fr( ~k ), Fr( ~v ) ]
  --[
  AUTO_OUT_TERM_1_0_0_1__Consume___VARIANT_3( senc(<'tag', ~v>, ~k) ),
  Sent( ~v )
  ]->
   [ !Key( ~k ), Out( senc(<'tag', ~v>, ~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Consume:
   [ !Key( k ), In( c ) ]
  --[ Got( snd(sdec(c, k)) ) ]->
   [ Out( snd(sdec(c, k)) ) ]
 variants
  rule (modulo AC) Consume___VARIANT_1:
     [ !Key( k.2 ), In( c.1 ) ]
    --[ Got( snd(sdec(c.1, k.2)) ) ]->
     [ Out( snd(sdec(c.1, k.2)) ) ]
  ,
  rule (modulo AC) Consume___VARIANT_2:
     [ !Key( k.1 ), In( senc(x.2, k.1) ) ]
    --[ Got( snd(x.2) ) ]->
     [ Out( snd(x.2) ) ]
  ,
  rule (modulo AC) Consume___VARIANT_3:
     [ !Key( k.1 ), In( senc(<x.3, z.2>, k.1) ) ]
    --[
    AUTO_IN_TERM_1_0_0_1__Consume___VARIANT_3( senc(<x.3, z.2>, k.1), z.2 ),
    Got( z.2 )
    ]->
     [ Out( z.2 ) ]

rule (modulo E) Consume___VARIANT_3:
   [ ] --[ Other( ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Consume___VARIANT_3___AUTO_1:
   [ ] --[ Reserved( ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma delivery:
  exists-trace "∃ v #i #j. (Sent( v ) @ #i) ∧ (Got( v ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ v #i #j. (Sent( v ) @ #i) ∧ (Got( v ) @ #j)"
*/
simplify
solve( Got( ~v ) @ #j )
  case Consume___VARIANT_3
  solve( !Key( k.1 ) ▶₀ #j )
    case Start
    solve( !KU( senc(<x, ~v>, ~k.1) ) @ #vk )
      case Start
      SOLVED // trace found
    qed
  qed
qed

lemma disclosure:
  exists-trace "∃ v #i #j. (Sent( v ) @ #i) ∧ (K( v ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
