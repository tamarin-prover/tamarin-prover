theory SoundnessDiffMirrorRestriction

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Emit:
   [ ] --[ A( diff('a', 'b') ) ]-> [ Out( 'hello' ) ]

restriction BanRight [right]:
  "∀ #i. (A( 'b' ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ #i. (A( 'b' ) @ #i) ⇒ (⊥)"
  */

restriction BanRight [left]:
  "∀ #i. (A( 'b' ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ #i. (A( 'b' ) @ #i) ⇒ (⊥)"
  */

lemma left_witness [left]:
  exists-trace "∃ #i. A( 'a' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (A( 'a' ) @ #i)"
*/
simplify
SOLVED // trace found

lemma right_blocked [right]:
  exists-trace "∃ #i. A( 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (A( 'b' ) @ #i)"
*/
simplify
by contradiction /* from formulas */

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Emit
  backward-search
    case LHS
    step( simplify )
    by ATTACK // trace found
  qed
qed

