theory DiffSingletonTrivialVariants

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Both:
   [ ] --[ Emit( 'both' ) ]-> [ Out( 'both' ) ]

rule (modulo E) LeftOnly:
   [ ] --[ Emit( 'left' ) ]-> [ Out( 'left' ) ]

rule (modulo E) RightOnly:
   [ ] --[ Emit( 'right' ) ]-> [ Out( 'right' ) ]

rule (modulo E) Automatic:
   [ ] --[ Emit( 'automatic' ) ]-> [ Out( 'automatic' ) ]

lemma both_reachable [right]:
  exists-trace "∃ #i. Emit( 'both' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Emit( 'both' ) @ #i)"
*/
simplify
solve( Emit( 'both' ) @ #i )
  case Both
  SOLVED // trace found
qed

