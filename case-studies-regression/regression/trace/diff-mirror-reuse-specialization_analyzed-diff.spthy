theory DiffMirrorReuseSpecialization

begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Produce:
   [ ] --> [ F( ('a'++'b') ) ]

rule (modulo E) Consume:
   [ F( (x++y) ) ] --[ Choice( x, y, $p, $q ) ]-> [ Out( <$p, $q> ) ]

lemma Original [left, diff_reuse]:
  all-traces "∀ x y #i. (Choice( x, y, 'a', 'b' ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i. (Choice( x, y, 'a', 'b' ) @ #i)"
*/
simplify
solve( F( (x++y) ) ▶₀ #i )
  case Produce_case_1
  SOLVED // trace found
qed

restriction Choices [right]:
  "∀ x y p q #i.
    (Choice( x, y, p, q ) @ #i) ⇒
    (((x = 'a') ∨ (¬(q = 'b'))) ∧ ((x = 'b') ∨ (¬(p = 'a'))))"
  // safety formula

  /*
  expanded formula:
  "∀ x y p q #i.
    (Choice( x, y, p, q ) @ #i) ⇒
    (((x = 'a') ∨ (¬(q = 'b'))) ∧ ((x = 'b') ∨ (¬(p = 'a'))))"
  */

diffLemma D:
rule-equivalence
  case Rule_Consume
  backward-search
    case LHS
    step( simplify )
    step( solve( F( (x++y) ) ▶₀ #i ) )
      case Produce_case_1
      MIRRORED
    next
      case Produce_case_2
      MIRRORED
    qed
  next
    case RHS
    step( simplify )
    step( solve( (x = 'a')  ∥ (¬($q = 'b')) ) )
      case case_1
      step( solve( F( ('a'++y) ) ▶₀ #i ) )
        case Produce
        MIRRORED
      qed
    next
      case case_2
      step( solve( (x = 'b')  ∥ (¬($p = 'a')) ) )
        case case_1
        step( solve( F( ('b'++y) ) ▶₀ #i ) )
          case Produce
          MIRRORED
        qed
      next
        case case_2
        step( solve( F( (x++y) ) ▶₀ #i ) )
          case Produce_case_1
          MIRRORED
        next
          case Produce_case_2
          MIRRORED
        qed
      qed
    qed
  qed
next
  case Rule_Destrd_0_fst
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Destrd_0_snd
