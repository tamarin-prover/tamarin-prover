theory DiffEmbeddedRestrictionProjections

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

macros: identity( x ) =  x,
        choice( ) =  diff('a', 'b')

restriction Restr_Choose_1 [left]:
  "∀ x #NOW. (Restr_Choose_1( x ) @ #NOW) ⇒ (x = 'a')"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_Choose_1( x ) @ #NOW) ⇒ (x = 'a')"
  */

restriction Restr_Choose_2 [left]:
  "∀ x #NOW. (Restr_Choose_2( x ) @ #NOW) ⇒ (x = 'tag')"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_Choose_2( x ) @ #NOW) ⇒ (x = 'tag')"
  */

restriction Restr_Choose_1 [right]:
  "∀ x #NOW. (Restr_Choose_1( x ) @ #NOW) ⇒ (x = 'b')"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_Choose_1( x ) @ #NOW) ⇒ (x = 'b')"
  */

restriction Restr_Choose_2 [right]:
  "∀ x #NOW. (Restr_Choose_2( x ) @ #NOW) ⇒ (x = 'tag')"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_Choose_2( x ) @ #NOW) ⇒ (x = 'tag')"
  */

rule (modulo E) Choose:
   [ In( <x, y> ) ]
  --[ Chosen( x, y ), Restr_Choose_1( x ), Restr_Choose_2( y ) ]->
   [ ]
 left
  rule (modulo E) Choose:
     [ In( <x, y> ) ]
    --[ Chosen( x, y ), Restr_Choose_1( x ), Restr_Choose_2( y ) ]->
     [ ]
 right
  rule (modulo E) Choose:
     [ In( <x, y> ) ]
    --[ Chosen( x, y ), Restr_Choose_1( x ), Restr_Choose_2( y ) ]->
     [ ]

restriction Restr_Local_1 [left]:
  "∀ x #NOW x.1.
    (Restr_Local_1( x, x.1 ) @ #NOW) ⇒ ((x = 'a') ∨ (x.1 = 'b'))"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW x.1.
    (Restr_Local_1( x, x.1 ) @ #NOW) ⇒ ((x = 'a') ∨ (x.1 = 'b'))"
  */

restriction Restr_Local_1 [right]:
  "∀ x #NOW x.1.
    (Restr_Local_1( x, x.1 ) @ #NOW) ⇒ ((x = 'a') ∨ (x.1 = 'b'))"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW x.1.
    (Restr_Local_1( x, x.1 ) @ #NOW) ⇒ ((x = 'a') ∨ (x.1 = 'b'))"
  */

restriction Restr_Local_LHS_1 [left]:
  "∀ x #NOW. (Restr_Local_LHS_1( x ) @ #NOW) ⇒ (x = 'a')"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_Local_LHS_1( x ) @ #NOW) ⇒ (x = 'a')"
  */

restriction Restr_Local_RHS_1 [right]:
  "∀ x #NOW. (Restr_Local_RHS_1( x ) @ #NOW) ⇒ (x = 'b')"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_Local_RHS_1( x ) @ #NOW) ⇒ (x = 'b')"
  */

rule (modulo E) Local:
   [ In( x ) ] --[ Local( x ), Restr_Local_1( x, x ) ]-> [ ]
 left
  rule (modulo E) Local:
     [ In( x ) ]
    --[ Local( x ), Restr_Local_LHS_1( x ), Restr_Local_1( x, x ) ]->
     [ ]
 right
  rule (modulo E) Local:
     [ In( x ) ]
    --[ Local( x ), Restr_Local_RHS_1( x ), Restr_Local_1( x, x ) ]->
     [ ]

restriction Restr_Mixed_1 [left]:
  "∀ x #NOW x.1. (Restr_Mixed_1( x, x.1 ) @ #NOW) ⇒ (x = x.1)"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW x.1. (Restr_Mixed_1( x, x.1 ) @ #NOW) ⇒ (x = x.1)"
  */

restriction Restr_Mixed_1 [right]:
  "∀ x #NOW x.1. (Restr_Mixed_1( x, x.1 ) @ #NOW) ⇒ (x = x.1)"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW x.1. (Restr_Mixed_1( x, x.1 ) @ #NOW) ⇒ (x = x.1)"
  */

rule (modulo E) Mixed:
   [ In( x ) ] --[ Mixed( x ), Restr_Mixed_1( diff(x, 'a'), x ) ]-> [ ]

lemma left_choice [left]:
  all-traces "∀ x y #i. (Chosen( x, y ) @ #i) ⇒ ((x = 'a') ∧ (y = 'tag'))"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i. (Chosen( x, y ) @ #i) ∧ ((¬(x = 'a')) ∨ (¬(y = 'tag')))"
*/
simplify
by contradiction /* from formulas */

lemma right_choice [right]:
  all-traces "∀ x y #i. (Chosen( x, y ) @ #i) ⇒ ((x = 'b') ∧ (y = 'tag'))"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i. (Chosen( x, y ) @ #i) ∧ ((¬(x = 'b')) ∨ (¬(y = 'tag')))"
*/
simplify
by contradiction /* from formulas */

lemma left_reachable [left]:
  exists-trace "∃ #i. Chosen( 'a', 'tag' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Chosen( 'a', 'tag' ) @ #i)"
*/
simplify
SOLVED // trace found

lemma right_reachable [right]:
  exists-trace "∃ #i. Chosen( 'b', 'tag' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Chosen( 'b', 'tag' ) @ #i)"
*/
simplify
SOLVED // trace found

lemma left_local [left]:
  all-traces "∀ x #i. (Local( x ) @ #i) ⇒ (x = 'a')"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Local( x ) @ #i) ∧ ¬(x = 'a')"
*/
simplify
by contradiction /* from formulas */

lemma right_local [right]:
  all-traces "∀ x #i. (Local( x ) @ #i) ⇒ (x = 'b')"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Local( x ) @ #i) ∧ ¬(x = 'b')"
