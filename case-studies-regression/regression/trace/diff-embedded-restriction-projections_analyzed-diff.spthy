*/
simplify
SOLVED // trace found

lemma right_mixed [right]:
  all-traces "∀ x #i. (Mixed( x ) @ #i) ⇒ (x = 'a')"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Mixed( x ) @ #i) ∧ ¬(x = 'a')"
*/
simplify
by contradiction /* from formulas */

lemma right_mixed_reachable [right]:
  exists-trace "∃ #i. Mixed( 'a' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Mixed( 'a' ) @ #i)"
*/
simplify
SOLVED // trace found

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Mixed
  backward-search
    case LHS
    step( simplify )
    by ATTACK // trace found
  qed
qed

