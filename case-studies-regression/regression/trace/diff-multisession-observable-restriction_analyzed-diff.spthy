theory DiffMultisessionObservableRestriction

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

rule (modulo E) Init:
   [ Fr( ~k ), Fr( ~s ) ]
  --[ Secret( ~s ) ]->
   [ First( ~k ), Second( ~k, ~s ), Out( h(~s) ) ]

rule (modulo E) EmitKey:
   [ First( k ) ] --[ EmitFor( k ), KeySent( k ) ]-> [ Out( k ) ]

rule (modulo E) EmitCiphertext:
   [ Second( k, s ) ]
  --[ EmitFor( k ), CiphertextSent( s, k ) ]->
   [ Out( senc(s, k) ) ]

restriction OneEmission [right]:
  "∀ k #i #j. ((EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ k #i #j. ((EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j)) ⇒ (#i = #j)"
  */

lemma left_leaks [left]:
  exists-trace "∃ s #i #j. (Secret( s ) @ #i) ∧ (K( s ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ s #i #j. (Secret( s ) @ #i) ∧ (K( s ) @ #j)"
*/
simplify
solve( !KU( ~s ) @ #vk )
  case EmitCiphertext
  solve( !KU( ~k ) @ #vk.1 )
    case EmitKey
    SOLVED // trace found
  qed
qed

lemma right_secret [right]:
  all-traces "∀ s #i #j. ((Secret( s ) @ #i) ∧ (K( s ) @ #j)) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ s #i #j. (Secret( s ) @ #i) ∧ (K( s ) @ #j)"
*/
simplify
solve( !KU( ~s ) @ #vk )
  case EmitCiphertext
  by solve( !KU( ~k ) @ #vk.1 )
qed

lemma right_key_reachable [right]:
  exists-trace "∃ k #i. KeySent( k ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ k #i. (KeySent( k ) @ #i)"
*/
simplify
solve( First( k ) ▶₀ #i )
  case Init
  SOLVED // trace found
qed

lemma right_ciphertext_reachable [right]:
  exists-trace "∃ s k #i. CiphertextSent( s, k ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ s k #i. (CiphertextSent( s, k ) @ #i)"
*/
simplify
solve( Second( k, s ) ▶₀ #i )
  case Init
  SOLVED // trace found
qed

