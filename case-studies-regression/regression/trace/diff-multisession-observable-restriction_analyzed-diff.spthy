    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case EmitCiphertext
      step( solve( (#vl, 0) ~~> (#i, 0) ) )
        case d_0_sdec
        step( solve( Second( k, s ) ▶₀ #vr ) )
          case Init
          by sorry // bound 6 hit
        qed
      qed
    next
      case EmitKey
      step( solve( First( t ) ▶₀ #vr ) )
