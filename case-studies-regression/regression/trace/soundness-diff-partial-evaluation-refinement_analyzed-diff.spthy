// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) SeedA:
   [ ] --> [ State( 'a' ) ]

rule (modulo E) SeedB:
   [ ] --> [ State( 'b' ) ]

rule (modulo E) Use:
   [ State( x ) ] --[ Used( x ) ]-> [ Out( x ) ]
 left
  rule (modulo E) Use:
     [ State( x ) ] --[ Used( x ) ]-> [ Out( x ) ]
   variants
    rule (modulo AC) Use:
       [ State( x ) ] --[ Used( x ), Annotated( x ) ]-> [ Out( x ) ]
 right
  rule (modulo E) Use:
     [ State( x ) ] --[ Used( x ) ]-> [ Out( x ) ]
   variants
    rule (modulo AC) Use:
       [ State( x ) ] --[ Used( x ), Annotated( x ) ]-> [ Out( x ) ]

lemma both [right]:
  exists-trace "∃ #i #j. (Used( 'a' ) @ #i) ∧ (Used( 'b' ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j. (Used( 'a' ) @ #i) ∧ (Used( 'b' ) @ #j)"
*/
simplify
solve( State( 'a' ) ▶₀ #i )
  case SeedA
  solve( State( 'b' ) ▶₀ #j )
    case SeedB
    SOLVED // trace found
  qed
qed

lemma both [left]:
