theory SoundnessDiffMultisessionRestriction

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Init:
   [ Fr( ~k ) ] --> [ First( ~k ), Second( ~k ) ]

rule (modulo E) EmitFirst:
   [ First( k ) ] --[ EmitFor( k ) ]-> [ Out( 'ok' ) ]

rule (modulo E) EmitSecond:
   [ Second( k ) ] --[ EmitFor( k ) ]-> [ Out( 'ok' ) ]

restriction OneEmission [right]:
  "∀ k #i #j. ((EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ k #i #j. ((EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j)) ⇒ (#i = #j)"
  */

lemma left_two [left]:
  exists-trace
  "∃ k #i #j. ((EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j)) ∧ (¬(#i = #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ k #i #j. (EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( EmitFor( k ) @ #i )
    case EmitFirst
    solve( First( k ) ▶₀ #i )
      case Init
      solve( EmitFor( ~k ) @ #j )
        case EmitSecond
        solve( Second( ~k ) ▶₀ #j )
          case Init
          SOLVED // trace found
        qed
      qed
    qed
  qed
qed

lemma right_at_most_one [right]:
  all-traces
  "∀ k #i #j. ((EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ k #i #j. (EmitFor( k ) @ #i) ∧ (EmitFor( k ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
by contradiction /* from formulas */

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Destrd_0_fst
  backward-search
