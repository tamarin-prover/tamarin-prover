theory ManualVariantActionAlignment

begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Late:
   [ In( x ), In( z ) ]
  --[
  A( x ), A( x ), A( x ), A( x ), A( x ), A( x ), A( x ), A( x ), A( x ),
  A( x ), A( x ), A( x ), A( x ), A( x ), A( x ), A( x )
  ]->
   [ Out( z ) ]
 variants
  rule (modulo AC) Late___VARIANT_1:
     [ In( y ), In( w ) ]
    --[
    A( 'a' ), A( 'a' ), A( 'a' ), A( 'a' ), A( 'a' ), A( 'a' ), A( 'a' ),
    A( 'a' ), A( 'a' ), A( 'a' ), A( 'a' ), A( 'a' ), A( 'a' ), A( 'a' ),
    A( 'a' ), A( 'a' ), A( w ), A( w ), A( w ), A( w ), A( w ), A( w ),
    A( w ), A( w ), A( w ), A( w ), A( w ), A( w ), A( w ), A( w ), A( w ),
    A( w ), A( y ), A( y ), A( y ), A( y ), A( y ), A( y ), A( y ), A( y ),
    A( y ), A( y ), A( y ), A( y ), A( y ), A( y ), A( y ), A( y )
    ]->
     [ Out( w ) ]

rule (modulo E) Backtrack:
   [ ] --[ Candidate( $x ), Following( $x ) ]-> [ ]
 variants
  rule (modulo AC) Backtrack___VARIANT_1:
     [ ] --[ Candidate( $a ), Candidate( $b ), Following( $b ) ]-> [ ]

rule (modulo E) Ambiguous:
   [ ] --[ Pair( ($x++$y) ), Pick( $x ) ]-> [ ]
 variants
  rule (modulo AC) Ambiguous___VARIANT_1:
     [ ] --[ Pair( ($a++$b) ), Pick( $b ) ]-> [ ]

rule (modulo E) Seed:
   [ In( z ) ] --> [ State( z ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ACPremise:
   [ State( (x0++x1++x2++x3) ) ]
  --[ Pin0( x0 ), Pin1( x1 ), Pin2( x2 ), Pin3( x3 ) ]->
   [ ]
 variants
  rule (modulo AC) ACPremise___VARIANT_1:
     [ State( (y0++y1++y2++y3) ) ]
    --[ Extra( ), Pin0( y0 ), Pin1( y1 ), Pin2( y2 ), Pin3( y3 ) ]->
     [ ]

rule (modulo E) ACAction:
   [ ]
  --[
  Bag( ($x0++$x1++$x2++$x3++$x4++$x5++$x6++$x7) ), Pin0( $x0 ),
  Pin1( $x1 ), Pin2( $x2 ), Pin3( $x3 ), Pin4( $x4 ), Pin5( $x5 ),
  Pin6( $x6 ), Pin7( $x7 )
  ]->
   [ ]
 variants
  rule (modulo AC) ACAction___VARIANT_1:
     [ ]
    --[
    Extra( ), Bag( ($y0++$y1++$y2++$y3++$y4++$y5++$y6++$y7) ), Pin0( $y0 ),
    Pin1( $y1 ), Pin2( $y2 ), Pin3( $y3 ), Pin4( $y4 ), Pin5( $y5 ),
    Pin6( $y6 ), Pin7( $y7 )
    ]->
     [ ]

lemma late:
  exists-trace "∃ #i. A( 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (A( 'b' ) @ #i)"
*/
simplify
solve( A( 'b' ) @ #i )
  case Late___VARIANT_1_case_1
  SOLVED // trace found
qed

lemma backtrack:
  exists-trace
  "∃ #i.
    ((Candidate( 'a' ) @ #i) ∧ (Candidate( 'b' ) @ #i)) ∧
    (Following( 'b' ) @ #i)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i.
  (Candidate( 'a' ) @ #i) ∧
  (Candidate( 'b' ) @ #i) ∧
  (Following( 'b' ) @ #i)"
*/
simplify
solve( Candidate( 'a' ) @ #i )
  case Backtrack___VARIANT_1
  solve( Candidate( 'b' ) @ #i )
    case Backtrack___VARIANT_1
    SOLVED // trace found
  qed
qed

lemma ac_choice:
  exists-trace "∃ #i. (Pair( ('a'++'b') ) @ #i) ∧ (Pick( 'b' ) @ #i)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Pair( ('a'++'b') ) @ #i) ∧ (Pick( 'b' ) @ #i)"
*/
simplify
solve( Pair( ('a'++'b') ) @ #i )
  case Ambiguous___VARIANT_1
  SOLVED // trace found
qed

lemma false_safety:
  all-traces "∀ x #i. (A( x ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (A( x ) @ #i)"
*/
simplify
solve( A( x ) @ #i )
  case Late___VARIANT_1_case_1
  SOLVED // trace found
qed

/* All wellformedness checks were successful. */

/*
