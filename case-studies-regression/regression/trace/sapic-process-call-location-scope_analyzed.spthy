lemma direct_location:
  exists-trace
  "∃ #i. Local( 'direct', 'caller', 'local', rep('local', 'local') ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i.
  (Local( 'direct', 'caller', 'local', rep('local', 'local') ) @ #i)"
*/
simplify
solve( Local( 'direct', 'caller', 'local', rep('local', 'local') ) @ #i )
  case eventLocaldirectyyrepyy_0_11111
  solve( State_11111( 'caller', 'local' ) ▶₀ #i )
    case iny_0_1111
    SOLVED // trace found
  qed
qed

