guarded formula characterizing all satisfying traces:
"∃ #i. (Caller( 'caller', 'local', rep('local', 'caller') ) @ #i)"
*/
simplify
solve( State_12111( 'caller', 'local' ) ▶₀ #i )
  case iny_0_1211
  SOLVED // trace found
qed

lemma direct_location_preserved:
  all-traces
  "∀ x y r #i. (Local( 'direct', x, y, r ) @ #i) ⇒ (r = rep(y, y))"
/*
guarded formula characterizing all counter-examples:
"∃ x y r #i. (Local( 'direct', x, y, r ) @ #i) ∧ ¬(r = rep(y, y))"
*/
simplify
solve( Local( 'direct', x, y, r ) @ #i )
  case eventLocaldirectyyrepyy_0_11111
  by contradiction /* from formulas */
qed

