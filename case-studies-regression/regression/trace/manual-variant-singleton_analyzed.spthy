theory ManualVariantSingleton

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

macros: identity( x ) =  x

rule (modulo E) Plain___VARIANT_1:
   [ In( x ) ] --[ Plain( x ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Annotated___VARIANT_1:
   [ In( y ) ] --[ Original( y ), Added( y ) ]-> [ Out( y ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Macro___VARIANT_1:
   [ In( y ) ] --[ Macro( y ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma plain:
  exists-trace "∃ #i. Plain( 'a' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Plain( 'a' ) @ #i)"
*/
simplify
SOLVED // trace found

lemma annotated:
  exists-trace "∃ #i. (Original( 'a' ) @ #i) ∧ (Added( 'a' ) @ #i)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Original( 'a' ) @ #i) ∧ (Added( 'a' ) @ #i)"
*/
simplify
SOLVED // trace found

lemma macro:
  exists-trace "∃ #i. Macro( 'a' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Macro( 'a' ) @ #i)"
*/
simplify
SOLVED // trace found

lemma false_safety:
  all-traces "∀ x #i. (Added( x ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Added( x ) @ #i)"
*/
simplify
SOLVED // trace found

/* All wellformedness checks were successful. */

