theory SapicInferredLocationTypes

begin

// Function signature and definition of the equational theory E

functions: check_rep/2 [destructor], f/1, fst/1, get_rep/1 [destructor],
           pair/2, rep/2 [private,constructor], report/1, snd/1
equations:
    check_rep(rep(x.1, x.2), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    get_rep(rep(x.1, x.2)) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

predicate: Report( x, l )<=>⊤

lemma reaches_done:
  exists-trace "∃ #i. Done( 'value' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Done( 'value' ) @ #i)"
*/
simplify
solve( State_1111( s, 'value' ) ▶₀ #i )
  case lookuprepmessagesbitstringasx_0_111
  solve( (#vr.1 < #t2)  ∥ (#vr.1 = #t2) )
    case case_2
    SOLVED // trace found
  qed
qed

lemma correct_value:
  all-traces "∀ x #i. (Done( x ) @ #i) ⇒ (x = 'value')"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Done( x ) @ #i) ∧ ¬(x = 'value')"
*/
simplify
solve( State_1111( s, x ) ▶₀ #i )
  case lookuprepmessagesbitstringasx_0_111
  by contradiction /* from formulas */
qed

