theory SoundnessSapicDestructorNonvariableResult

begin

// Function signature and definition of the equational theory E

functions: box/1, boxed/1, check/1 [destructor], fst/1 [destructor],
           okay/0, open/1 [destructor], pair/2, snd/1 [destructor], valid/1
equations:
    check(boxed(x)) = x,
    check(valid(x)) = okay,
    fst(<x.1, x.2>) = x.1,
    open(box(<x, y>)) = <x, y>,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma valid_succeeds:
  exists-trace "∃ #i. Success( okay ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Success( okay ) @ #i)"
*/
simplify
solve( State_1111111( s, okay ) ▶₀ #i )
  case letycheckvalids_4_111111
  SOLVED // trace found
qed

lemma unboxed:
  exists-trace "∃ y #i. Unboxed( y ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ y #i. (Unboxed( y ) @ #i)"
*/
simplify
solve( State_1111121( s, y ) ▶₀ #i )
  case letycheckboxeds_4_111112
  SOLVED // trace found
qed

lemma rejected:
  exists-trace "∃ #i. Rejected( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Rejected( ) @ #i)"
*/
simplify
solve( State_111122( s ) ▶₀ #i )
  case letychecks_3_11112
  SOLVED // trace found
qed

lemma opened:
  exists-trace "∃ b #i. Opened( b ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ b #i. (Opened( b ) @ #i)"
*/
simplify
solve( State_11121( b, s ) ▶₀ #i )
  case letkbopenboxks_3_1112
  SOLVED // trace found
qed

lemma pattern_failed:
  exists-trace "∃ #i. PatternFailed( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (PatternFailed( ) @ #i)"
*/
simplify
solve( State_1122( s ) ▶₀ #i )
  case letzbopenboxks_4_112
  SOLVED // trace found
qed

lemma nested:
  exists-trace "∃ #i. Nested( okay ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Nested( okay ) @ #i)"
*/
simplify
solve( State_121( s, okay ) ▶₀ #i )
  case letychecksndopenboxkvalids_12_12
  SOLVED // trace found
qed

lemma no_failure:
  all-traces "∀ #i. (Failure( ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Failure( ) @ #i)"
*/
simplify
solve( Failure( ) @ #i )
  case eventFailure_0_1111112
  by solve( State_1111112( s ) ▶₀ #i )
next
  case eventFailure_0_1111122
  by solve( State_1111122( s ) ▶₀ #i )
next
  case eventFailure_0_11122
  by solve( State_11122( s ) ▶₀ #i )
next
  case eventFailure_0_122
  by solve( State_122( s ) ▶₀ #i )
qed

lemma no_wrong:
  all-traces "∀ y #i. (Wrong( y ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ y #i. (Wrong( y ) @ #i)"
*/
simplify
solve( Wrong( y ) @ #i )
  case eventWrongb_0_1121
  by solve( State_1121( s, y ) ▶₀ #i )
next
  case eventWrongy_0_111121
  by solve( State_111121( s, y ) ▶₀ #i )
qed

lemma success_okay:
  all-traces "∀ y #i. (Success( y ) @ #i) ⇒ (y = okay)"
/*
guarded formula characterizing all counter-examples:
"∃ y #i. (Success( y ) @ #i) ∧ ¬(y = okay)"
*/
simplify
solve( State_1111111( s, y ) ▶₀ #i )
  case letycheckvalids_4_111111
  by contradiction /* from formulas */
qed

