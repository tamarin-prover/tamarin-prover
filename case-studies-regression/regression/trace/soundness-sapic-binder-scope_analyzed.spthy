lemma else_outer:
  all-traces
  "∀ v #i.
    (Missing( v ) @ #i) ⇒ (∃ #j. (Input( 'else', v ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ v #i.
  (Missing( v ) @ #i) ∧ ∀ #j. (Input( 'else', v ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( State_11112( v ) ▶₀ #i )
  case lookupunsetasx_1_1111
  by contradiction /* from formulas */
qed

lemma let_outer:
  all-traces
  "∀ a b #i.
    (Parts( a, b ) @ #i) ⇒ (∃ #j. (Input( 'let', <a, b> ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ a b #i.
  (Parts( a, b ) @ #i) ∧ ∀ #j. (Input( 'let', <a, b> ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( State_12111( b, x, a ) ▶₀ #i )
  case letxyx_1_1211
  by contradiction /* from formulas */
qed

lemma key_outer:
  exists-trace "∃ #i. Read( 'value' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Read( 'value' ) @ #i)"
*/
simplify
solve( State_2111( x, 'value' ) ▶₀ #i )
  case lookupxasx_0_211
  solve( (#vr.2 < #t2)  ∥ (#vr.2 = #t2) )
    case case_2
    SOLVED // trace found
  qed
qed

