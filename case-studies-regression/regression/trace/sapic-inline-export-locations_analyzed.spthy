predicate: Report( x, l )<=>⊤

lemma pattern_location:
  exists-trace "∃ #i. Pattern( rep('a', 'outer') ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Pattern( rep('a', 'outer') ) @ #i)"
*/
simplify
solve( State_1111( ) ▶₀ #i )
  case ina_0_111
  SOLVED // trace found
qed

lemma caller_location:
  exists-trace "∃ x #i. Caller( rep(x, x) ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (Caller( rep(x, x) ) @ #i)"
*/
simplify
solve( State_1211( x ) ▶₀ #i )
  case Open_0_121
  SOLVED // trace found
qed

lemma inner_location:
  exists-trace "∃ x #i. Inner( rep(x, 'inner') ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (Inner( rep(x, 'inner') ) @ #i)"
*/
simplify
solve( State_211( x ) ▶₀ #i )
  case Inner_0_21
  SOLVED // trace found
qed

lemma inner_overrides_caller:
  all-traces "∀ x l #i. (Inner( rep(x, l) ) @ #i) ⇒ (l = 'inner')"
/*
guarded formula characterizing all counter-examples:
"∃ x l #i. (Inner( rep(x, l) ) @ #i) ∧ ¬(l = 'inner')"
*/
simplify
by contradiction /* from formulas */

