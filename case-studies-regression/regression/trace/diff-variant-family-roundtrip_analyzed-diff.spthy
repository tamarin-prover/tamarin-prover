SOLVED // trace found

lemma variant_action_reachable [left]:
  exists-trace "∃ #i. DiffProtoReduced___VARIANT_1( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (DiffProtoReduced___VARIANT_1( ) @ #i)"
*/
simplify
SOLVED // trace found

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Destrd_0_fst
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Reduced
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Reduced
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Destrd_0_sdec
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( senc(x, x.1) ) ▶₀ #i ) )
      case Reduced
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( senc(x, x.1) ) ▶₀ #i ) )
      case Reduced
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Destrd_0_snd
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Reduced
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Reduced
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Equality
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Reduced
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Const_pub_a
        step( solve( !KU( 'a' ) @ #vk ) )
          case coerce
          step( solve( !KD( 'a' ) ▶₀ #vk ) )
            case Reduced
            by step( contradiction /* impossible chain */ )
          qed
        next
          case pub
          MIRRORED
        qed
      qed
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Reduced
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Const_pub_a
        step( solve( !KU( 'a' ) @ #vk ) )
          case coerce
          step( solve( !KD( 'a' ) ▶₀ #vk ) )
            case Reduced
            by step( contradiction /* impossible chain */ )
          qed
        next
          case pub
          MIRRORED
        qed
      qed
    qed
  qed
next
  case Rule_Init
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
next
  case Rule_Loop
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
next
  case Rule_Reduced
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
next
  case Rule_Send
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
qed

