theory DiffVariantFamilyRoundtrip

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

rule (modulo E) Init:
   [ ] --> [ State( 's' ) ]

rule (modulo E) Impossible:
   [ Fr( ~n ), In( ~n ) ] --[ Impossible( ~n ) ]-> [ ]

rule (modulo E) Loop:
   [ State( x ) ] --[ Tick( x ) ]-> [ State( x ) ]

rule (modulo E) Reduced:
   [ ] --[ Reduced( ) ]-> [ Out( sdec(senc('a', 'k'), 'k') ) ]
 left
  rule (modulo E) Reduced:
     [ ] --[ Reduced( ) ]-> [ Out( sdec(senc('a', 'k'), 'k') ) ]
   variants
    rule (modulo AC) Reduced___VARIANT_1:
       [ ] --[ Reduced( ), DiffProtoReduced___VARIANT_1( ) ]-> [ Out( 'a' ) ]
 right
  rule (modulo E) Reduced:
     [ ] --[ Reduced( ) ]-> [ Out( sdec(senc('a', 'k'), 'k') ) ]
   variants
    rule (modulo AC) Reduced___VARIANT_1:
       [ ] --[ Reduced( ), DiffProtoReduced___VARIANT_1( ) ]-> [ Out( 'a' ) ]

lemma loop_reachable [right]:
  exists-trace "∃ #i. Tick( 's' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Tick( 's' ) @ #i)"
*/
simplify
solve( State( 's' ) ▶₀ #i )
  case Init
  SOLVED // trace found
qed

lemma loop_reachable [left]:
  exists-trace "∃ #i. Tick( 's' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Tick( 's' ) @ #i)"
*/
simplify
solve( State( 's' ) ▶₀ #i )
  case Init
  SOLVED // trace found
qed

lemma impossible_unreachable [right]:
  all-traces "∀ n #i. (Impossible( n ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ n #i. (Impossible( n ) @ #i)"
*/
simplify
by solve( Impossible( n ) @ #i )

