theory DiffAlternativeConditionalRestrictions

begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Produce:
   [ ] --> [ F( ('a'++'b') ) ]

rule (modulo E) Consume:
   [ F( (x++y) ) ] --[ Choice( x, y, $p ) ]-> [ Out( $p ) ]

restriction AvoidChosen [right]:
  "∀ x y p #i. (Choice( x, y, p ) @ #i) ⇒ (¬(x = p))"
  // safety formula

  /*
  expanded formula:
  "∀ x y p #i. (Choice( x, y, p ) @ #i) ⇒ (¬(x = p))"
  */

lemma left_possible [left]:
  exists-trace "∃ x y p #i. Choice( x, y, p ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x y p #i. (Choice( x, y, p ) @ #i)"
*/
simplify
solve( F( (x++y) ) ▶₀ #i )
  case Produce_case_1
  SOLVED // trace found
qed

lemma right_possible [right]:
  exists-trace "∃ x y p #i. Choice( x, y, p ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x y p #i. (Choice( x, y, p ) @ #i)"
*/
simplify
solve( F( (x++y) ) ▶₀ #i )
  case Produce_case_1
  SOLVED // trace found
qed

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Consume
  backward-search
    case LHS
    step( simplify )
    step( solve( F( (x++y) ) ▶₀ #i ) )
      case Produce_case_1
      MIRRORED
    next
      case Produce_case_2
      MIRRORED
    qed
  next
    case RHS
    step( simplify )
    step( solve( F( (x++y) ) ▶₀ #i ) )
      case Produce_case_1
      MIRRORED
    next
      case Produce_case_2
      MIRRORED
    qed
  qed
next
  case Rule_Destrd_0_fst
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Destrd_0_snd
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Destrd_union
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( (x++y) ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( (x++y) ) ▶₀ #i ) )
      case Consume
      by step( contradiction /* impossible chain */ )
    qed
  qed
next
  case Rule_Equality
  backward-search
    case LHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Consume
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Var_pub_p
        step( solve( F( (x++y) ) ▶₀ #vr ) )
          case Produce_case_1
          step( solve( !KU( $p ) @ #vk ) )
            case coerce
            step( solve( !KD( $p ) ▶₀ #vk ) )
              case Consume
              by step( contradiction /* impossible chain */ )
            qed
          next
            case pub
            MIRRORED
          qed
        next
          case Produce_case_2
          step( solve( !KU( $p ) @ #vk ) )
            case coerce
            step( solve( !KD( $p ) ▶₀ #vk ) )
              case Consume
              by step( contradiction /* impossible chain */ )
            qed
          next
            case pub
            MIRRORED
          qed
        qed
      qed
    qed
  next
    case RHS
    step( simplify )
    step( solve( !KD( x ) ▶₁ #i ) )
      case Consume
      step( solve( (#vl, 0) ~~> (#i, 1) ) )
        case Var_pub_p
        step( solve( F( (x++y) ) ▶₀ #vr ) )
          case Produce_case_1
          step( solve( !KU( $p ) @ #vk ) )
            case coerce
            step( solve( !KD( $p ) ▶₀ #vk ) )
              case Consume
              by step( contradiction /* impossible chain */ )
            qed
          next
            case pub
            MIRRORED
          qed
        next
          case Produce_case_2
          step( solve( !KU( $p ) @ #vk ) )
            case coerce
            step( solve( !KD( $p ) ▶₀ #vk ) )
              case Consume
              by step( contradiction /* impossible chain */ )
            qed
          next
            case pub
            MIRRORED
          qed
        qed
      qed
    qed
  qed
next
  case Rule_Produce
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
next
  case Rule_Send
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
qed

