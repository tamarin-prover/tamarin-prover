theory SoundnessSapicDestructorFailureChain

begin

// Function signature and definition of the equational theory E

functions: c/1, d/1 [destructor], fst/1, pair/2, snd/1
equations: d(c(x)) = x, fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma final_failure_reachable:
  exists-trace "∃ #i. Done( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Done( ) @ #i)"
*/
simplify
solve( State_122222222( z ) ▶₀ #i )
  case lettagadz_2_12222222
  SOLVED // trace found
qed

