theory ManualVariantAutoSourcesRoundtrip

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

macros: identity( x ) =  x

rule (modulo E) Emit:
   [ In( <x, x> ), In( k ) ]
  --[ Original( sdec(x, k) ) ]->
   [ Out( sdec(x, k) ) ]
 variants
  rule (modulo AC) Emit___VARIANT_1:
     [ In( <cipher, cipher> ), In( key ) ]
    --[ Original( sdec(cipher, key) ), Added( 'a' ) ]->
     [ Out( sdec(cipher, key) ) ]
  ,
  rule (modulo AC) Emit___VARIANT_2:
     [ In( <senc(plain, key), senc(plain, key)> ), In( key ) ]
    --[
    AUTO_IN_TERM_0_0_1_0__Emit___VARIANT_2( senc(plain, key), plain ),
    AUTO_IN_TERM_0_0_0_0__Emit___VARIANT_2( senc(plain, key), plain ),
    Original( plain ), Added( 'a' )
    ]->
     [ Out( plain ) ]

lemma witness:
  exists-trace "∃ #i. Added( 'a' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Added( 'a' ) @ #i)"
*/
simplify
solve( Added( 'a' ) @ #i )
  case Emit___VARIANT_1
  SOLVED // trace found
qed

lemma false_safety:
  all-traces "∀ #i. (Added( 'a' ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Added( 'a' ) @ #i)"
*/
simplify
solve( Added( 'a' ) @ #i )
  case Emit___VARIANT_1
  SOLVED // trace found
qed

lemma AUTO_typing [sources]:
  all-traces
  "((⊤) ∧
    (∀ x m #i.
      (AUTO_IN_TERM_0_0_0_0__Emit___VARIANT_2( m, x ) @ #i) ⇒
      (∃ #j. (!KU( x ) @ #j) ∧ (#j < #i)))) ∧
   (∀ x m #i.
     (AUTO_IN_TERM_0_0_1_0__Emit___VARIANT_2( m, x ) @ #i) ⇒
     (∃ #j. (!KU( x ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"((∃ x m #i.
    (AUTO_IN_TERM_0_0_0_0__Emit___VARIANT_2( m, x ) @ #i)
   ∧
    ∀ #j. (!KU( x ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ x m #i.
    (AUTO_IN_TERM_0_0_1_0__Emit___VARIANT_2( m, x ) @ #i)
   ∧
    ∀ #j. (!KU( x ) @ #j) ⇒ ¬(#j < #i)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (∃ x m #i.
           (AUTO_IN_TERM_0_0_0_0__Emit___VARIANT_2( m, x ) @ #i)
          ∧
           ∀ #j. (!KU( x ) @ #j) ⇒ ¬(#j < #i))  ∥
         (∃ x m #i.
           (AUTO_IN_TERM_0_0_1_0__Emit___VARIANT_2( m, x ) @ #i)
          ∧
           ∀ #j. (!KU( x ) @ #j) ⇒ ¬(#j < #i)) )
    case case_1
    solve( (last(#i))  ∥
           (∃ #j. (!KU( x ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( !KU( senc(x, key) ) @ #vk.1 )
        case Emit___VARIANT_2
        by contradiction /* cyclic */
      next
        case c_senc
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( (last(#i))  ∥
           (∃ #j. (!KU( x ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
      case case_1
      solve( !KU( senc(x, key) ) @ #vk.1 )
        case Emit___VARIANT_2
        by contradiction /* cyclic */
      next
        case c_senc
        by contradiction /* from formulas */
      qed
    next
      case case_2
      by contradiction /* from formulas */
    qed
  qed
qed

