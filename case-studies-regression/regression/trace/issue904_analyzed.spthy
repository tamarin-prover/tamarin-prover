theory MarkerSecrecy

begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, pair/2, snd/1, tamXCAfoo/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Gen:
   [ Fr( ~s ) ]
  --[ Secret( ~s ) ]->
   [ Out( ('c'++fst(<tamXCAfoo(~s), 'c'>)) ) ]

  /*
  rule (modulo AC) Gen:
     [ Fr( ~s ) ] --[ Secret( ~s ) ]-> [ Out( ('c'++tamXCAfoo(~s)) ) ]
  */

lemma secret:
  all-traces "∀ s #i. (Secret( s ) @ #i) ⇒ (¬(∃ #j. K( s ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ s #i. (Secret( s ) @ #i) ∧ ∃ #j. (K( s ) @ #j)"
*/
simplify
by solve( !KU( ~s ) @ #vk )

/* All wellformedness checks were successful. */

