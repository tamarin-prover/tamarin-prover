theory SoundnessDiffSourceSide

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Init:
   [ ] --[ A( diff('a', 'b') ) ]-> [ State( diff('a', 'b') ) ]

rule (modulo E) Finish:
   [ State( x ) ] --[ B( x ) ]-> [ ]

lemma left_source [left, sources]:
  all-traces "∀ x #i. (A( x ) @ #i) ⇒ (x = 'a')"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (A( x ) @ #i) ∧ ¬(x = 'a')"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  by contradiction /* from formulas */
qed

lemma right_counterexample [right]:
  all-traces "∀ #i. (B( 'b' ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (B( 'b' ) @ #i)"
*/
simplify
solve( State( 'b' ) ▶₀ #i )
  case Init
  SOLVED // trace found
qed

lemma right_witness [right]:
  exists-trace "∃ #i. B( 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (B( 'b' ) @ #i)"
*/
simplify
solve( State( 'b' ) ▶₀ #i )
  case Init
  SOLVED // trace found
qed

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Destrd_0_fst
  backward-search
    case LHS
    step( simplify )
    by step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
  next
    case RHS
    step( simplify )
    by step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
  qed
next
  case Rule_Destrd_0_snd
  backward-search
    case LHS
    step( simplify )
    by step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
  next
    case RHS
    step( simplify )
    by step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
  qed
next
  case Rule_Equality
  backward-search
    case LHS
    step( simplify )
    by step( solve( !KD( x ) ▶₁ #i ) )
  next
    case RHS
    step( simplify )
    by step( solve( !KD( x ) ▶₁ #i ) )
  qed
next
  case Rule_Finish
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
next
  case Rule_Init
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
next
  case Rule_Send
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
qed

/* All wellformedness checks were successful. */

