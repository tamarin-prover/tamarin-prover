lemma no_invalid_success:
  all-traces "∀ x #i. (InvalidSuccess( x ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (InvalidSuccess( x ) @ #i)"
*/
simplify
by solve( State_211( x ) ▶₀ #i )

