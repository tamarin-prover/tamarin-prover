theory SoundnessSapicDestructorAlternatives

begin

// Function signature and definition of the equational theory E

functions: c1/1, c2/1, d/1 [destructor], fst/1, pair/2, snd/1
equations:
    d(c1(x)) = x,
    d(c2(x)) = x,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma success1:
  exists-trace "∃ x #i. Success1( x ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (Success1( x ) @ #i)"
*/
simplify
solve( State_11111( s, x ) ▶₀ #i )
  case letxdcs_4_1111
  SOLVED // trace found
qed

lemma success2:
  exists-trace "∃ x #i. Success2( x ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (Success2( x ) @ #i)"
*/
simplify
solve( State_12111( x, s ) ▶₀ #i )
  case letydcs_4_1211
  SOLVED // trace found
qed

lemma invalid_fails:
  exists-trace "∃ #i. InvalidFailure( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (InvalidFailure( ) @ #i)"
*/
simplify
solve( State_212( ) ▶₀ #i )
  case letzdinvalid_3_21
  SOLVED // trace found
qed

lemma no_failure1:
  all-traces "∀ #i. (Failure1( ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Failure1( ) @ #i)"
*/
simplify
by solve( State_11112( s ) ▶₀ #i )

lemma no_failure2:
