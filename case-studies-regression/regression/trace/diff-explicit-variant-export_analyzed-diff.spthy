theory DiffExplicitVariantExport

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

rule (modulo E) Key:
   [ Fr( ~k ) ] --> [ !Key( ~k ) ]

rule (modulo E) Secret:
   [ Fr( ~m ), !Key( ~k ) ] --[ Secret( ~m ) ]-> [ Out( senc(~m, ~k) ) ]

rule (modulo E) Dec:
   [ In( x ), !Key( k ) ] --> [ Out( sdec(x, k) ) ]
 left
  rule (modulo E) Dec:
     [ In( x ), !Key( k ) ] --> [ Out( sdec(x, k) ) ]
   variants
    rule (modulo AC) Dec___VARIANT_2:
       [ In( senc(z.2, k.1) ), !Key( k.1 ) ]
      --[ Decrypted( z.2 ) ]->
       [ Out( z.2 ) ]
    ,
    rule (modulo AC) Dec___VARIANT_1:
       [ In( x.2 ), !Key( k.1 ) ]
      --[ Unreduced( sdec(x.2, k.1) ) ]->
       [ Out( sdec(x.2, k.1) ) ]
 right
  rule (modulo E) Dec:
     [ In( x ), !Key( k ) ] --> [ Out( sdec(x, k) ) ]
   variants
    rule (modulo AC) Dec___VARIANT_2:
       [ In( senc(z.2, k.1) ), !Key( k.1 ) ]
      --[ Decrypted( z.2 ) ]->
       [ Out( z.2 ) ]
    ,
    rule (modulo AC) Dec___VARIANT_1:
       [ In( x.2 ), !Key( k.1 ) ]
      --[ Unreduced( sdec(x.2, k.1) ) ]->
       [ Out( sdec(x.2, k.1) ) ]

lemma unreduced_secret [right]:
  exists-trace "∃ m #i #j. (Secret( m ) @ #i) ∧ (Unreduced( m ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ m #i #j. (Secret( m ) @ #i) ∧ (Unreduced( m ) @ #j)"
*/
by simplify

