lemma decrypted_reachable [right]:
  exists-trace "∃ m #i. Decrypted( m ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ m #i. (Decrypted( m ) @ #i)"
*/
simplify
solve( !Key( k ) ▶₁ #i )
  case Key
  solve( !KU( senc(m, ~k) ) @ #vk )
    case Secret
    SOLVED // trace found
  qed
qed

