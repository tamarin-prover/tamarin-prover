                            (∀ pp lpp #t0.
                              (Unlock( pp, lpp, ~n.5 ) @ #t0)
                             ⇒
                              ((#t0 < #vr.34) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                         (#vr.43 < #vr.34) )
                    case case_2
