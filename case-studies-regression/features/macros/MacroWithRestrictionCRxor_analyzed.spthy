                by solve( (#vr.3, 0) ~~> (#vk.2, 0) )
              qed
            qed
          qed
        next
          case coerce
          solve( !KD( (~k⊕x) ) ▶₀ #vk.1 )
            case initiator
            by solve( (#vl, 0) ~~> (#vk.1, 0) )
          next
            case responder
            solve( (#vl, 0) ~~> (#vk.1, 0) )
              case d_0_fst
              by solve( (#vr.3, 0) ~~> (#vk.1, 0) )
            next
              case d_0_snd
              by solve( (#vr.3, 0) ~~> (#vk.1, 0) )
            qed
          qed
        qed
      next
        case coerce
        solve( !KD( (~k⊕~na⊕z) ) ▶₀ #vk )
          case initiator
          by solve( (#vl, 0) ~~> (#vk, 0) )
        next
          case responder
          solve( (#vl, 0) ~~> (#vk, 0) )
            case d_0_fst
            by solve( (#vr.3, 0) ~~> (#vk, 0) )
          next
            case d_0_snd
            by solve( (#vr.3, 0) ~~> (#vk, 0) )
          qed
        qed
      qed
    next
      case split_case_7
      solve( !KU( h((~k⊕x)) ) @ #vk.1 )
        case c_h
        solve( !KU( (~na⊕x) ) @ #vk.2 )
          case c_xor_case_1
          solve( !KU( (~k⊕x) ) @ #vk.3 )
            case c_xor_case_1
            by solve( !KU( ~k ) @ #vk.6 )
          next
            case c_xor_case_2
            solve( !KU( (~k⊕x.1) ) @ #vk.7 )
              case c_xor_case_1
              by contradiction /* forbidden AC constructor chain */
            next
              case c_xor_case_2
              by contradiction /* forbidden AC constructor chain */
            next
              case coerce
              solve( !KD( (~k⊕x.1) ) ▶₀ #vk.3 )
                case initiator
                by solve( (#vl, 0) ~~> (#vk.3, 0) )
              next
                case responder
                solve( (#vl, 0) ~~> (#vk.3, 0) )
                  case d_0_fst
                  by solve( (#vr.3, 0) ~~> (#vk.3, 0) )
                next
                  case d_0_snd
                  by solve( (#vr.3, 0) ~~> (#vk.3, 0) )
                qed
              qed
            qed
          next
            case coerce
            solve( !KD( (~k⊕x) ) ▶₀ #vk.2 )
              case initiator
              by solve( (#vl, 0) ~~> (#vk.2, 0) )
            next
              case responder
              solve( (#vl, 0) ~~> (#vk.2, 0) )
                case d_0_fst
                by solve( (#vr.3, 0) ~~> (#vk.2, 0) )
              next
                case d_0_snd
                by solve( (#vr.3, 0) ~~> (#vk.2, 0) )
              qed
            qed
          qed
        next
          case c_xor_case_2
          solve( !KU( (~k⊕x⊕x.1) ) @ #vk.3 )
            case c_xor_case_1
            solve( !KU( (~na⊕x.1) ) @ #vk.5 )
              case c_xor_case_1
              by contradiction /* forbidden AC constructor chain */
            next
              case c_xor_case_2
              by contradiction /* forbidden AC constructor chain */
            next
              case coerce
              solve( !KD( (~na⊕x.1) ) ▶₀ #vk.3 )
                case initiator
                by solve( (#vl, 0) ~~> (#vk.3, 0) )
              next
                case responder
                solve( (#vl, 0) ~~> (#vk.3, 0) )
                  case d_0_fst
                  by solve( (#vr.3, 0) ~~> (#vk.3, 0) )
                next
                  case d_0_snd
                  by solve( (#vr.3, 0) ~~> (#vk.3, 0) )
                qed
