solve( State_12121111( r, m ) ▶₀ #i )
  case ifxcheckreprlocp_0_1212111
  solve( splitEqs(1) )
    case split_case_1
    solve( !KU( rep(m, <'loc', 'p'>) ) @ #vk.2 )
      case outxrepxlocp_0_11111
      SOLVED // trace found
    qed
  qed
qed

lemma simp_p [reuse]:
  all-traces
  "∀ #i m.
    (!KU( rep(m, <'loc', 'p'>) ) @ #i) ⇒
    (∃ #j. Remote( m, <'loc', 'p'> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ #i m.
  (!KU( rep(m, <'loc', 'p'>) ) @ #i)
 ∧
  ∀ #j. (Remote( m, <'loc', 'p'> ) @ #j) ⇒ ⊥"
*/
simplify
solve( !KU( rep(m, <'loc', 'p'>) ) @ #i )
  case ReportRule
  by contradiction /* from formulas */
next
  case outxrepxlocp_0_11111
  by contradiction /* from formulas */
qed

