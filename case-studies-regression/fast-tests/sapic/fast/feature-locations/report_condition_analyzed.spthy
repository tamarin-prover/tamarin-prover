theory ReportCondition

begin

// Function signature and definition of the equational theory E

functions: check_rep/2 [destructor], fst/1, get_rep/1 [destructor],
           pair/2, rep/2 [private,constructor], report/1, snd/1
equations:
    check_rep(rep(x.1, x.2), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    get_rep(rep(x.1, x.2)) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

predicate: Report( x, y )<=>¬(y = 'loc')

lemma can_run_v:
  exists-trace "∃ #i m. Local( m, 'loc' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i m. (Local( m, 'loc' ) @ #i)"
*/
simplify
solve( State_121111( r, m ) ▶₀ #i )
  case ifxcheckreprloc_0_12111
  solve( splitEqs(1) )
    case split_case_1
    solve( !KU( rep(m, 'loc') ) @ #vk.2 )
      case outxrepxloc_0_1111111
      SOLVED // trace found
    qed
  qed
qed

lemma simp [reuse]:
  all-traces
  "∀ #i m. (!KU( rep(m, 'loc') ) @ #i) ⇒ (∃ #j. Remote( m, 'loc' ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ #i m.
  (!KU( rep(m, 'loc') ) @ #i) ∧ ∀ #j. (Remote( m, 'loc' ) @ #j) ⇒ ⊥"
*/
simplify
solve( !KU( rep(m, 'loc') ) @ #i )
  case ReportRule
  by contradiction /* from formulas */
next
  case outxrepxloc_0_1111111
  by contradiction /* from formulas */
qed

lemma attested_comput:
  all-traces
  "∀ #i m. (Local( m, 'loc' ) @ #i) ⇒ (∃ #j. Remote( m, 'loc' ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ #i m. (Local( m, 'loc' ) @ #i) ∧ ∀ #j. (Remote( m, 'loc' ) @ #j) ⇒ ⊥"
*/
simplify
solve( State_121111( r, m ) ▶₀ #i )
  case ifxcheckreprloc_0_12111
  solve( splitEqs(1) )
    case split_case_1
    by contradiction /* from formulas */
  next
    case split_case_2
    by solve( !KU( check_rep(r, 'loc') ) @ #vk.1 )
  qed
qed

restriction Restr_ReportRule_1:
  "∀ x #NOW. (Restr_ReportRule_1( x ) @ #NOW) ⇒ (¬(x = 'loc'))"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_ReportRule_1( x ) @ #NOW) ⇒ (¬(x = 'loc'))"
  */

rule (modulo E) ReportRule[color=#ffffff, process="!", issapicrule,
                           role='Process']:
   [ In( <x, loc> ) ]
  --[ Restr_ReportRule_1( loc ) ]->
   [ Out( rep(x, loc) ) ]

  /* has exactly the trivial AC variant */

