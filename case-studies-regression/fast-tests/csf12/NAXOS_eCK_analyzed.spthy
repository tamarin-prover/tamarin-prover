         z.2   = x.50^(x.51*inv((~lkI.31*x.52)))
    
    104. ~eskI = ~eskI.30
         ~lkI  = ~lkI.31
         Y     = x.50^(x.51*inv((x.52*h1(<~eskI.30, ~lkI.31>))))
         pkR   = x.54^(x.55*inv((x.56*h1(<~eskI.30, ~lkI.31>))))
         z     = x.50^(~lkI.31*x.51*inv((x.52*h1(<~eskI.30, ~lkI.31>))))
         z.1   = x.54^(x.55*inv(x.56))
         z.2   = x.50^(x.51*inv(x.52))
    
    105. Y     = DH_neutral
         pkR   = DH_neutral
         z     = DH_neutral
         z.1   = DH_neutral
         z.2   = DH_neutral
  */

rule (modulo E) Resp_1:
   [ Fr( ~eskR ), !Ltk( $R, ~lkR ), !Pk( $I, pkI ), In( X ) ]
  --[
  Accept( ~eskR, $R, $I,
          h2(<pkI^h1(<~eskR, ~lkR>), X^~lkR, X^h1(<~eskR, ~lkR>), $I, $R>)
  ),
  Sid( ~eskR, <'Resp', $R, $I, X, 'g'^h1(<~eskR, ~lkR>)> ),
  Match( ~eskR, <'Init', $I, $R, X, 'g'^h1(<~eskR, ~lkR>)> )
  ]->
   [
   Out( 'g'^h1(<~eskR, ~lkR>) ), !Ephk( ~eskR, ~eskR ),
   !Sessk( ~eskR,
           h2(<pkI^h1(<~eskR, ~lkR>), X^~lkR, X^h1(<~eskR, ~lkR>), $I, $R>)
   )
   ]

  /*
  rule (modulo AC) Resp_1:
     [ Fr( ~eskR ), !Ltk( $R, ~lkR ), !Pk( $I, pkI ), In( X ) ]
    --[
    Accept( ~eskR, $R, $I, h2(<z, z.1, z.2, $I, $R>) ),
    Sid( ~eskR, <'Resp', $R, $I, X, 'g'^h1(<~eskR, ~lkR>)> ),
    Match( ~eskR, <'Init', $I, $R, X, 'g'^h1(<~eskR, ~lkR>)> )
    ]->
     [
     Out( 'g'^h1(<~eskR, ~lkR>) ), !Ephk( ~eskR, ~eskR ),
     !Sessk( ~eskR, h2(<z, z.1, z.2, $I, $R>) )
     ]
    variants (modulo AC)
     1. ~eskR = ~eskR.23
        ~lkR  = ~lkR.24
        X     = X.25
        pkI   = DH_neutral
        z     = DH_neutral
        z.1   = X.25^~lkR.24
        z.2   = X.25^h1(<~eskR.23, ~lkR.24>)
    
     2. ~eskR = ~eskR.24
        ~lkR  = ~lkR.25
        X     = X.26
        pkI   = pkI.27
        z     = pkI.27^h1(<~eskR.24, ~lkR.25>)
        z.1   = X.26^~lkR.25
        z.2   = X.26^h1(<~eskR.24, ~lkR.25>)
    
     3. ~eskR = ~eskR.24
        ~lkR  = ~lkR.25
        X     = DH_neutral
        pkI   = pkI.27
        z     = pkI.27^h1(<~eskR.24, ~lkR.25>)
        z.1   = DH_neutral
        z.2   = DH_neutral
    
     4. ~eskR = ~eskR.27
        ~lkR  = ~lkR.28
        X     = z.33^inv(~lkR.28)
        pkI   = pkI.30
        z     = pkI.30^h1(<~eskR.27, ~lkR.28>)
        z.1   = z.33
        z.2   = z.33^(h1(<~eskR.27, ~lkR.28>)*inv(~lkR.28))
    
     5. ~eskR = ~eskR.27
        ~lkR  = ~lkR.28
        X     = z.33^inv(~lkR.28)
        pkI   = DH_neutral
        z     = DH_neutral
        z.1   = z.33
        z.2   = z.33^(h1(<~eskR.27, ~lkR.28>)*inv(~lkR.28))
    
     6. ~eskR = ~eskR.151
        ~lkR  = ~lkR.152
        X     = X.153
        pkI   = x.297^x.298
        z     = x.297^(x.298*h1(<~eskR.151, ~lkR.152>))
        z.1   = X.153^~lkR.152
        z.2   = X.153^h1(<~eskR.151, ~lkR.152>)
    
     7. ~eskR = ~eskR.151
        ~lkR  = ~lkR.152
        X     = DH_neutral
        pkI   = x.297^x.298
        z     = x.297^(x.298*h1(<~eskR.151, ~lkR.152>))
        z.1   = DH_neutral
        z.2   = DH_neutral
    
     8. ~eskR = ~eskR.151
        ~lkR  = ~lkR.152
        X     = x.297^x.298
        pkI   = pkI.154
        z     = pkI.154^h1(<~eskR.151, ~lkR.152>)
        z.1   = x.297^(~lkR.152*x.298)
        z.2   = x.297^(x.298*h1(<~eskR.151, ~lkR.152>))
    
     9. ~eskR = ~eskR.151
        ~lkR  = ~lkR.152
        X     = x.297^x.298
        pkI   = DH_neutral
        z     = DH_neutral
        z.1   = x.297^(~lkR.152*x.298)
        z.2   = x.297^(x.298*h1(<~eskR.151, ~lkR.152>))
    
    10. ~eskR = ~eskR.152
        ~lkR  = ~lkR.153
        X     = x.299^inv((~lkR.153*x.300))
        pkI   = pkI.155
        z     = pkI.155^h1(<~eskR.152, ~lkR.153>)
        z.1   = x.299^inv(x.300)
        z.2   = x.299^(h1(<~eskR.152, ~lkR.153>)*inv((~lkR.153*x.300)))
    
    11. ~eskR = ~eskR.152
        ~lkR  = ~lkR.153
        X     = x.299^inv((~lkR.153*x.300))
        pkI   = DH_neutral
        z     = DH_neutral
        z.1   = x.299^inv(x.300)
        z.2   = x.299^(h1(<~eskR.152, ~lkR.153>)*inv((~lkR.153*x.300)))
    
    12. ~eskR = ~eskR.152
        ~lkR  = ~lkR.153
        X     = x.299^(x.300*inv(~lkR.153))
        pkI   = pkI.155
        z     = pkI.155^h1(<~eskR.152, ~lkR.153>)
        z.1   = x.299^x.300
        z.2   = x.299^(x.300*h1(<~eskR.152, ~lkR.153>)*inv(~lkR.153))
    
    13. ~eskR = ~eskR.152
        ~lkR  = ~lkR.153
        X     = x.299^(x.300*inv(~lkR.153))
        pkI   = DH_neutral
        z     = DH_neutral
        z.1   = x.299^x.300
        z.2   = x.299^(x.300*h1(<~eskR.152, ~lkR.153>)*inv(~lkR.153))
    
    14. ~eskR = ~eskR.153
        ~lkR  = ~lkR.154
        X     = z.159^inv(~lkR.154)
        pkI   = x.301^x.302
        z     = x.301^(x.302*h1(<~eskR.153, ~lkR.154>))
        z.1   = z.159
        z.2   = z.159^(h1(<~eskR.153, ~lkR.154>)*inv(~lkR.154))
    
    15. ~eskR = ~eskR.153
        ~lkR  = ~lkR.154
        X     = x.299^x.300
        pkI   = x.301^x.302
        z     = x.301^(x.302*h1(<~eskR.153, ~lkR.154>))
        z.1   = x.299^(~lkR.154*x.300)
        z.2   = x.299^(x.300*h1(<~eskR.153, ~lkR.154>))
    
    16. ~eskR = ~eskR.153
        ~lkR  = ~lkR.154
        X     = x.300^(x.301*inv((~lkR.154*x.302)))
        pkI   = pkI.156
        z     = pkI.156^h1(<~eskR.153, ~lkR.154>)
        z.1   = x.300^(x.301*inv(x.302))
        z.2   = x.300^(x.301*h1(<~eskR.153, ~lkR.154>)*inv((~lkR.154*x.302)))
    
    17. ~eskR = ~eskR.153
        ~lkR  = ~lkR.154
        X     = x.300^(x.301*inv((~lkR.154*x.302)))
        pkI   = DH_neutral
        z     = DH_neutral
        z.1   = x.300^(x.301*inv(x.302))
        z.2   = x.300^(x.301*h1(<~eskR.153, ~lkR.154>)*inv((~lkR.154*x.302)))
    
    18. ~eskR = ~eskR.154
        ~lkR  = ~lkR.155
        X     = x.301^inv((~lkR.155*x.302))
        pkI   = x.303^x.304
        z     = x.303^(x.304*h1(<~eskR.154, ~lkR.155>))
        z.1   = x.301^inv(x.302)
        z.2   = x.301^(h1(<~eskR.154, ~lkR.155>)*inv((~lkR.155*x.302)))
    
    19. ~eskR = ~eskR.154
        ~lkR  = ~lkR.155
        X     = x.301^(x.302*inv(~lkR.155))
        pkI   = x.303^x.304
        z     = x.303^(x.304*h1(<~eskR.154, ~lkR.155>))
        z.1   = x.301^x.302
        z.2   = x.301^(x.302*h1(<~eskR.154, ~lkR.155>)*inv(~lkR.155))
    
    20. ~eskR = ~eskR.155
        ~lkR  = ~lkR.156
        X     = x.302^(x.303*inv((~lkR.156*x.304)))
        pkI   = x.305^x.306
        z     = x.305^(x.306*h1(<~eskR.155, ~lkR.156>))
        z.1   = x.302^(x.303*inv(x.304))
        z.2   = x.302^(x.303*h1(<~eskR.155, ~lkR.156>)*inv((~lkR.156*x.304)))
    
    21. X     = DH_neutral
        pkI   = DH_neutral
        z     = DH_neutral
        z.1   = DH_neutral
        z.2   = DH_neutral
  */

rule (modulo E) Sessk_reveal:
   [ !Sessk( ~tid, k ) ] --[ SesskRev( ~tid ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Ltk_reveal:
   [ !Ltk( $A, lkA ) ] --[ LtkRev( $A ) ]-> [ Out( lkA ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Ephk_reveal:
   [ !Ephk( ~s, ~ek ) ] --[ EphkRev( ~s ) ]-> [ Out( ~ek ) ]

  /* has exactly the trivial AC variant */

lemma eCK_key_secrecy:
  all-traces
  "∀ #i1 #i2 Test A B k.
    ((Accept( Test, A, B, k ) @ #i1) ∧ (K( k ) @ #i2)) ⇒
    ((((∃ #i3. SesskRev( Test ) @ #i3) ∨
       (∃ MatchingSession #i3 #i4 ms.
         ((Sid( MatchingSession, ms ) @ #i3) ∧ (Match( Test, ms ) @ #i4)) ∧
         (∃ #i5. SesskRev( MatchingSession ) @ #i5))) ∨
      (∃ MatchingSession #i3 #i4 ms.
        ((Sid( MatchingSession, ms ) @ #i3) ∧ (Match( Test, ms ) @ #i4)) ∧
        ((∃ #i5 #i6. (LtkRev( A ) @ #i5) ∧ (EphkRev( Test ) @ #i6)) ∨
         (∃ #i5 #i6.
           (LtkRev( B ) @ #i5) ∧ (EphkRev( MatchingSession ) @ #i6))))) ∨
     ((¬(∃ MatchingSession #i3 #i4 ms.
          (Sid( MatchingSession, ms ) @ #i3) ∧ (Match( Test, ms ) @ #i4))) ∧
      ((∃ #i5. LtkRev( B ) @ #i5) ∨
       (∃ #i5 #i6. (LtkRev( A ) @ #i5) ∧ (EphkRev( Test ) @ #i6)))))"
/*
guarded formula characterizing all counter-examples:
"∃ #i1 #i2 Test A B k.
  (Accept( Test, A, B, k ) @ #i1) ∧ (K( k ) @ #i2)
 ∧
  (∀ #i3. (SesskRev( Test ) @ #i3) ⇒ ⊥) ∧
  (∀ MatchingSession #i3 #i4 ms.
    (Sid( MatchingSession, ms ) @ #i3) ∧ (Match( Test, ms ) @ #i4)
   ⇒
    ∀ #i5. (SesskRev( MatchingSession ) @ #i5) ⇒ ⊥) ∧
  (∀ MatchingSession #i3 #i4 ms.
    (Sid( MatchingSession, ms ) @ #i3) ∧ (Match( Test, ms ) @ #i4)
   ⇒
    (∀ #i5 #i6. (LtkRev( A ) @ #i5) ∧ (EphkRev( Test ) @ #i6) ⇒ ⊥) ∧
    (∀ #i5 #i6.
      (LtkRev( B ) @ #i5) ∧ (EphkRev( MatchingSession ) @ #i6) ⇒ ⊥)) ∧
  (((∃ MatchingSession #i3 #i4 ms.
      (Sid( MatchingSession, ms ) @ #i3) ∧ (Match( Test, ms ) @ #i4)) ∨
    ((∀ #i5. (LtkRev( B ) @ #i5) ⇒ ⊥) ∧
     (∀ #i5 #i6. (LtkRev( A ) @ #i5) ∧ (EphkRev( Test ) @ #i6) ⇒ ⊥))))"
*/
simplify
solve( (∃ MatchingSession #i3 #i4 ms.
         (Sid( MatchingSession, ms ) @ #i3) ∧ (Match( Test, ms ) @ #i4))  ∥
       ((∀ #i5. (LtkRev( B ) @ #i5) ⇒ ⊥) ∧
        (∀ #i5 #i6. (LtkRev( A ) @ #i5) ∧ (EphkRev( Test ) @ #i6) ⇒ ⊥)) )
  case case_1
  solve( Accept( Test, A, B, k ) @ #i1 )
    case Init_2
    solve( Init_1( ~eskI, $I, $R, ~lkI, hkI ) ▶₀ #i1 )
      case Init_1
      solve( !Pk( $R, pkR ) ▶₁ #i1 )
        case generate_ltk
        solve( Sid( MatchingSession, ms ) @ #i3 )
          case Init_2
          solve( Init_1( ~eskI.1, $I.1, $R.1, ~lkI.1, hkI ) ▶₀ #i3 )
            case Init_1
            solve( !Pk( $R.1, pkR ) ▶₁ #i3 )
              case generate_ltk
              by solve( Match( ~eskI,
                               <'Init', $I.1, $R.1, 'g'^h1(<~eskI.1, ~lkI.1>), Y.1>
                        ) @ #i4 )
            qed
          qed
        next
          case Resp_1
          solve( !Ltk( $R.1, ~lkR ) ▶₁ #i3 )
            case generate_ltk
            solve( !Pk( $I.1, pkI ) ▶₂ #i3 )
              case generate_ltk
              solve( Match( ~eskI, <'Resp', $R.1, $I.1, X, 'g'^h1(<~eskR, ~lkR>)>
                     ) @ #i4 )
                case Init_2
                solve( Init_1( ~eskI, $I.1, $R.1, ~lkI.1, X ) ▶₀ #i4 )
                  case Init_1
                  solve( !KU( h2(<'g'^(~lkI*h1(<~eskR, ~lkR>)), 
                                  'g'^(~lkA*h1(<~eskI, ~lkI>)), 'g'^(h1(<~eskI, ~lkI>)*h1(<~eskR, ~lkR>)), 
                                  $I, $R>)
                         ) @ #vk )
                    case Sessk_reveal_case_1
                    by contradiction /* from formulas */
                  next
                    case Sessk_reveal_case_2
                    by contradiction /* from formulas */
                  next
                    case c_h2
                    solve( !KU( 'g'^(~lkI*h1(<~eskR, ~lkR>)) ) @ #vk.4 )
                      case Resp_1
                      solve( !KU( ~lkI ) @ #vk.12 )
                        case Ltk_reveal
                        solve( !KU( 'g'^(~lkA*h1(<~eskI, ~lkI>)) ) @ #vk.7 )
                          case Init_1
                          solve( !KU( ~lkA ) @ #vk.13 )
                            case Ltk_reveal
                            solve( !KU( 'g'^(h1(<~eskI, ~lkI>)*h1(<~eskR, ~lkR>)) ) @ #vk.10 )
                              case Init_1
                              solve( !KU( h1(<~eskR, ~lkR>) ) @ #vk.14 )
                                case c_h1
                                solve( !KU( ~eskR ) @ #vk.16 )
                                  case Ephk_reveal
                                  by contradiction /* from formulas */
                                qed
                              qed
                            next
                              case Resp_1
                              solve( !KU( h1(<~eskI, ~lkI>) ) @ #vk.14 )
                                case c_h1
                                solve( !KU( ~eskI ) @ #vk.16 )
                                  case Ephk_reveal
                                  by contradiction /* from formulas */
                                qed
                              qed
                            next
                              case c_exp
                              solve( !KU( h1(<~eskI, ~lkI>) ) @ #vk.16 )
                                case c_h1
                                solve( !KU( ~eskI ) @ #vk.19 )
                                  case Ephk_reveal
                                  by contradiction /* from formulas */
                                qed
                              qed
                            qed
                          qed
                        next
                          case c_exp
                          solve( !KU( ~lkA ) @ #vk.15 )
                            case Ltk_reveal
                            solve( !KU( h1(<~eskI, ~lkI>) ) @ #vk.16 )
                              case c_h1
                              solve( !KU( ~eskI ) @ #vk.18 )
                                case Ephk_reveal
                                by contradiction /* from formulas */
                              qed
                            qed
                          qed
                        next
                          case generate_ltk
                          solve( !KU( h1(<~eskI, ~lkI>) ) @ #vk.13 )
                            case c_h1
                            solve( !KU( ~eskI ) @ #vk.15 )
                              case Ephk_reveal
                              by contradiction /* from formulas */
                            qed
                          qed
                        qed
                      qed
                    next
                      case c_exp
                      solve( !KU( ~lkI ) @ #vk.14 )
                        case Ltk_reveal
                        solve( !KU( h1(<~eskR, ~lkR>) ) @ #vk.15 )
                          case c_h1
                          solve( !KU( ~eskR ) @ #vk.17 )
                            case Ephk_reveal
                            solve( !KU( ~lkR ) @ #vk.18 )
                              case Ltk_reveal
                              by contradiction /* from formulas */
                            qed
                          qed
                        qed
                      qed
                    next
                      case generate_ltk
                      solve( !KU( h1(<~eskR, ~lkR>) ) @ #vk.12 )
                        case c_h1
                        solve( !KU( ~eskR ) @ #vk.14 )
                          case Ephk_reveal
                          solve( !KU( ~lkR ) @ #vk.15 )
                            case Ltk_reveal
                            by contradiction /* from formulas */
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case Resp_1
    solve( !Ltk( $R, ~lkR ) ▶₁ #i1 )
      case generate_ltk
      solve( !Pk( $I, pkI ) ▶₂ #i1 )
        case generate_ltk
        solve( Sid( MatchingSession, ms ) @ #i3 )
          case Init_2
          solve( Init_1( ~eskI, $I.1, $R.1, ~lkI, hkI ) ▶₀ #i3 )
            case Init_1
            solve( !Pk( $R.1, pkR ) ▶₁ #i3 )
              case generate_ltk
              solve( Match( ~eskR, <'Init', $I.1, $R.1, 'g'^h1(<~eskI, ~lkI>), Y>
                     ) @ #i4 )
                case Resp_1
                solve( !KU( h2(<'g'^(~lkA*h1(<~eskR, ~lkR>)), 
                                'g'^(~lkR*h1(<~eskI, ~lkI>)), 'g'^(h1(<~eskI, ~lkI>)*h1(<~eskR, ~lkR>)), 
                                $I, $R>)
                       ) @ #vk )
                  case Sessk_reveal_case_1
                  by contradiction /* from formulas */
                next
                  case Sessk_reveal_case_2
                  by contradiction /* from formulas */
                next
                  case c_h2
                  solve( !KU( 'g'^(~lkA*h1(<~eskR, ~lkR>)) ) @ #vk.4 )
                    case Resp_1
                    solve( !KU( ~lkA ) @ #vk.12 )
                      case Ltk_reveal
                      solve( !KU( 'g'^(~lkR*h1(<~eskI, ~lkI>)) ) @ #vk.7 )
                        case Init_1
                        solve( !KU( ~lkR ) @ #vk.13 )
                          case Ltk_reveal
                          solve( !KU( 'g'^(h1(<~eskI, ~lkI>)*h1(<~eskR, ~lkR>)) ) @ #vk.10 )
                            case Init_1
                            solve( !KU( h1(<~eskR, ~lkR>) ) @ #vk.14 )
                              case c_h1
                              solve( !KU( ~eskR ) @ #vk.16 )
                                case Ephk_reveal
                                by contradiction /* from formulas */
                              qed
                            qed
                          next
                            case Resp_1
                            solve( !KU( h1(<~eskI, ~lkI>) ) @ #vk.14 )
                              case c_h1
                              solve( !KU( ~eskI ) @ #vk.16 )
                                case Ephk_reveal
                                by contradiction /* from formulas */
                              qed
                            qed
                          next
                            case c_exp
                            solve( !KU( h1(<~eskI, ~lkI>) ) @ #vk.16 )
                              case c_h1
                              solve( !KU( ~eskI ) @ #vk.19 )
                                case Ephk_reveal
                                by contradiction /* from formulas */
                              qed
                            qed
                          qed
                        qed
                      next
                        case c_exp
                        solve( !KU( ~lkR ) @ #vk.15 )
                          case Ltk_reveal
                          solve( !KU( h1(<~eskI, ~lkI>) ) @ #vk.16 )
                            case c_h1
                            solve( !KU( ~eskI ) @ #vk.18 )
                              case Ephk_reveal
                              by contradiction /* from formulas */
                            qed
                          qed
                        qed
                      next
                        case generate_ltk
                        solve( !KU( h1(<~eskI, ~lkI>) ) @ #vk.13 )
                          case c_h1
                          solve( !KU( ~eskI ) @ #vk.15 )
                            case Ephk_reveal
                            by contradiction /* from formulas */
                          qed
                        qed
                      qed
                    qed
                  next
                    case c_exp
                    solve( !KU( ~lkA ) @ #vk.14 )
                      case Ltk_reveal
                      solve( !KU( h1(<~eskR, ~lkR>) ) @ #vk.15 )
                        case c_h1
                        solve( !KU( ~eskR ) @ #vk.17 )
                          case Ephk_reveal
                          solve( !KU( ~lkR ) @ #vk.18 )
                            case Ltk_reveal
                            by contradiction /* from formulas */
                          qed
                        qed
                      qed
                    qed
                  next
                    case generate_ltk
                    solve( !KU( h1(<~eskR, ~lkR>) ) @ #vk.12 )
                      case c_h1
                      solve( !KU( ~eskR ) @ #vk.14 )
                        case Ephk_reveal
                        solve( !KU( ~lkR ) @ #vk.15 )
                          case Ltk_reveal
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        next
          case Resp_1
          solve( !Ltk( $R.1, ~lkR.1 ) ▶₁ #i3 )
            case generate_ltk
