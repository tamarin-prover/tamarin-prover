      qed
    next
      case c_PeqPVote
      solve( AgSt_Au( $A, $S ) ▶₀ #a )
        case Setup
        solve( AgSt_Au( 'A', $S ) ▶₀ #i )
          case Setup
          solve( In_A( 'BB',
                       <'codes', 
                        (<cp(<v1, hV1>, pk(skS)), sndcode1> add 
