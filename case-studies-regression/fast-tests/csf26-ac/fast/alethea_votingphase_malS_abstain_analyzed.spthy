lemma Universal_VerProofY_v6 [heuristic={Universal_VerProofY_v6}]:
  all-traces
  "∀ A x1 x2 skS #i BB codes #a S y1 y2.
    (((Learn_A_YSGs( S, A, <'ySG', (y1 add y2)> ) @ #a) ∧
      (Learn_A_Cs( S, A, <'codes', codes> ) @ #a)) ∧
     (VerProofY( A, BB,
                 PeqPY(<cp(x1, pk(skS)), cp(x2, pk(skS))>, <x2, x1>, skS),
                 <cp(x1, pk(skS)), cp(x2, pk(skS))>, <x2, x1>
      ) @ #i)) ⇒
    (∃ #b hY1 hY2 fstcode1 fstcode2 n1 n2.
      (((BB_Cs( BB, <'codes', codes> ) @ #b) ∧
        (BB_yPrime( n1, BB, y1 ) @ #b)) ∧
       (BB_yPrime( n2, BB, y2 ) @ #b)) ∧
      (codes =
       (<fstcode1, cp(<y1, hY1>, pk(skS))> add 
        <fstcode2, cp(<y2, hY2>, pk(skS))>)))"
/*
guarded formula characterizing all counter-examples:
"∃ A x1 x2 skS #i BB codes #a S y1 y2.
  (Learn_A_YSGs( S, A, <'ySG', (y1 add y2)> ) @ #a) ∧
  (Learn_A_Cs( S, A, <'codes', codes> ) @ #a) ∧
  (VerProofY( A, BB,
              PeqPY(<cp(x1, pk(skS)), cp(x2, pk(skS))>, <x2, x1>, skS),
              <cp(x1, pk(skS)), cp(x2, pk(skS))>, <x2, x1>
   ) @ #i)
 ∧
  ∀ #b hY1 hY2 fstcode1 fstcode2 n1 n2.
   (BB_Cs( BB, <'codes', codes> ) @ #b) ∧
   (BB_yPrime( n1, BB, y1 ) @ #b) ∧
   (BB_yPrime( n2, BB, y2 ) @ #b) ∧
   (codes =
    (<fstcode1, cp(<y1, hY1>, pk(skS))> add 
     <fstcode2, cp(<y2, hY2>, pk(skS))>))
  ⇒
   ⊥"
*/
simplify
  case 1
  solve( AgSt_Au( $A, $S ) ▶₀ #i )
    case Setup
    solve( AgSt_Au( 'A', $S ) ▶₀ #a )
      case Setup
      solve( In_A( $BB,
                   <'codes', 
                    (<fstcode1, cp(<y2, hY2>, pk(skS))> add 
                     <fstcode2, cp(<y1, hY1>, pk(skS))>)
                   >
             ) ▶₆ #a )
        case ChanIn_A_case_1
        solve( In_A( 'BB',
                     <'proofY', 
                      PeqPY(<cp(<y2, hY2>, pk(skS)), cp(<y1, hY1>, pk(skS))>,
                            <<y1, hY1>, y2, hY2>, skS)
                     >
               ) ▶₈ #a )
          case ChanIn_A
          solve( !KU( PeqPY(<cp(<y2, hY2>, pk(skS)), cp(<y1, hY1>, pk(skS))>,
                            <<y1, hY1>, y2, hY2>, skS)
                 ) @ #vk.20 )
            case H_2
            solve( In_S( 'H2', 'D2', vote ) ▶₁ #vr.12 )
              case ChanIn_S
              by contradiction /* forbidden KD-fact */
            qed
          next
            case c_PeqPY
            solve( In_A( 'BB', <'ySG', (y1 add y2)> ) ▶₁ #a )
              case ChanIn_A_case_1
              solve( In_A( 'BB', <'yPrime', (h(<'H1', ~x1>) add h(<'H2', ~x2>))>
                     ) ▶₂ #a )
                case ChanIn_A_case_1
                by contradiction /* from formulas */
              next
                case ChanIn_A_case_2
                by contradiction /* from formulas */
              qed
            next
              case ChanIn_A_case_2
              solve( In_A( 'BB', <'yPrime', (h(<'H1', ~x1>) add h(<'H2', ~x2>))>
                     ) ▶₂ #a )
                case ChanIn_A_case_1
                by contradiction /* from formulas */
              next
                case ChanIn_A_case_2
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      next
        case ChanIn_A_case_2
        solve( In_A( 'BB',
                     <'proofY', 
                      PeqPY(<cp(<y2, hY2>, pk(skS)), cp(<y1, hY1>, pk(skS))>,
                            <<y1, hY1>, y2, hY2>, skS)
                     >
               ) ▶₈ #a )
          case ChanIn_A
          solve( !KU( PeqPY(<cp(<y2, hY2>, pk(skS)), cp(<y1, hY1>, pk(skS))>,
                            <<y1, hY1>, y2, hY2>, skS)
                 ) @ #vk.20 )
            case H_2
            solve( In_S( 'H2', 'D2', vote ) ▶₁ #vr.12 )
              case ChanIn_S
              by contradiction /* forbidden KD-fact */
            qed
          next
            case c_PeqPY
            solve( In_A( 'BB', <'ySG', (y1 add y2)> ) ▶₁ #a )
              case ChanIn_A_case_1
              solve( In_A( 'BB', <'yPrime', (h(<'H1', ~x1>) add h(<'H2', ~x2>))>
                     ) ▶₂ #a )
                case ChanIn_A_case_1
                by contradiction /* from formulas */
              next
                case ChanIn_A_case_2
                by contradiction /* from formulas */
              qed
            next
              case ChanIn_A_case_2
              solve( In_A( 'BB', <'yPrime', (h(<'H1', ~x1>) add h(<'H2', ~x2>))>
                     ) ▶₂ #a )
                case ChanIn_A_case_1
                by contradiction /* from formulas */
              next
                case ChanIn_A_case_2
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      qed
    qed
  qed
