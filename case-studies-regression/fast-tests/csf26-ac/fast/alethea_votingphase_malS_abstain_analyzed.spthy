lemma Universal_VerProofV_v7 [heuristic={Universal_VerProofV_v7}]:
  all-traces
  "∀ S A x1 x2 skS #a #i BB v1 v2 codes.
    (((Learn_A_Vs( S, A, <'votes', (v1 add v2)> ) @ #a) ∧
      (Learn_A_Cs( S, A, <'codes', codes> ) @ #a)) ∧
     (VerProofV( A, BB,
                 PeqPVote(<cp(x1, pk(skS)), cp(x2, pk(skS))>, <x2, x1>, skS),
                 <cp(x2, pk(skS)), cp(x1, pk(skS))>, <x1, x2>
      ) @ #i)) ⇒
    (∃ #b hV1 hV2 sndcode1 sndcode2 n1 n2.
      (((BB_Cs( BB, <'codes', codes> ) @ #b) ∧ (BB_V( n1, BB, v1 ) @ #b)) ∧
       (BB_V( n2, BB, v2 ) @ #b)) ∧
      (codes =
       (<cp(<v1, hV1>, pk(skS)), sndcode1> add 
        <cp(<v2, hV2>, pk(skS)), sndcode2>)))"
/*
guarded formula characterizing all counter-examples:
"∃ S A x1 x2 skS #a #i BB v1 v2 codes.
  (Learn_A_Vs( S, A, <'votes', (v1 add v2)> ) @ #a) ∧
  (Learn_A_Cs( S, A, <'codes', codes> ) @ #a) ∧
  (VerProofV( A, BB,
              PeqPVote(<cp(x1, pk(skS)), cp(x2, pk(skS))>, <x2, x1>, skS),
              <cp(x2, pk(skS)), cp(x1, pk(skS))>, <x1, x2>
   ) @ #i)
 ∧
  ∀ #b hV1 hV2 sndcode1 sndcode2 n1 n2.
   (BB_Cs( BB, <'codes', codes> ) @ #b) ∧
   (BB_V( n1, BB, v1 ) @ #b) ∧
   (BB_V( n2, BB, v2 ) @ #b) ∧
   (codes =
    (<cp(<v1, hV1>, pk(skS)), sndcode1> add 
     <cp(<v2, hV2>, pk(skS)), sndcode2>))
  ⇒
   ⊥"
*/
simplify
  case 1
  solve( In_A( $BB.1,
               <'proofV', 
                PeqPVote(<cp(<v1.1, hV1.1>, pk(skS)), cp(<v2.1, hV2.1>, pk(skS))>,
                         <<v2.1, hV2.1>, v1.1, hV1.1>, skS)
               >
         ) ▶₇ #i )
    case ChanIn_A
    solve( !KU( PeqPVote(<cp(<v1.1, hV1.1>, pk(skS)), 
                          cp(<v2.1, hV2.1>, pk(skS))>,
                         <<v2.1, hV2.1>, v1.1, hV1.1>, skS)
           ) @ #vk.17 )
      case H_2
      solve( AgSt_Au( $A, $S ) ▶₀ #a )
        case Setup
        solve( AgSt_Au( 'A', $S ) ▶₀ #i )
          case Setup
          solve( In_A( 'BB',
                       <'codes', 
                        (<cp(<v1, hV1>, pk(skS)), sndcode2> add 
                         <cp(<v2, hV2>, pk(skS)), sndcode1>)
                       >
                 ) ▶₆ #a )
            case ChanIn_A_case_1
            solve( In_S( 'H2', 'D2', vote ) ▶₁ #vr.10 )
              case ChanIn_S
              by contradiction /* forbidden KD-fact */
            qed
          next
            case ChanIn_A_case_2
            solve( In_S( 'H2', 'D2', vote ) ▶₁ #vr.10 )
              case ChanIn_S
              by contradiction /* forbidden KD-fact */
            qed
          qed
        qed
      qed
    next
      case c_PeqPVote
      solve( AgSt_Au( $A, $S ) ▶₀ #a )
        case Setup
        solve( AgSt_Au( 'A', $S ) ▶₀ #i )
          case Setup
          solve( In_A( 'BB',
                       <'codes', 
                        (<cp(<v1, hV1>, pk(skS)), sndcode2> add 
                         <cp(<v2, hV2>, pk(skS)), sndcode1>)
                       >
                 ) ▶₆ #a )
            case ChanIn_A_case_1
            solve( In_A( 'BB', <'ySG', (y1 add y2)> ) ▶₁ #a )
