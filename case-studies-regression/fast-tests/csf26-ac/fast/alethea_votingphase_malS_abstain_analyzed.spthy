rule (modulo E) ChanOut_S:
   [ Out_S( $A, $B, x ) ]
  --[ ChanOut_S( $A, $B, x ) ]->
   [ !Sec( $A, $B, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_S:
   [ !Sec( $A, $B, x ) ] --[ ChanIn_S( $A, $B, x ) ]-> [ In_S( $A, $B, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanOut_A:
   [ Out_A( $A, x ) ]
  --[ ChanOut_A( $A, x ) ]->
   [ !Auth( $A, x ), Out( <$A, x> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_A:
   [ !Auth( $A, x ) ] --[ ChanIn_A( $A, x ) ]-> [ In_A( $A, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) publickeyinfrastructure:
   [ Fr( ~skX ) ]
  --[ LongtermKey( $X, ~skX ) ]->
   [ !Ltk( $X, ~skX ), !Pk( $X, pk(~skX) ), Out( pk(~skX) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Setup:
   [ !Ltk( 'S', ~skS ), Fr( ~x1 ), Fr( ~x2 ) ]
  --[
  Setup( ), HV( '1', h(<~x1, $ind1>) ), HV( '2', h(<~x2, $ind2>) ),
  HY( '1', h(~x1) ), HY( '2', h(~x2) ), V( '1', 'empty' ), V( '2', $v2 ),
  X( ~x1, ~x2 )
  ]->
   [
   AgSt_H0( 'H1', <'D1', 'S', 'BB', 'empty', h(<'H1', ~x1>)> ),
   AgSt_H0( 'H2', <'D2', 'S', 'BB', $v2, h(<'H2', ~x2>)> ),
   AgSt_D0( 'D1', <'S', 'BB', 'H1', pk(~skS), ~x1, $ind1> ),
   AgSt_D0( 'D2', <'S', 'BB', 'H2', pk(~skS), ~x2, $ind2> ),
   AgSt_BB0( 'BB', <'ySG', (h(<'H1', ~x1>) add h(<'H2', ~x2>))> ),
   AgSt_Au( 'A', 'S' ),
   Out_A( 'BB', <'ySG', (h(<'H1', ~x1>) add h(<'H2', ~x2>))> ),
   Out( <~skS, 'H1', 'H2', 'D1', 'D2', ~x1, ~x2, $ind1, $ind2, 'BB'> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_1:
   [ AgSt_H0( $H, <$D, $S, $BB, vote, y> ) ]
  --[ Vote( $H, vote ) ]->
   [ AgSt_H1( $H, <$D, $S, $BB, vote, y> ), Out_S( $H, $D, vote ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) D_1:
   [ AgSt_D0( $D, <$S, $BB, $H, pkS, ~x, $ind> ), In_S( $H, $D, vote ) ]
  -->
   [
   Out_S( $D, $H,
          <$H, <cp(<vote, h(<~x, $ind>)>, pkS), cp(<h(<$H, ~x>), h(~x)>, pkS)>, 
           $ind>
   )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) H_2_abstain:
   [
   AgSt_H1( $H, <$D, $S, $BB, 'empty', y> ), In_S( $D, $H, <$H, code, ind> )
   ]
  --[ MyCode( $H, code ) ]->
   [ AgSt_H2( $H, <$D, $S, $BB, 'empty', y, ind, code> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_2:
   [ AgSt_H1( $H, <$D, $S, $BB, vote, y> ), In_S( $D, $H, <$H, code, ind> )
   ]
  --[ MyCode( $H, code ), Comm_H_V( $H, $S, vote ) ]->
   [ AgSt_H2( $H, <$D, $S, $BB, vote, y, ind, code> ), Out( <code, ind> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BB:
   [
   AgSt_BB0( $BB, ySG ), In( <'votes', ($vote1 add $vote2)> ),
   In( <'pVs', (pV1 add pV2)> ), In( <'pYs', (pY1 add pY2)> ),
   In( <'yPrime', (yPrime1 add yPrime2)> ),
   In( <'codes', (code1 add code2)> ), In( <'proofV', proofV> ),
   In( <'proofY', proofY> )
   ]
  --[
  BB_V( '1', $BB, $vote1 ), BB_V( '2', $BB, $vote2 ),
  BB_pV( '1', $BB, pV1 ), BB_pV( '2', $BB, pV2 ),
  BB_yPrime( '1', $BB, yPrime1 ), BB_yPrime( '2', $BB, yPrime2 ),
  BB_pY( '1', $BB, pY1 ), BB_pY( '2', $BB, pY2 ), BB_C( '1', $BB, code1 ),
  BB_C( '2', $BB, code2 ), BB_Cs( $BB, <'codes', (code1 add code2)> ),
  BB_proofV( $BB, proofV ), BB_proofY( $BB, proofY )
  ]->
   [
   Out_A( $BB, <'votes', ($vote1 add $vote2)> ),
   Out_A( $BB, <'pVs', (pV1 add pV2)> ),
   Out_A( $BB, <'pYs', (pY1 add pY2)> ),
   Out_A( $BB, <'yPrime', (yPrime1 add yPrime2)> ),
   Out_A( $BB, <'codes', (code1 add code2)> ),
   Out_A( $BB, <'proofV', proofV> ), Out_A( $BB, <'proofY', proofY> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) auditor:
   [
   AgSt_Au( $A, $S ), In_A( $BB, <'ySG', (y1 add y2)> ),
   In_A( $BB, <'yPrime', (y1 add y2)> ),
   In_A( $BB, <'votes', (v1 add v2)> ),
   In_A( $BB, <'pVs', (<v1, hV1> add <v2, hV2>)> ),
   In_A( $BB, <'pYs', (<y1, hY1> add <y2, hY2>)> ),
   In_A( $BB, <'codes', (<fstcode1, sndcode1> add <fstcode2, sndcode2>)> ),
   In_A( $BB, <'proofV', proofV> ), In_A( $BB, <'proofY', proofY> )
   ]
  --[
  Learn_A_Vs( $S, $A, <'votes', (v1 add v2)> ),
  Learn_A_YSGs( $S, $A, <'ySG', (y1 add y2)> ),
  Learn_A_Cs( $S, $A,
              <'codes', (<fstcode1, sndcode1> add <fstcode2, sndcode2>)>
  ),
  VerProofV( $A, $BB, proofV, <fstcode1, fstcode2>, <<v1, hV1>, v2, hV2> ),
  VerProofY( $A, $BB, proofY, <sndcode1, sndcode2>, <<y1, hY1>, y2, hY2> )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_3:
   [
   AgSt_H2( $H, <$D, $S, $BB, vote, y, ind, code> ),
   In_A( $BB, <'codes', (codeBBOther add mycodeBB)> )
   ]
  --[ Learn_H_C( $H, $S, mycodeBB ) ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction OneSetup:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  */

restriction NotSendEmpty:
  "∀ #i H S. (Comm_H_V( H, S, 'empty' ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ #i H S. (Comm_H_V( H, S, 'empty' ) @ #i) ⇒ (⊥)"
  */

lemma functional [heuristic={functional}]:
  exists-trace
  "∃ #i1 #i2 #j1 #j2 H1 H2 S vote2 fstcode1 sndcode1 fstcode2 sndcode2 #s
     hV1 hV2 hY1 hY2 x1 x2 #adv1 #adv2 #k BB skS y1 y2 A #a #l #m.
    ((((((((((((((((((((((((((((¬(H1 = H2)) ∧ (¬('empty' = vote2))) ∧
                              (Vote( H1, 'empty' ) @ #i1)) ∧
                             (Vote( H2, vote2 ) @ #i2)) ∧
                            (MyCode( H1, <fstcode1, sndcode1> ) @ #j1)) ∧
                           (MyCode( H2, <fstcode2, sndcode2> ) @ #j2)) ∧
                          (HV( '1', hV1 ) @ #s)) ∧
                         (V( '1', 'empty' ) @ #s)) ∧
                        (HV( '2', hV2 ) @ #s)) ∧
                       (V( '2', vote2 ) @ #s)) ∧
                      (HY( '1', hY1 ) @ #s)) ∧
                     (HY( '2', hY2 ) @ #s)) ∧
                    (X( x1, x2 ) @ #s)) ∧
                   (K( x1 ) @ #adv1)) ∧
                  (K( x2 ) @ #adv2)) ∧
                 (BB_C( '1', BB, <fstcode1, sndcode1> ) @ #k)) ∧
                (BB_C( '2', BB, <fstcode2, sndcode2> ) @ #k)) ∧
               (BB_V( '1', BB, 'empty' ) @ #k)) ∧
              (BB_V( '2', BB, vote2 ) @ #k)) ∧
             (BB_pV( '1', BB, <'empty', hV1> ) @ #k)) ∧
            (BB_pV( '2', BB, <vote2, hV2> ) @ #k)) ∧
           (BB_proofV( BB,
                       PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS)
            ) @ #k)) ∧
          (BB_pY( '1', BB, <y1, hY1> ) @ #k)) ∧
         (BB_pY( '2', BB, <y2, hY2> ) @ #k)) ∧
        (BB_proofY( BB, PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS)
         ) @ #k)) ∧
       (Learn_H_C( H1, S, <fstcode1, sndcode1> ) @ #l)) ∧
      (Learn_H_C( H2, S, <fstcode2, sndcode2> ) @ #m)) ∧
     (VerProofV( A, BB,
                 PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS),
                 <fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>
      ) @ #a)) ∧
    (VerProofY( A, BB,
                PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS),
                <sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>
     ) @ #a)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i1 #i2 #j1 #j2 H1 H2 S vote2 fstcode1 sndcode1 fstcode2 sndcode2 #s
   hV1 hV2 hY1 hY2 x1 x2 #adv1 #adv2 #k BB skS y1 y2 A #a #l #m.
  (Vote( H1, 'empty' ) @ #i1) ∧
  (Vote( H2, vote2 ) @ #i2) ∧
  (MyCode( H1, <fstcode1, sndcode1> ) @ #j1) ∧
  (MyCode( H2, <fstcode2, sndcode2> ) @ #j2) ∧
  (HV( '1', hV1 ) @ #s) ∧
  (V( '1', 'empty' ) @ #s) ∧
  (HV( '2', hV2 ) @ #s) ∧
  (V( '2', vote2 ) @ #s) ∧
  (HY( '1', hY1 ) @ #s) ∧
  (HY( '2', hY2 ) @ #s) ∧
  (X( x1, x2 ) @ #s) ∧
  (K( x1 ) @ #adv1) ∧
  (K( x2 ) @ #adv2) ∧
  (BB_C( '1', BB, <fstcode1, sndcode1> ) @ #k) ∧
  (BB_C( '2', BB, <fstcode2, sndcode2> ) @ #k) ∧
  (BB_V( '1', BB, 'empty' ) @ #k) ∧
  (BB_V( '2', BB, vote2 ) @ #k) ∧
  (BB_pV( '1', BB, <'empty', hV1> ) @ #k) ∧
  (BB_pV( '2', BB, <vote2, hV2> ) @ #k) ∧
  (BB_proofV( BB,
              PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS)
   ) @ #k) ∧
  (BB_pY( '1', BB, <y1, hY1> ) @ #k) ∧
  (BB_pY( '2', BB, <y2, hY2> ) @ #k) ∧
  (BB_proofY( BB, PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS)
   ) @ #k) ∧
  (Learn_H_C( H1, S, <fstcode1, sndcode1> ) @ #l) ∧
  (Learn_H_C( H2, S, <fstcode2, sndcode2> ) @ #m) ∧
  (VerProofV( A, BB,
              PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS),
              <fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>
   ) @ #a) ∧
  (VerProofY( A, BB,
              PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS),
              <sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>
   ) @ #a)
 ∧
  (¬(H1 = H2)) ∧ (¬('empty' = vote2))"
*/
simplify
solve( In_A( $BB.2,
             <'proofV', 
              PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS.1)>
       ) ▶₇ #a )
  case ChanIn_A
  solve( In_A( 'BB',
               <'proofY', PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS)>
         ) ▶₈ #a )
    case ChanIn_A
    solve( !KU( PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>,
                         skS)
           ) @ #vk.24 )
      case c_PeqPVote
      solve( !KU( PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS)
             ) @ #vk.27 )
        case c_PeqPY
        solve( BB_C( '1', 'BB', <fstcode1, sndcode1> ) @ #k )
          case BB
          solve( BB_C( '2', 'BB', <fstcode2, sndcode2> ) @ #k )
            case BB
            solve( In_A( $BB.2, <'codes', (codeBBOther add <fstcode1, sndcode1>)>
                   ) ▶₁ #l )
              case ChanIn_A_case_2
              solve( In_A( $BB.2, <'codes', (codeBBOther add <fstcode2, sndcode2>)>
                     ) ▶₁ #m )
                case ChanIn_A_case_1
                solve( AgSt_H0( $H, <$D, $S.1, $BB, 'empty', y> ) ▶₀ #i1 )
                  case Setup_case_1
                  solve( AgSt_H0( $H, <$D, $S.1, $BB, vote2, y> ) ▶₀ #i2 )
                    case Setup_case_2
                    solve( AgSt_BB0( 'BB', ySG ) ▶₀ #k )
                      case Setup
                      solve( AgSt_Au( $A, $S ) ▶₀ #a )
                        case Setup
                        solve( AgSt_H2( 'H1', <$D, $S, 'BB', vote, y, ind, code> ) ▶₀ #l )
                          case H_2_abstain
                          solve( AgSt_H2( 'H2', <$D, 'S', 'BB', vote.1, y, ind, code> ) ▶₀ #m )
                            case H_2
                            solve( BB_V( '1', 'BB', 'empty' ) @ #k )
                              case BB
                              solve( BB_V( '2', 'BB', $v2 ) @ #k )
                                case BB
                                solve( BB_pV( '1', 'BB', <'empty', hV1> ) @ #k )
                                  case BB
                                  solve( BB_pV( '2', 'BB', <$v2, hV2> ) @ #k )
                                    case BB
                                    solve( BB_pY( '1', 'BB', <y1, hY1> ) @ #k )
                                      case BB
                                      solve( BB_pY( '2', 'BB', <y2, hY2> ) @ #k )
                                        case BB
                                        solve( In_S( 'H1', 'D1', vote ) ▶₁ #vr.11 )
                                          case ChanIn_S
                                          solve( In_S( 'H2', 'D2', vote ) ▶₁ #vr.15 )
                                            case ChanIn_S
                                            solve( In_A( 'BB', <'ySG', (y1 add y2)> ) ▶₁ #a )
                                              case ChanIn_A_case_1
                                              solve( In_A( 'BB',
                                                           <'yPrime', (h(<'H1', ~x1>) add h(<'H2', ~x2>))>
                                                     ) ▶₂ #a )
                                                case ChanIn_A_case_1
                                                solve( In_A( 'BB', <'votes', ('empty' add $v2)> ) ▶₃ #a )
                                                  case ChanIn_A_case_1
                                                  solve( In_A( 'BB', <'pVs', (<'empty', hV1> add <$v2, hV2>)>
                                                         ) ▶₄ #a )
                                                    case ChanIn_A_case_2
                                                    solve( In_A( 'BB',
                                                                 <'pYs', 
                                                                  (<h(<'H1', ~x1>), hY1> add 
                                                                   <h(<'H2', ~x2>), hY2>)
                                                                 >
                                                           ) ▶₅ #a )
                                                      case ChanIn_A
                                                      solve( In_A( 'BB',
                                                                   <'codes', 
                                                                    (<fstcode1, sndcode1> add 
                                                                     <fstcode2, sndcode2>)
                                                                   >
                                                             ) ▶₆ #a )
                                                        case ChanIn_A_case_1
                                                        solve( MyCode( 'H1', <fstcode1, sndcode1> ) @ #j1 )
                                                          case H_2_abstain
                                                          solve( AgSt_H1( 'H1', <$D, $S, $BB, 'empty', y>
                                                                 ) ▶₀ #j1 )
                                                            case H_1
                                                            solve( !KU( (<fstcode2, sndcode2> add 
                                                                         <
                                                                          cp(<'empty', h(<~x1, $ind1>)>,
                                                                             pk(~skS)), 
                                                                          cp(<h(<'H1', ~x1>), h(~x1)>,
                                                                             pk(~skS))
                                                                         >
                                                                        )
                                                                   ) @ #vk.20 )
                                                              case c_add
                                                              solve( !KU( cp(<'empty', h(<~x1, $ind1>)>,
                                                                             pk(~skS))
                                                                     ) @ #vk.26 )
                                                                case c_cp
                                                                solve( !KU( cp(<h(<'H1', ~x1>), h(~x1)>,
                                                                               pk(~skS))
                                                                       ) @ #vk.39 )
                                                                  case c_cp
                                                                  solve( MyCode( 'H2', <fstcode2, sndcode2>
                                                                         ) @ #j2 )
                                                                    case H_2
                                                                    solve( AgSt_H1( 'H2',
                                                                                    <$D, $S, $BB, vote, y>
                                                                           ) ▶₀ #j2 )
                                                                      case H_1
                                                                      solve( !KU( cp(<$v2, h(<~x2, $ind2>)>,
                                                                                     pk(~skS))
                                                                             ) @ #vk.30 )
                                                                        case H_2_case_1
                                                                        solve( !KU( cp(<h(<'H2', ~x2>), h(~x2)
                                                                                       >,
                                                                                       pk(~skS))
                                                                               ) @ #vk.40 )
                                                                          case H_2_case_2
                                                                          solve( HV( '1', hV1 ) @ #s )
                                                                            case Setup
                                                                            solve( V( '1', 'empty' ) @ #s )
                                                                              case Setup
                                                                              solve( HV( '2', hV2 ) @ #s )
                                                                                case Setup
                                                                                solve( V( '2', $v2 ) @ #s )
                                                                                  case Setup
                                                                                  solve( HY( '1', hY1 ) @ #s )
                                                                                    case Setup
                                                                                    solve( HY( '2', hY2
                                                                                           ) @ #s )
                                                                                      case Setup
                                                                                      solve( !KU( (
                                                                                                   'empty' add 
                                                                                                   $v2)
                                                                                             ) @ #vk.18 )
                                                                                        case c_add
                                                                                        solve( !KU( (
                                                                                                     <
                                                                                                      'empty', 
                                                                                                      h(<~x1, 
                                                                                                         $ind1
                                                                                                        >)
                                                                                                     > add 
                                                                                                     <$v2, 
                                                                                                      h(<~x2, 
                                                                                                         $ind2
                                                                                                        >)
                                                                                                     >
                                                                                                    )
                                                                                               ) @ #vk.21 )
                                                                                          case c_add
                                                                                          solve( !KU( (
                                                                                                       <
                                                                                                        h(<
                                                                                                           'H1', 
                                                                                                           ~x1
                                                                                                          >), 
                                                                                                        h(~x1)
                                                                                                       > add 
                                                                                                       <
                                                                                                        h(<
                                                                                                           'H2', 
                                                                                                           ~x2
                                                                                                          >), 
                                                                                                        h(~x2)
                                                                                                       >
                                                                                                      )
                                                                                                 ) @ #vk.24 )
                                                                                            case c_add
                                                                                            solve( !KU( (
                                                                                                         h(<
                                                                                                            'H1', 
                                                                                                            ~x1
                                                                                                           >) add 
                                                                                                         h(<
                                                                                                            'H2', 
                                                                                                            ~x2
                                                                                                           >)
                                                                                                        )
                                                                                                   ) @ #vk.27 )
                                                                                              case c_add
                                                                                              solve( !KU( ~x1
                                                                                                     ) @ #vk.21 )
                                                                                                case Setup
                                                                                                solve( !KU( ~x2
                                                                                                       ) @ #vk.23 )
                                                                                                  case Setup
                                                                                                  solve( !KU( h(<
                                                                                                                 'H1', 
                                                                                                                 ~x1
                                                                                                                >)
                                                                                                         ) @ #vk.41 )
                                                                                                    case ChanOut_A
                                                                                                    solve( !KU( h(<
                                                                                                                   'H2', 
                                                                                                                   ~x2
                                                                                                                  >)
                                                                                                           ) @ #vk.44 )
                                                                                                      case ChanOut_A
                                                                                                      solve( !KU( pk(~skS)
                                                                                                             ) @ #vk.46 )
                                                                                                        case c_pk
                                                                                                        solve( !KU( h(<
                                                                                                                       ~x1, 
                                                                                                                       $ind1
                                                                                                                      >)
                                                                                                               ) @ #vk.41 )
                                                                                                          case c_h
                                                                                                          solve( !KU( h(~x1)
                                                                                                                 ) @ #vk.46 )
                                                                                                            case c_h
                                                                                                            solve( !KU( h(<
                                                                                                                           ~x2, 
                                                                                                                           $ind2
                                                                                                                          >)
                                                                                                                   ) @ #vk.46 )
                                                                                                              case H_2_case_2
                                                                                                              solve( !KU( h(~x2)
                                                                                                                     ) @ #vk.47 )
                                                                                                                case H_2_case_2
                                                                                                                solve( !KU( ~skS
                                                                                                                       ) @ #vk.48 )
                                                                                                                  case Setup
                                                                                                                  SOLVED // trace found
                                                                                                                qed
                                                                                                              qed
                                                                                                            qed
                                                                                                          qed
                                                                                                        qed
                                                                                                      qed
                                                                                                    qed
                                                                                                  qed
                                                                                                qed
                                                                                              qed
                                                                                            qed
                                                                                          qed
                                                                                        qed
                                                                                      qed
                                                                                    qed
                                                                                  qed
                                                                                qed
                                                                              qed
                                                                            qed
                                                                          qed
                                                                        qed
                                                                      qed
                                                                    qed
                                                                  qed
                                                                qed
                                                              qed
                                                            qed
                                                          qed
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma indivVerif [heuristic={indivVerif}]:
  all-traces
  "∀ H S vote fstcode sndcode #i2 #i #j.
    (((Vote( H, vote ) @ #i2) ∧ (MyCode( H, <fstcode, sndcode> ) @ #i)) ∧
     (Learn_H_C( H, S, <fstcode, sndcode> ) @ #j)) ⇒
    (∃ BB #k hV pkS codeOther.
      (BB_Cs( BB, <'codes', (codeOther add <fstcode, sndcode>)> ) @ #k) ∧
      (fstcode = cp(<vote, hV>, pkS)))"
/*
guarded formula characterizing all counter-examples:
"∃ H S vote fstcode sndcode #i2 #i #j.
  (Vote( H, vote ) @ #i2) ∧
  (MyCode( H, <fstcode, sndcode> ) @ #i) ∧
  (Learn_H_C( H, S, <fstcode, sndcode> ) @ #j)
 ∧
  ∀ BB #k hV pkS codeOther.
   (BB_Cs( BB, <'codes', (codeOther add <fstcode, sndcode>)> ) @ #k) ∧
   (fstcode = cp(<vote, hV>, pkS))
  ⇒
   ⊥"
*/
simplify
solve( AgSt_H0( $H, <$D, $S, $BB, vote, y> ) ▶₀ #i2 )
  case Setup_case_1
  solve( AgSt_H2( 'H1', <$D, $S, $BB, vote, y, ind, code> ) ▶₀ #j )
    case H_2_abstain
    solve( In_S( 'H1', 'D1', vote ) ▶₁ #vr.5 )
      case ChanIn_S
      solve( In_A( 'BB', <'codes', (codeBBOther add <fstcode, sndcode>)>
             ) ▶₁ #j )
        case ChanIn_A_case_1
        solve( MyCode( 'H1', <fstcode, sndcode> ) @ #i )
          case H_2
          by solve( AgSt_H1( 'H1', <$D, $S, $BB, vote, y> ) ▶₀ #i )
        next
          case H_2_abstain
          solve( AgSt_H1( 'H1', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        qed
      next
        case ChanIn_A_case_2
        solve( MyCode( 'H1', <fstcode, sndcode> ) @ #i )
          case H_2
          by solve( AgSt_H1( 'H1', <$D, $S, $BB, vote, y> ) ▶₀ #i )
        next
          case H_2_abstain
          solve( AgSt_H1( 'H1', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        qed
      next
        case ChanIn_A_case_3
        solve( MyCode( 'H1', <fstcode, sndcode> ) @ #i )
          case H_2
          by solve( AgSt_H1( 'H1', <$D, $S, $BB, vote, y> ) ▶₀ #i )
        next
          case H_2_abstain
          solve( AgSt_H1( 'H1', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        qed
      next
        case ChanIn_A_case_4
        solve( MyCode( 'H1', <fstcode, sndcode> ) @ #i )
          case H_2
          by solve( AgSt_H1( 'H1', <$D, $S, $BB, vote, y> ) ▶₀ #i )
        next
          case H_2_abstain
          solve( AgSt_H1( 'H1', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
next
  case Setup_case_2
  solve( AgSt_H2( 'H2', <$D, $S, $BB, vote, y, ind, code> ) ▶₀ #j )
    case H_2
    solve( In_S( 'H2', 'D2', vote ) ▶₁ #vr.5 )
      case ChanIn_S
      solve( In_A( 'BB', <'codes', (codeBBOther add <fstcode, sndcode>)>
             ) ▶₁ #j )
        case ChanIn_A_case_1
        solve( MyCode( 'H2', <fstcode, sndcode> ) @ #i )
          case H_2
          solve( AgSt_H1( 'H2', <$D, $S, $BB, vote, y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        next
          case H_2_abstain
          by solve( AgSt_H1( 'H2', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
        qed
      next
        case ChanIn_A_case_2
        solve( MyCode( 'H2', <fstcode, sndcode> ) @ #i )
          case H_2
          solve( AgSt_H1( 'H2', <$D, $S, $BB, vote, y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        next
          case H_2_abstain
          by solve( AgSt_H1( 'H2', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
        qed
      next
        case ChanIn_A_case_3
        solve( MyCode( 'H2', <fstcode, sndcode> ) @ #i )
          case H_2
          solve( AgSt_H1( 'H2', <$D, $S, $BB, vote, y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        next
          case H_2_abstain
          by solve( AgSt_H1( 'H2', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
        qed
      next
        case ChanIn_A_case_4
        solve( MyCode( 'H2', <fstcode, sndcode> ) @ #i )
          case H_2
          solve( AgSt_H1( 'H2', <$D, $S, $BB, vote, y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        next
          case H_2_abstain
          by solve( AgSt_H1( 'H2', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
        qed
      qed
    qed
  next
    case H_2_abstain
    solve( In_S( 'H2', 'D2', vote ) ▶₁ #vr.5 )
      case ChanIn_S
      solve( In_A( 'BB', <'codes', (codeBBOther add <fstcode, sndcode>)>
             ) ▶₁ #j )
        case ChanIn_A_case_1
        solve( MyCode( 'H2', <fstcode, sndcode> ) @ #i )
          case H_2
          by solve( AgSt_H1( 'H2', <$D, $S, $BB, vote, y> ) ▶₀ #i )
        next
          case H_2_abstain
          solve( AgSt_H1( 'H2', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        qed
      next
        case ChanIn_A_case_2
        solve( MyCode( 'H2', <fstcode, sndcode> ) @ #i )
          case H_2
          by solve( AgSt_H1( 'H2', <$D, $S, $BB, vote, y> ) ▶₀ #i )
        next
          case H_2_abstain
          solve( AgSt_H1( 'H2', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        qed
      next
        case ChanIn_A_case_3
        solve( MyCode( 'H2', <fstcode, sndcode> ) @ #i )
          case H_2
          by solve( AgSt_H1( 'H2', <$D, $S, $BB, vote, y> ) ▶₀ #i )
        next
          case H_2_abstain
          solve( AgSt_H1( 'H2', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        qed
      next
        case ChanIn_A_case_4
        solve( MyCode( 'H2', <fstcode, sndcode> ) @ #i )
          case H_2
          by solve( AgSt_H1( 'H2', <$D, $S, $BB, vote, y> ) ▶₀ #i )
        next
          case H_2_abstain
          solve( AgSt_H1( 'H2', <$D, $S, $BB, 'empty', y> ) ▶₀ #i )
            case H_1
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

lemma Universal_VerProofV_v1 [heuristic={Universal_VerProofV_v1}]:
  all-traces
  "∀ S A x1 x2 skS #a #i BB v1 v2 codes.
    (((Learn_A_Vs( S, A, <'votes', (v1 add v2)> ) @ #a) ∧
      (Learn_A_Cs( S, A, <'codes', codes> ) @ #a)) ∧
     (VerProofV( A, BB,
                 PeqPVote(<cp(x1, pk(skS)), cp(x2, pk(skS))>, <x1, x2>, skS),
