theory alethea_votingphase_malS_abstain

begin

// Function signature and definition of the equational theory E

functions: PeqPVote/3, PeqPY/3, adec/2, aenc/2, cp/2, dcp/2, fst/1, h/1,
           pair/2, pk/1, sdec/2, senc/2, sign/2, snd/1, true/0,
           unionUD/1 [destructor], verify/3, add/2 [AC]
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    dcp(cp(x, pk(sk)), sk) = x,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    unionUD((x add y)) = x,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

