      solve( AgSt_Au( $A, $S ) ▶₀ #a )
        case Setup
        solve( AgSt_Au( 'A', $S ) ▶₀ #i )
          case Setup
          solve( In_A( 'BB',
                       <'codes', 
                        (<cp(<v1, hV1>, pk(skS)), sndcode1> add 
                         <cp(<v2, hV2>, pk(skS)), sndcode2>)
                       >
                 ) ▶₆ #a )
            case ChanIn_A_case_1
            solve( In_S( 'H2', 'D2', vote ) ▶₁ #vr.10 )
