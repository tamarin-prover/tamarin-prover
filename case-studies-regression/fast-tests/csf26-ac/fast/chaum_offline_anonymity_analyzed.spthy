          qed
        next
          case c_sign
          solve( !KU( blind(x, ~r) ) @ #vk.1 )
            case C_1_case_1
            by contradiction /* from formulas */
          next
            case C_1_case_2
            by contradiction /* from formulas */
          next
            case C_2_case_01
            solve( Mint( x.1, ~y.1, ~r.1 ) @ #j )
              case C_1_case_1
              solve( (#vr.4, 0) ~~> (#vk.1, 0) )
                case d_1_xorr_case_1
                by solve( (#vr.6, 0) ~~> (#vk.1, 0) )
              next
                case d_1_xorr_case_2
                by solve( (#vr.6, 0) ~~> (#vk.1, 0) )
              next
                case d_1_xorr_case_3
                by solve( (#vr.6, 0) ~~> (#vk.1, 0) )
              next
                case d_1_xorr_case_4
                by solve( (#vr.6, 0) ~~> (#vk.1, 0) )
              qed
            next
              case C_1_case_2
              by solve( (#vr.4, 0) ~~> (#vk.1, 0) )
            qed
          next
            case C_2_case_02
            solve( Mint( x.1, ~y.1, ~r.1 ) @ #j )
              case C_1_case_1
              solve( (#vr.4, 0) ~~> (#vk.1, 0) )
