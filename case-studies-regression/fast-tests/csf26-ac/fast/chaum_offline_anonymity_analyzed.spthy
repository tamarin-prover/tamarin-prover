                      ) @ #j )
          next
            case C_2_case_12
            by solve( Mint( blind(blind(blind(x.1, x.2), x.3), x.4), ~y.1, ~r.1
                      ) @ #j )
          next
            case C_2_case_13
            by solve( Mint( blind(blind(x.1, x.2), x.3), ~y.1, ~r.1 ) @ #j )
          next
            case C_2_case_14
            by solve( Mint( blind(x.1, x.2), ~y.1, ~r.1 ) @ #j )
          next
            case C_2_case_15
            solve( Mint( x.1, ~y.1, ~r.1 ) @ #j )
              case C_1_case_1
              solve( (#vr.5, 0) ~~> (#vk.1, 0) )
                case d_1_xorr_case_1
                by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
              next
                case d_1_xorr_case_2
                by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
              next
                case d_1_xorr_case_3
                by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
              next
                case d_1_xorr_case_4
