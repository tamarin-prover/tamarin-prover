lemma exec:
  exists-trace "∃ x y r #i. Spend( x, y, r ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x y r #i. (Spend( x, y, r ) @ #i)"
*/
simplify
solve( !St_C_1( x, ~y, ~r ) ▶₀ #i )
  case C_1_case_1
  solve( !Bank_Pk( $B, pk(~skB) ) ▶₂ #i )
    case Register_Corrupted_Bank_pk
    solve( !KU( sign(blind(x, ~r), ~skB) ) @ #vk )
      case c_sign
      solve( !KU( blind(x, ~r) ) @ #vk.1 )
        case C_1_case_1
        solve( !KU( ~skB ) @ #vk.2 )
          case Register_Corrupted_Bank_pk
          SOLVED // trace found
        qed
      qed
    qed
  qed
qed

lemma anonymity:
  all-traces
  "∀ C #i.
    (TestSubject( C ) @ #i) ⇒
    ((¬(∃ #j. !KU( C ) @ #j)) ∨
     (∃ x r #i.1 #j.
       ((Spend( C, x, r ) @ #i.1) ∧ (Spend( C, x, r ) @ #j)) ∧ (¬(#i.1 = #j))))"
/*
guarded formula characterizing all counter-examples:
"∃ C #i.
  (TestSubject( C ) @ #i)
 ∧
  (∃ #j. (!KU( C ) @ #j)) ∧
  (∀ x r #i.1 #j.
    (Spend( C, x, r ) @ #i.1) ∧ (Spend( C, x, r ) @ #j) ⇒ #i.1 = #j)"
*/
simplify
solve( !KU( ~C ) @ #j )
  case C_1_case_1
  by solve( !KU( ~r ) @ #vk )
next
  case C_1_case_2
  by solve( !KU( ~r ) @ #vk )
next
  case C_2_case_1
  solve( !KU( ~y ) @ #vk.1 )
    case C_1_case_1
    by solve( !KU( ~r ) @ #vk.2 )
  next
    case C_1_case_2
    by solve( !KU( ~r ) @ #vk.2 )
  next
    case C_2
    by contradiction /* cyclic */
  qed
next
  case C_2_case_2
  solve( !KU( ~y ) @ #vk.2 )
    case C_1_case_1
    by solve( !KU( ~r ) @ #vk.4 )
  next
    case C_1_case_2
    by solve( !KU( ~r ) @ #vk.4 )
  next
    case C_2
    by contradiction /* cyclic */
  qed
qed

lemma caught:
  exists-trace
  "∃ C #j x r #i1 #i2 #k.
    ((((TestSubject( C ) @ #j) ∧ (!KU( C ) @ #k)) ∧
      (Spend( C, x, r ) @ #i1)) ∧
     (Spend( C, x, r ) @ #i2)) ∧
    (¬(#i1 = #i2))"
/*
guarded formula characterizing all satisfying traces:
"∃ C #j x r #i1 #i2 #k.
  (TestSubject( C ) @ #j) ∧
  (!KU( C ) @ #k) ∧
  (Spend( C, x, r ) @ #i1) ∧
  (Spend( C, x, r ) @ #i2)
 ∧
  ¬(#i1 = #i2)"
*/
simplify
solve( (#i1 < #i2)  ∥ (#i2 < #i1) )
  case case_1
  solve( !St_C_1( ~C, ~y, ~r ) ▶₀ #i1 )
    case C_1
