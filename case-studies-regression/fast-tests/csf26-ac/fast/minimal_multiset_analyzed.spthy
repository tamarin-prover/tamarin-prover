theory minimal_multiset

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1, unionUD/1 [destructor], add/2 [AC]
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    unionUD((x add y)) = x

rule (modulo E) A:
   [ Fr( ~x ) ] --> [ Out( ($A add ~x) ), S( ~x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) B:
   [ S( ~x ), In( ~x ) ] --[ Reach( ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma Reachable:
  exists-trace "∃ #i. Reach( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Reach( ) @ #i)"
*/
simplify
solve( S( ~x ) ▶₀ #i )
  case A
  solve( !KU( ~x ) @ #vk )
    case A
    SOLVED // trace found
  qed
qed

