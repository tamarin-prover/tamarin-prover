theory PartialEvaluationCollision

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

text{* the abstract state after partial evaluation contains 3 facts:

1. Fr( ~z )

2. Out( z )

3. In( z )

This abstract state results in 1 refined multiset rewriting rules.
Kept 1 original rule families to preserve their variants on export.
Note that the original number of multiset rewriting rules was 2.

*}

rule (modulo E) Dec:
   [ In( x ) ] --> [ Out( sdec(x, 'k') ) ]

  /*
  rule (modulo AC) Dec:
     [ In( x ) ] --> [ Out( z ) ]
    variants (modulo AC)
    1. x     = x.3
       z     = sdec(x.3, 'k')
    
    2. x     = senc(x.3, 'k')
       z     = x.3
  */

rule (modulo E) Dec___VARIANT_2:
   [ ] --[ Marker( ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma reachable:
  exists-trace "∃ #i. Marker( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Marker( ) @ #i)"
*/
simplify
SOLVED // trace found

lemma false_safety:
  all-traces "¬(∃ #i. Marker( ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Marker( ) @ #i)"
*/
simplify
SOLVED // trace found

/* All wellformedness checks were successful. */

