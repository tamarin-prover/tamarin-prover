theory DiffJointConditionalAttack

begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Produce:
   [ ] --> [ F( ('a'++'b') ) ]

rule (modulo E) Consume:
   [ F( (x++y) ) ] --[ Choice( x, y, $p, $q ) ]-> [ Out( <$p, $q> ) ]

restriction Choices [right]:
  "∀ x y p q #i.
    (Choice( x, y, p, q ) @ #i) ⇒
    (((x = 'a') ∨ (¬(q = 'b'))) ∧ ((x = 'b') ∨ (¬(p = 'a'))))"
  // safety formula

  /*
  expanded formula:
  "∀ x y p q #i.
    (Choice( x, y, p, q ) @ #i) ⇒
    (((x = 'a') ∨ (¬(q = 'b'))) ∧ ((x = 'b') ∨ (¬(p = 'a'))))"
  */

lemma left_attack_assignment [left]:
  exists-trace "∃ x y #i. Choice( x, y, 'a', 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x y #i. (Choice( x, y, 'a', 'b' ) @ #i)"
*/
simplify
solve( F( (x++y) ) ▶₀ #i )
  case Produce_case_1
  SOLVED // trace found
qed

lemma right_attack_assignment [right]:
  exists-trace "∃ x y #i. Choice( x, y, 'a', 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x y #i. (Choice( x, y, 'a', 'b' ) @ #i)"
*/
by simplify

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Consume
  backward-search
    case LHS
    step( simplify )
    step( solve( F( (x++y) ) ▶₀ #i ) )
      case Produce_case_1
      by ATTACK // trace found
    qed
  qed
qed

/* All wellformedness checks were successful. */

