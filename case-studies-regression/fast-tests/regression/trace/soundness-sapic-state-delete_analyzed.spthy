theory SoundnessSapicStateDelete

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma setup_reachable:
  exists-trace "∃ #i. Setup( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Setup( ) @ #i)"
*/
simplify
solve( State_11111( StateChannel, s ) ▶₀ #i )
  case inserts_0_1111
  SOLVED // trace found
qed

lemma deletion_reaches_else:
  exists-trace
  "∃ #i #j.
    ((BeforeDelete( '0' ) @ #i) ∧ (MissingAfterDelete( ) @ #j)) ∧ (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j.
  (BeforeDelete( '0' ) @ #i) ∧ (MissingAfterDelete( ) @ #j) ∧ #i < #j"
*/
simplify
solve( State_211111( StateChannel, '0', s ) ▶₀ #i )
  case lookupsasbefore_0_21111
  solve( (#vr.1 < #t2)  ∥ (#vr.1 = #t2) )
    case case_2
    solve( State_2111111112( StateChannel, before, lock, s ) ▶₀ #j )
      case lookupsasv_1_211111111
      solve( (∀ #t1 y. (Insert( ~n.1, y ) @ #t1) ⇒ #vr.6 < #t1)  ∥
             (∃ #t1.
               (Delete( ~n.1 ) @ #t1)
              ∧
               (#t1 < #vr.6) ∧
               (∀ #t2 y.
                 (Insert( ~n.1, y ) @ #t2) ⇒ ((¬(#t2 < #vr.6)) ∨ (#t2 < #t1)))) )
        case case_2
        solve( (#t2 < #t2.1)  ∥ (#t2 = #t2.1) )
          case case_2
          solve( Delete( ~n.1 ) @ #t1 )
            case deletes_0_2111111
            solve( State_2111111( StateChannel, before, ~n.1 ) ▶₀ #t1 )
              case eventBeforeDeletebefore_0_211111
              solve( (#t2 < #t2.1)  ∥ (#t2 = #t2.1) )
                case case_2
                solve( Insert( ~n.1, '0' ) @ #t2 )
                  case inserts_0_2111
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma deleted_unreachable:
  all-traces "∀ v #i. (B( v ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ v #i. (B( v ) @ #i)"
*/
simplify
solve( State_111111111( StateChannel, lock, s, v ) ▶₀ #i )
  case lookupsasv_0_11111111
  solve( Insert( ~n.2, v ) @ #t2 )
    case inserts_0_1111
    solve( State_1111( StateChannel, ~n.2 ) ▶₀ #t2 )
      case newStateChannelchannel_0_111
      by contradiction /* cyclic */
    qed
  next
    case inserts_0_2111
    by contradiction /* cyclic */
  next
    case insertsv_0_1111111111
    by contradiction /* cyclic */
  next
    case insertsv_0_21111111111
    by contradiction /* cyclic */
  qed
qed

lemma control_deleted_unreachable:
  all-traces "∀ v #i. (UnexpectedRead( v ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ v #i. (UnexpectedRead( v ) @ #i)"
*/
simplify
solve( State_2111111111( StateChannel, before, lock, s, v ) ▶₀ #i )
  case lookupsasv_0_211111111
  solve( (#vr.5 < #t2.1)  ∥ (#vr.5 = #t2.1) )
    case case_1
    solve( Insert( ~n.2, v ) @ #t2 )
      case inserts_0_1111
      by contradiction /* cyclic */
    next
      case inserts_0_2111
      solve( State_2111( StateChannel, ~n.2 ) ▶₀ #t2 )
        case newStateChannelchannel_0_211
        by contradiction /* cyclic */
      qed
    next
      case insertsv_0_1111111111
      by contradiction /* cyclic */
    next
      case insertsv_0_21111111111
      by contradiction /* cyclic */
    qed
  next
    case case_2
    solve( Insert( ~n.2, v ) @ #t2.1 )
      case inserts_0_1111
      by contradiction /* cyclic */
    next
      case inserts_0_2111
      solve( State_2111( StateChannel, ~n.2 ) ▶₀ #t2.1 )
        case newStateChannelchannel_0_211
        by contradiction /* cyclic */
      qed
    next
      case insertsv_0_1111111111
      by contradiction /* cyclic */
    next
      case insertsv_0_21111111111
      by contradiction /* cyclic */
    qed
  qed
qed

rule (modulo E) Init[color=#ffffff, process="|", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) p_0_[color=#ffffff, process="|", issapicrule,
                     role='Process']:
   [ State_( ) ] --> [ State_1( ), State_2( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Candidate_0_1[color=#ffffff, process="Candidate();",
                              issapicrule, role='Process']:
   [ State_1( ) ] --> [ State_11( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) news_0_11[color=#624080, process="new s.1;", issapicrule,
                          role='Candidate']:
   [ State_11( ), Fr( s.1 ) ] --> [ State_111( s.1 ) ]

  /*
