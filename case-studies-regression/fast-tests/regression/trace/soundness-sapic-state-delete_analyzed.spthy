                                             process="new StateChannel:channel;", issapicrule,
                                             role='Process']:
   [ State_111( s.1 ), Fr( StateChannel ) ]
  -->
   [ State_1111( StateChannel, s.1 ) ]

  /*
  rule (modulo AC) newStateChannelchannel_0_111[color=#ffffff,
                                                process="new StateChannel:channel;", issapicrule,
                                                role='Process']:
     [ State_111( s ), Fr( StateChannel ) ]
    -->
     [ State_1111( StateChannel, s ) ]
  */

