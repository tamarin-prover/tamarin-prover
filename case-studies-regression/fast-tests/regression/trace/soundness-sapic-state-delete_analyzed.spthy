                               issapicrule, role='Candidate']:
   [ State_1111( StateChannel, s.1 ) ]
  --[ Insert( s.1, '0' ) ]->
   [ State_11111( StateChannel, s.1 ) ]

  /*
  rule (modulo AC) inserts_0_1111[color=#624080, process="insert s.1,'0';",
                                  issapicrule, role='Candidate']:
     [ State_1111( StateChannel, s ) ]
    --[ Insert( s, '0' ) ]->
     [ State_11111( StateChannel, s ) ]
  */

