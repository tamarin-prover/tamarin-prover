theory DiffSideRestrictionChoices

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

restriction Restr_P_LHS_1 [left]:
  "∀ x #NOW. (Restr_P_LHS_1( x ) @ #NOW) ⇒ (x = 'left')"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_P_LHS_1( x ) @ #NOW) ⇒ (x = 'left')"
  */

rule (modulo E) P:
   [ ] --[ Made( 'ok' ) ]-> [ Out( 'ok' ) ]
 left
  rule (modulo E) P:
     [ ] --[ Made( 'ok' ), Restr_P_LHS_1( $a ) ]-> [ Out( 'ok' ) ]
 right
  rule (modulo E) P:
     [ ] --[ Made( 'ok' ) ]-> [ Out( 'ok' ) ]

lemma reachable [right]:
  exists-trace "∃ #i. Made( 'ok' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Made( 'ok' ) @ #i)"
*/
simplify
