rule (modulo E) Produce:
   [ ] --[ P( ) ]-> [ F( 'a' ) ]

rule (modulo E) Unreachable:
   [ F( x ) ] --[ A( x ) ]-> [ Out( 'ok' ) ]

restriction BanA [right]:
  "∀ x #i. (A( x ) @ #i) ⇒ (⊥)"
  // safety formula

