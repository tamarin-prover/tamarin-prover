lemma different_pair_fails:
  exists-trace "∃ #i. Else( <'a', 'b'>, 'c' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Else( <'a', 'b'>, 'c' ) @ #i)"
*/
simplify
solve( State_112( <'a', 'b'>, 'c' ) ▶₀ #i )
  case letxym_2_11
  SOLVED // trace found
qed

lemma matching_pair_succeeds:
  exists-trace "∃ #i. Then( 'a', 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Then( 'a', 'b' ) @ #i)"
*/
simplify
solve( State_111( m, 'a', 'b' ) ▶₀ #i )
  case letxym_1_11
  SOLVED // trace found
qed

lemma nonpair_fails:
  exists-trace "∃ #i. Else( 'a', 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Else( 'a', 'b' ) @ #i)"
*/
simplify
solve( State_112( 'a', 'b' ) ▶₀ #i )
  case letxym_2_11
  SOLVED // trace found
qed

lemma matching_pair_never_fails:
  all-traces "∀ a b #i. (Else( <a, b>, b ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ a b #i. (Else( <a, b>, b ) @ #i)"
*/
simplify
solve( State_112( <a, b>, b ) ▶₀ #i )
  case letxym_2_11
  by contradiction /* from formulas */
qed

lemma else_never_pair:
  all-traces "∀ a b y #i. (Else( <a, b>, y ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ a b y #i. (Else( <a, b>, y ) @ #i)"
*/
simplify
solve( State_112( <a, b>, y ) ▶₀ #i )
  case letxym_2_11
  SOLVED // trace found
qed

