theory SourcePremiseIndex

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

tactic: prem1
presort: S
prio: {id}
  regex"▶₁"
tactic: prem2
presort: S
prio: {id}
  regex"▶₂"

rule (modulo E) Create:
   [ Fr( ~x ) ] --[ Cr( ~x ) ]-> [ S( ~x ), !Permit( ~x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Twice:
   [ S( x ), S( x ) ] --[ Twice( x ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Three:
   [ S( x ), !Permit( x ), S( x ) ] --[ Three( x ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateTwo:
   [ Fr( ~x ) ] --> [ T( ~x ), T( ~x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ConsumeTwo:
   [ T( x ), T( x ) ] --[ ConsumedTwo( x ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma impossible_second_first [heuristic={prem1}]:
  all-traces "∀ x #i. (Twice( x ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Twice( x ) @ #i)"
*/
simplify
solve( S( x ) ▶₁ #i )
  case Create
  by solve( S( ~x ) ▶₀ #i )
qed

lemma impossible_default:
  all-traces "∀ x #i. (Twice( x ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Twice( x ) @ #i)"
*/
simplify
solve( S( x ) ▶₀ #i )
  case Create
  by solve( S( ~x ) ▶₁ #i )
qed

lemma no_witness_second_first [heuristic={prem1}]:
  exists-trace "∃ x #i. Twice( x ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (Twice( x ) @ #i)"
*/
simplify
solve( S( x ) ▶₁ #i )
  case Create
  by solve( S( ~x ) ▶₀ #i )
qed

lemma no_witness_default:
  exists-trace "∃ x #i. Twice( x ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (Twice( x ) @ #i)"
*/
simplify
solve( S( x ) ▶₀ #i )
  case Create
  by solve( S( ~x ) ▶₁ #i )
qed

lemma impossible_third_first [heuristic={prem2}]:
  all-traces "∀ x #i. (Three( x ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Three( x ) @ #i)"
*/
simplify
solve( S( x ) ▶₂ #i )
  case Create
  by solve( S( ~x ) ▶₀ #i )
qed

lemma no_witness_third_first [heuristic={prem2}]:
  exists-trace "∃ x #i. Three( x ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (Three( x ) @ #i)"
*/
simplify
solve( S( x ) ▶₂ #i )
  case Create
  by solve( S( ~x ) ▶₀ #i )
qed

lemma witness_second_first [heuristic={prem1}]:
  exists-trace "∃ x #i. ConsumedTwo( x ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (ConsumedTwo( x ) @ #i)"
*/
simplify
solve( T( x ) ▶₁ #i )
  case CreateTwo_case_1
  solve( T( ~x ) ▶₀ #i )
    case CreateTwo
    SOLVED // trace found
  qed
qed

lemma witness_default:
  exists-trace "∃ x #i. ConsumedTwo( x ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i. (ConsumedTwo( x ) @ #i)"
*/
simplify
solve( T( x ) ▶₀ #i )
  case CreateTwo_case_1
  solve( T( ~x ) ▶₁ #i )
    case CreateTwo
    SOLVED // trace found
  qed
qed

/* All wellformedness checks were successful. */

