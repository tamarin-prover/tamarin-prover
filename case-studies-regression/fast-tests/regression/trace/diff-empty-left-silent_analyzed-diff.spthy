theory EmptyLeftSilent

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Emit:
   [ Fr( ~n ), In( diff(~n, 'known') ) ] --[ Emitted( ) ]-> [ ]

lemma emitted [right]:
  exists-trace "∃ #i. Emitted( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Emitted( ) @ #i)"
*/
simplify
SOLVED // trace found

lemma not_emitted [left]:
  all-traces "∀ #i. (Emitted( ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Emitted( ) @ #i)"
*/
simplify
by solve( Emitted( ) @ #i )

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Emit
  backward-search
    case RHS
    step( simplify )
    step( solve( !KU( 'known' ) @ #vk ) )
      case pub
      by ATTACK // trace found
    qed
  qed
qed

/* All wellformedness checks were successful. */

