theory SoundnessSapicStateSupported

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma initial_value:
  all-traces "∀ v #i. (Before( v ) @ #i) ⇒ (v = '0')"
/*
guarded formula characterizing all counter-examples:
"∃ v #i. (Before( v ) @ #i) ∧ ¬(v = '0')"
*/
simplify
solve( State_111111111( StateChannel, lock, StateChannel.1, other, s, v
       ) ▶₀ #i )
  case lookupsasv_0_11111111_case_1
  by contradiction /* from formulas */
next
  case lookupsasv_0_11111111_case_2
  solve( State_111111111( StateChannel, lock, StateChannel.1, other, ~n.4,
                          v
         ) ▶₀ #vr.4 )
    case lookupsasv_0_11111111
    by contradiction /* cyclic */
  qed
next
  case lookupsasv_0_11111111_case_3
  solve( State_111111111( StateChannel, lock, StateChannel.1, other, ~n.4,
                          v.1
         ) ▶₀ #vr.14 )
    case lookupsasv_0_11111111
    by contradiction /* cyclic */
  qed
qed

lemma updated_value:
  all-traces "∀ w #i. (After( w ) @ #i) ⇒ (w = '1')"
/*
guarded formula characterizing all counter-examples:
"∃ w #i. (After( w ) @ #i) ∧ ¬(w = '1')"
*/
simplify
solve( State_11111111111111( StateChannel, lock, StateChannel.1, lock.1,
                             other, s, v, w
       ) ▶₀ #i )
  case lookupsasw_0_1111111111111
  solve( State_111111111( StateChannel, lock, StateChannel.1, other, s, v
         ) ▶₀ #vr.4 )
    case lookupsasv_0_11111111_case_1
    solve( L_PureState( ~n.5, w ) ▶₁ #vr )
      case inserts_0_1111111111
      by contradiction /* from formulas */
    next
      case insertsw_0_111111111111111
      solve( State_111111111( StateChannel, lock, StateChannel.1, other, ~n.5,
                              v
             ) ▶₀ #vr.21 )
        case lookupsasv_0_11111111
        by contradiction /* cyclic */
      qed
    qed
  next
    case lookupsasv_0_11111111_case_2
    solve( State_111111111( StateChannel, lock, StateChannel.1, other, ~n.5,
                            v
           ) ▶₀ #vr.9 )
      case lookupsasv_0_11111111
      by contradiction /* cyclic */
    qed
  next
    case lookupsasv_0_11111111_case_3
    solve( State_111111111( StateChannel, lock, StateChannel.1, other, ~n.5,
                            v.1
           ) ▶₀ #vr.19 )
      case lookupsasv_0_11111111
      by contradiction /* cyclic */
    qed
  qed
qed

lemma completed:
  exists-trace
  "∃ #i #j. ((Before( '0' ) @ #i) ∧ (After( '1' ) @ #j)) ∧ (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j. (Before( '0' ) @ #i) ∧ (After( '1' ) @ #j) ∧ #i < #j"
*/
simplify
solve( State_11111111111111( StateChannel.2, lock.1, StateChannel.3,
                             lock.2, other.1, s.1, v, '1'
       ) ▶₀ #j )
  case lookupsasw_0_1111111111111
  solve( State_111111111( StateChannel, lock, StateChannel.1, other, s, '0'
         ) ▶₀ #i )
    case lookupsasv_0_11111111_case_1
    solve( State_111111111( StateChannel, lock, StateChannel.1, other, s, v
           ) ▶₀ #vr.4 )
      case lookupsasv_0_11111111
      solve( L_PureState( ~n.4, '1' ) ▶₁ #vr )
        case inserts_0_1111111111
        solve( State_111111111( StateChannel, lock, StateChannel.1, other, ~n.4,
                                v
               ) ▶₀ #vr.15 )
          case lookupsasv_0_11111111
          solve( L_CellLocked( ~n.4, ~n.1 ) ▶₁ #vr.3 )
            case lookupsasv_0_11111111
            SOLVED // trace found
          qed
        qed
      qed
    qed
  qed
qed

