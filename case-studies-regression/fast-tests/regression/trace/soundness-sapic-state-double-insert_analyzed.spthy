theory SoundnessSapicStateDoubleInsert

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma done_reachable:
  exists-trace "∃ #i. Done( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Done( ) @ #i)"
*/
simplify
solve( State_11111111( StateChannel, lock, s, v ) ▶₀ #i )
  case unlocks_0_1111111
  solve( (#vr.5 < #t2)  ∥ (#vr.5 = #t2) )
    case case_2
    solve( Insert( ~n.2, v ) @ #t2 )
      case inserts_0_11
      SOLVED // trace found
    qed
  qed
qed

lemma no_done:
  all-traces "∀ #i. (Done( ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Done( ) @ #i)"
*/
simplify
solve( State_11111111( StateChannel, lock, s, v ) ▶₀ #i )
  case unlocks_0_1111111
  solve( (#vr.5 < #t2)  ∥ (#vr.5 = #t2) )
    case case_2
    solve( Insert( ~n.2, v ) @ #t2 )
      case inserts_0_11
      SOLVED // trace found
    qed
  qed
qed

lemma latest_value:
  all-traces "∀ w #i. (Value( w ) @ #i) ⇒ (w = '2')"
/*
guarded formula characterizing all counter-examples:
"∃ w #i. (Value( w ) @ #i) ∧ ¬(w = '2')"
*/
simplify
solve( State_11111111111( StateChannel, lock, lock.1, s, v, w ) ▶₀ #i )
  case lookupsasw_0_1111111111
  solve( (#t2 < #t2.1)  ∥ (#t2 = #t2.1)  ∥ (#vr.6 < #t2) )
    case case_1
    by contradiction /* from formulas */
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    solve( (#vr.4 < #t2)  ∥ (#vr.4 = #t2) )
      case case_1
      solve( (#vr.8 < #t2.1)  ∥ (#vr.8 = #t2.1) )
        case case_1
        solve( Insert( ~n.3, w ) @ #t2 )
          case inserts_0_11
          solve( State_11( StateChannel, ~n.3 ) ▶₀ #t2 )
            case newStateChannelchannel_0_1
            by contradiction /* cyclic */
          qed
        next
          case inserts_0_11111
          solve( State_11111( StateChannel, lock, ~n.3, v.1 ) ▶₀ #t2 )
            case lookupsasv_0_1111
            by contradiction /* cyclic */
          qed
        next
          case inserts_0_111111
          by contradiction /* from formulas */
        next
          case insertsw_0_111111111111
          by contradiction /* cyclic */
        qed
      next
        case case_2
        solve( Insert( ~n.3, w ) @ #t2.1 )
          case inserts_0_11
          solve( State_11( StateChannel, ~n.3 ) ▶₀ #t2.1 )
            case newStateChannelchannel_0_1
            by contradiction /* cyclic */
          qed
        next
          case inserts_0_11111
          solve( State_11111( StateChannel, lock, ~n.3, v.1 ) ▶₀ #t2.1 )
            case lookupsasv_0_1111
            by contradiction /* cyclic */
          qed
        next
          case inserts_0_111111
          by contradiction /* from formulas */
        next
          case insertsw_0_111111111111
          by contradiction /* cyclic */
        qed
      qed
    next
      case case_2
      solve( (#vr.7 < #t2.1)  ∥ (#vr.7 = #t2.1) )
        case case_1
        solve( Insert( ~n.3, w ) @ #t2 )
          case inserts_0_111111
          by contradiction /* from formulas */
        qed
      next
        case case_2
        solve( Insert( ~n.3, w ) @ #t2 )
          case inserts_0_111111
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
qed

lemma read_reachable:
  exists-trace "∃ #i. Value( '2' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Value( '2' ) @ #i)"
*/
simplify
solve( State_11111111111( StateChannel, lock, lock.1, s, v, '2' ) ▶₀ #i )
  case lookupsasw_0_1111111111
  solve( (#t2 < #t2.1)  ∥ (#t2 = #t2.1)  ∥ (#vr.6 < #t2) )
    case case_3
    solve( (#vr.4 < #t2)  ∥ (#vr.4 = #t2) )
      case case_2
      solve( (#vr.7 < #t2.1)  ∥ (#vr.7 = #t2.1) )
        case case_2
        solve( Insert( ~n.3, '2' ) @ #t2 )
          case inserts_0_111111
          solve( Insert( ~n.3, v ) @ #t2.1 )
            case inserts_0_11
            SOLVED // trace found
          qed
        qed
      qed
    qed
  qed
qed

