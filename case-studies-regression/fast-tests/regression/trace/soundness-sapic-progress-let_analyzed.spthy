theory SoundnessSapicProgressLet

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma recv_pair:
  all-traces "∀ x #i. (Recv( x ) @ #i) ⇒ (∃ a b. x = <a, b>)"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Recv( x ) @ #i) ∧ ∀ a b. (x = <a, b>) ⇒ ⊥"
*/
simplify
solve( State_1( ~prog_1, x ) ▶₀ #i )
  case inx_0_
  solve( (∃ #t. (ProgressTo_1111( ~prog_1 ) @ #t))  ∥
         (∃ #t. (ProgressTo_112( ~prog_1 ) @ #t)) )
    case case_2
    solve( Let_111( x.1, ~prog_1, x.1 ) ▶₀ #t.1 )
      case eventRecvx_0_1
      SOLVED // trace found
    qed
  qed
qed

lemma recv_nonpair:
  exists-trace "∃ #i. Recv( 'c' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Recv( 'c' ) @ #i)"
*/
simplify
solve( State_1( ~prog_1, 'c' ) ▶₀ #i )
  case inx_0_
  solve( (∃ #t. (ProgressTo_1111( ~prog_1 ) @ #t))  ∥
         (∃ #t. (ProgressTo_112( ~prog_1 ) @ #t)) )
    case case_2
    solve( Let_111( x, ~prog_1, x ) ▶₀ #t.1 )
      case eventRecvx_0_1
      SOLVED // trace found
    qed
  qed
qed

lemma matching_input:
  exists-trace "∃ #i. A( 'a', 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (A( 'a', 'b' ) @ #i)"
*/
simplify
solve( State_111( ~prog_1, 'a', 'b', x ) ▶₀ #i )
  case letabx_1_11
  solve( (∃ #t. (ProgressTo_1111( ~prog_1 ) @ #t))  ∥
         (∃ #t. (ProgressTo_112( ~prog_1 ) @ #t)) )
    case case_1
    solve( State_111( ~prog_1, a, b, x ) ▶₀ #t.1 )
      case letabx_1_11
      SOLVED // trace found
    qed
  qed
qed

lemma success_matches:
  all-traces
  "∀ a b #i. (A( a, b ) @ #i) ⇒ (∃ #j. (Recv( <a, b> ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ a b #i. (A( a, b ) @ #i) ∧ ∀ #j. (Recv( <a, b> ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( State_111( ~prog_1, a, b, x ) ▶₀ #i )
  case letabx_1_11
  by contradiction /* from formulas */
qed

rule (modulo E) Init[color=#ffffff, process="in(x.1);", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

