theory SoundnessSapicStateOverwrite

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma latest_value:
  all-traces "∀ v #i. (B( v ) @ #i) ⇒ (v = '1')"
/*
guarded formula characterizing all counter-examples:
"∃ v #i. (B( v ) @ #i) ∧ ¬(v = '1')"
*/
simplify
solve( State_111111( StateChannel, lock, s, v ) ▶₀ #i )
  case lookupsasv_0_11111
  solve( (#vr.2 < #t2)  ∥ (#vr.2 = #t2) )
    case case_1
    solve( Insert( ~n.2, v ) @ #t2 )
      case inserts_0_11
      solve( State_11( StateChannel, ~n.2 ) ▶₀ #t2 )
        case newStateChannelchannel_0_1
        by contradiction /* cyclic */
      qed
    next
      case inserts_0_111
      by contradiction /* from formulas */
    next
      case insertsv_0_1111111
      by contradiction /* cyclic */
    qed
  next
    case case_2
    solve( Insert( ~n.2, v ) @ #t2 )
      case inserts_0_111
      by contradiction /* from formulas */
    qed
  qed
qed

lemma read_reachable:
  exists-trace "∃ #i. B( '1' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (B( '1' ) @ #i)"
*/
simplify
solve( State_111111( StateChannel, lock, s, '1' ) ▶₀ #i )
  case lookupsasv_0_11111
  solve( (#vr.2 < #t2)  ∥ (#vr.2 = #t2) )
    case case_2
    solve( Insert( ~n.2, '1' ) @ #t2 )
      case inserts_0_111
      SOLVED // trace found
    qed
  qed
qed

lemma stale_unreachable:
  all-traces "∀ #i. (B( '0' ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (B( '0' ) @ #i)"
*/
simplify
solve( State_111111( StateChannel, lock, s, '0' ) ▶₀ #i )
  case lookupsasv_0_11111
  solve( (#vr.2 < #t2)  ∥ (#vr.2 = #t2) )
    case case_1
    solve( Insert( ~n.2, '0' ) @ #t2 )
      case inserts_0_11
      solve( State_11( StateChannel, ~n.2 ) ▶₀ #t2 )
        case newStateChannelchannel_0_1
        by contradiction /* cyclic */
      qed
    next
      case insertsv_0_1111111
      by contradiction /* cyclic */
    qed
  next
    case case_2
    by solve( Insert( ~n.2, '0' ) @ #t2 )
  qed
qed

rule (modulo E) Init[color=#ffffff, process="new s.1;", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) news_0_[color=#ffffff, process="new s.1;", issapicrule,
                        role='Process']:
   [ State_( ), Fr( s.1 ) ] --> [ State_1( s.1 ) ]

  /*
  rule (modulo AC) news_0_[color=#ffffff, process="new s.1;", issapicrule,
                           role='Process']:
     [ State_( ), Fr( s ) ] --> [ State_1( s ) ]
  */

rule (modulo E) newStateChannelchannel_0_1[color=#ffffff,
                                           process="new StateChannel:channel;", issapicrule, role='Process']:
   [ State_1( s.1 ), Fr( StateChannel ) ]
  -->
   [ State_11( StateChannel, s.1 ) ]

  /*
  rule (modulo AC) newStateChannelchannel_0_1[color=#ffffff,
                                              process="new StateChannel:channel;", issapicrule,
                                              role='Process']:
     [ State_1( s ), Fr( StateChannel ) ] --> [ State_11( StateChannel, s ) ]
  */

rule (modulo E) inserts_0_11[color=#ffffff, process="insert s.1,'0';",
                             issapicrule, role='Process']:
   [ State_11( StateChannel, s.1 ) ]
  --[ Insert( s.1, '0' ) ]->
   [ State_111( StateChannel, s.1 ) ]

  /*
  rule (modulo AC) inserts_0_11[color=#ffffff, process="insert s.1,'0';",
                                issapicrule, role='Process']:
     [ State_11( StateChannel, s ) ]
    --[ Insert( s, '0' ) ]->
     [ State_111( StateChannel, s ) ]
  */

rule (modulo E) inserts_0_111[color=#ffffff, process="insert s.1,'1';",
                              issapicrule, role='Process']:
   [ State_111( StateChannel, s.1 ) ]
  --[ Insert( s.1, '1' ) ]->
   [ State_1111( StateChannel, s.1 ) ]

  /*
  rule (modulo AC) inserts_0_111[color=#ffffff, process="insert s.1,'1';",
                                 issapicrule, role='Process']:
     [ State_111( StateChannel, s ) ]
    --[ Insert( s, '1' ) ]->
     [ State_1111( StateChannel, s ) ]
  */

rule (modulo E) locks_0_1111[color=#ffffff, process="lock s.1;",
                             issapicrule, role='Process']:
   [ State_1111( StateChannel, s.1 ), Fr( lock ) ]
  --[ Lock_0( '0', lock, s.1 ), Lock( '0', lock, s.1 ) ]->
   [ State_11111( StateChannel, lock, s.1 ) ]

  /*
  rule (modulo AC) locks_0_1111[color=#ffffff, process="lock s.1;",
                                issapicrule, role='Process']:
     [ State_1111( StateChannel, s ), Fr( lock ) ]
    --[ Lock_0( '0', lock, s ), Lock( '0', lock, s ) ]->
     [ State_11111( StateChannel, lock, s ) ]
  */

rule (modulo E) lookupsasv_0_11111[color=#ffffff,
                                   process="lookup s.1 as v.1", no_derivcheck, issapicrule, role='Process']:
   [ State_11111( StateChannel, lock, s.1 ) ]
  --[ IsIn( s.1, v.1 ) ]->
   [ State_111111( StateChannel, lock, s.1, v.1 ) ]

  /*
  rule (modulo AC) lookupsasv_0_11111[color=#ffffff,
                                      process="lookup s.1 as v.1", no_derivcheck, issapicrule,
                                      role='Process']:
     [ State_11111( StateChannel, lock, s ) ]
    --[ IsIn( s, v ) ]->
     [ State_111111( StateChannel, lock, s, v ) ]
  */

rule (modulo E) lookupsasv_1_11111[color=#ffffff,
                                   process="lookup s.1 as v.1", no_derivcheck, issapicrule, role='Process']:
   [ State_11111( StateChannel, lock, s.1 ) ]
  --[ IsNotSet( s.1 ) ]->
   [ State_111112( StateChannel, lock, s.1 ) ]

  /*
  rule (modulo AC) lookupsasv_1_11111[color=#ffffff,
                                      process="lookup s.1 as v.1", no_derivcheck, issapicrule,
                                      role='Process']:
     [ State_11111( StateChannel, lock, s ) ]
    --[ IsNotSet( s ) ]->
     [ State_111112( StateChannel, lock, s ) ]
  */

rule (modulo E) eventBv_0_111111[color=#ffffff,
                                 process="event B( v.1 );", issapicrule, role='Process']:
   [ State_111111( StateChannel, lock, s.1, v.1 ) ]
  --[ B( v.1 ) ]->
   [ State_1111111( StateChannel, lock, s.1, v.1 ) ]

  /*
  rule (modulo AC) eventBv_0_111111[color=#ffffff,
                                    process="event B( v.1 );", issapicrule, role='Process']:
     [ State_111111( StateChannel, lock, s, v ) ]
    --[ B( v ) ]->
     [ State_1111111( StateChannel, lock, s, v ) ]
  */

rule (modulo E) insertsv_0_1111111[color=#ffffff,
                                   process="insert s.1,v.1;", issapicrule, role='Process']:
   [ State_1111111( StateChannel, lock, s.1, v.1 ) ]
  --[ Insert( s.1, v.1 ) ]->
   [ State_11111111( StateChannel, lock, s.1, v.1 ) ]

  /*
  rule (modulo AC) insertsv_0_1111111[color=#ffffff,
                                      process="insert s.1,v.1;", issapicrule, role='Process']:
     [ State_1111111( StateChannel, lock, s, v ) ]
    --[ Insert( s, v ) ]->
     [ State_11111111( StateChannel, lock, s, v ) ]
  */

rule (modulo E) unlocks_0_11111111[color=#ffffff, process="unlock s.1;",
                                   issapicrule, role='Process']:
   [ State_11111111( StateChannel, lock, s.1, v.1 ) ]
  --[ Unlock_0( '0', lock, s.1 ), Unlock( '0', lock, s.1 ) ]->
   [ State_111111111( StateChannel, lock, s.1, v.1 ) ]

  /*
  rule (modulo AC) unlocks_0_11111111[color=#ffffff, process="unlock s.1;",
                                      issapicrule, role='Process']:
     [ State_11111111( StateChannel, lock, s, v ) ]
    --[ Unlock_0( '0', lock, s ), Unlock( '0', lock, s ) ]->
     [ State_111111111( StateChannel, lock, s, v ) ]
  */

rule (modulo E) p_0_111111111[color=#ffffff, process="0", issapicrule,
                              role='Process']:
   [ State_111111111( StateChannel, lock, s.1, v.1 ) ] --> [ ]

  /*
  rule (modulo AC) p_0_111111111[color=#ffffff, process="0", issapicrule,
                                 role='Process']:
     [ State_111111111( StateChannel, lock, s, v ) ] --> [ ]
  */

rule (modulo E) p_0_111112[color=#ffffff, process="0", issapicrule,
                           role='Process']:
   [ State_111112( StateChannel, lock, s.1 ) ] --> [ ]

  /*
  rule (modulo AC) p_0_111112[color=#ffffff, process="0", issapicrule,
                              role='Process']:
     [ State_111112( StateChannel, lock, s ) ] --> [ ]
  */

restriction set_in:
  "∀ x y #t3.
    (IsIn( x, y ) @ #t3) ⇒
    (∃ #t2.
      ((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ∧
      (∀ #t1 yp.
        (Insert( x, yp ) @ #t1) ⇒ (((#t1 < #t2) ∨ (#t1 = #t2)) ∨ (#t3 < #t1))))"

  /*
  expanded formula:
  "∀ x y #t3.
    (IsIn( x, y ) @ #t3) ⇒
    (∃ #t2.
      ((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ∧
      (∀ #t1 yp.
        (Insert( x, yp ) @ #t1) ⇒ (((#t1 < #t2) ∨ (#t1 = #t2)) ∨ (#t3 < #t1))))"
  */

restriction set_notin:
  "∀ x #t3.
    (IsNotSet( x ) @ #t3) ⇒ (∀ #t1 y. (Insert( x, y ) @ #t1) ⇒ (#t3 < #t1))"
  // safety formula

  /*
  expanded formula:
  "∀ x #t3.
    (IsNotSet( x ) @ #t3) ⇒ (∀ #t1 y. (Insert( x, y ) @ #t1) ⇒ (#t3 < #t1))"
  */

restriction single_session:
  "∀ #i #j. ((Init( ) @ #i) ∧ (Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((Init( ) @ #i) ∧ (Init( ) @ #j)) ⇒ (#i = #j)"
  */

restriction locking_0:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_0( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_0( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

  /*
  expanded formula:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_0( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_0( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"
  */

