rule (modulo E) inx_0_121[color=#724080, process="in(x.2);", issapicrule,
                          role='Success']:
   [ Fr( ~prog_1211 ), State_121( ~prog_ ), In( x.2 ) ]
  --[ ProgressFrom_1211( ~prog_1211 ) ]->
