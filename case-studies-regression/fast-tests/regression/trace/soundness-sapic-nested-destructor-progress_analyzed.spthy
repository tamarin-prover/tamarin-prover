theory SoundnessSapicNestedDestructorProgress

begin

// Function signature and definition of the equational theory E

functions: c/1, d/1 [destructor], fst/1, pair/2, snd/1
equations: d(c(x)) = x, fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma failure_reachable:
  exists-trace "∃ #i. Started( 'failure' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Started( 'failure' ) @ #i)"
*/
simplify
solve( State_11( ~prog_ ) ▶₀ #t.1 )
  case Init
  solve( State_12( ~prog_ ) ▶₀ #t.2 )
    case Init
    solve( State_2( ~prog_ ) ▶₀ #t.3 )
      case Init
      solve( Started( 'failure' ) @ #i )
        case eventStartedfailure_0_1111
        solve( State_1111( ~prog_, ~prog_1111, x ) ▶₀ #i )
          case inx_0_111
          solve( State_11( ~prog_ ) ▶₀ #t.4 )
            case Init
            solve( State_12( ~prog_ ) ▶₀ #t.4 )
              case Init
              solve( State_2( ~prog_ ) ▶₀ #t.4 )
                case Init
                solve( (∃ #t. (ProgressTo_1111111( ~prog_1111 ) @ #t))  ∥
                       (∃ #t. (ProgressTo_1111121( ~prog_1111 ) @ #t)) )
                  case case_2
                  solve( State_111112( ~prog_.1, ~prog_1111, x.1 ) ▶₀ #t.4 )
                    case letydxdbad_2_11111
                    solve( State_11( ~prog_ ) ▶₀ #t.5 )
                      case Init
                      solve( State_12( ~prog_ ) ▶₀ #t.5 )
                        case Init
                        solve( State_2( ~prog_ ) ▶₀ #t.5 )
                          case Init
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma failure_progress:
  all-traces
  "∀ #i.
    (Started( 'failure' ) @ #i) ⇒
    (∃ #j. (Finished( 'failure' ) @ #j) ∧ (#i < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ #i.
  (Started( 'failure' ) @ #i)
 ∧
  ∀ #j. (Finished( 'failure' ) @ #j) ⇒ ¬(#i < #j)"
*/
simplify
solve( State_11( ~prog_ ) ▶₀ #t.1 )
  case Init
  solve( State_12( ~prog_ ) ▶₀ #t.2 )
    case Init
    solve( State_2( ~prog_ ) ▶₀ #t.3 )
      case Init
      solve( Started( 'failure' ) @ #i )
        case eventStartedfailure_0_1111
        solve( State_1111( ~prog_, ~prog_1111, x ) ▶₀ #i )
          case inx_0_111
          solve( State_11( ~prog_ ) ▶₀ #t.4 )
            case Init
            solve( State_12( ~prog_ ) ▶₀ #t.4 )
              case Init
              solve( State_2( ~prog_ ) ▶₀ #t.4 )
                case Init
                solve( (∃ #t. (ProgressTo_1111111( ~prog_1111 ) @ #t))  ∥
                       (∃ #t. (ProgressTo_1111121( ~prog_1111 ) @ #t)) )
                  case case_1
                  by solve( State_111111( ~prog_.1, ~prog_1111, x.1, y ) ▶₀ #t.4 )
                next
                  case case_2
                  by contradiction /* cyclic */
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

