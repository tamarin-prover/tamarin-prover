                          role='Failure']:
   [ Fr( ~prog_1111 ), State_111( ~prog_ ), In( x.1 ) ]
  --[ ProgressFrom_1111( ~prog_1111 ) ]->
   [ State_1111( ~prog_, ~prog_1111, x.1 ) ]

  /*
