lemma success_progress:
  all-traces
  "∀ #i.
    (Started( 'success' ) @ #i) ⇒
    (∃ x y #j. (Result( x, y ) @ #j) ∧ (#i < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ #i.
  (Started( 'success' ) @ #i)
 ∧
  ∀ x y #j. (Result( x, y ) @ #j) ⇒ ¬(#i < #j)"
*/
simplify
solve( State_11( ~prog_ ) ▶₀ #t.1 )
  case Init
  solve( State_12( ~prog_ ) ▶₀ #t.2 )
    case Init
    solve( State_2( ~prog_ ) ▶₀ #t.3 )
      case Init
      solve( Started( 'success' ) @ #i )
        case eventStartedsuccess_0_1211
        solve( State_1211( ~prog_, ~prog_1211, x ) ▶₀ #i )
          case inx_0_121
          solve( State_11( ~prog_ ) ▶₀ #t.4 )
            case Init
            solve( State_12( ~prog_ ) ▶₀ #t.4 )
              case Init
              solve( State_2( ~prog_ ) ▶₀ #t.4 )
                case Init
                solve( (∃ #t. (ProgressTo_1211111( ~prog_1211 ) @ #t))  ∥
                       (∃ #t. (ProgressTo_1211121( ~prog_1211 ) @ #t)) )
                  case case_1
                  by contradiction /* cyclic */
                next
                  case case_2
                  by solve( State_121112( ~prog_.1, ~prog_1211, x.1 ) ▶₀ #t.4 )
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma result_preserved:
  all-traces "∀ x y #i. (Result( x, y ) @ #i) ⇒ (y = <x, 'b'>)"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i. (Result( x, y ) @ #i) ∧ ¬(y = <x, 'b'>)"
*/
simplify
solve( State_121111( ~prog_, ~prog_1211, x, y ) ▶₀ #i )
  case letydcxdcb_9_12111
  by contradiction /* from formulas */
qed

lemma omitted_reachable:
  exists-trace "∃ #i. Omitted( c('a') ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Omitted( c('a') ) @ #i)"
*/
simplify
solve( State_211( ~prog_, ~prog_211, c('a') ) ▶₀ #i )
  case inx_0_21
  solve( State_11( ~prog_ ) ▶₀ #t.1 )
    case Init
    solve( State_12( ~prog_ ) ▶₀ #t.2 )
      case Init
      solve( State_2( ~prog_ ) ▶₀ #t.3 )
        case Init
        solve( State_11( ~prog_ ) ▶₀ #t.3 )
          case Init
          solve( State_12( ~prog_ ) ▶₀ #t.3 )
            case Init
            solve( State_2( ~prog_ ) ▶₀ #t.3 )
              case Init
              solve( (∃ #t. (ProgressTo_211111( ~prog_211 ) @ #t))  ∥
                     (∃ #t. (ProgressTo_21112( ~prog_211 ) @ #t)) )
                case case_2
                solve( ProgressTo_21112( ~prog_211 ) @ #t.3 )
                  case letydxdbad_6_2111
                  solve( Let_211102( 'bad', ~prog_.1, ~prog_211, x, destructor ) ▶₀ #t.3 )
                    case letydxdbad_3_2111
                    solve( State_11( ~prog_ ) ▶₀ #t.4 )
                      case Init
                      solve( State_12( ~prog_ ) ▶₀ #t.4 )
                        case Init
                        solve( State_2( ~prog_ ) ▶₀ #t.4 )
                          case Init
                          solve( !KU( c('a') ) @ #vk )
                            case c_c
                            SOLVED // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma no_wrong:
  all-traces "∀ #i. (Wrong( ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Wrong( ) @ #i)"
*/
simplify
solve( State_11( ~prog_ ) ▶₀ #t.1 )
  case Init
  solve( State_12( ~prog_ ) ▶₀ #t.2 )
    case Init
    solve( State_2( ~prog_ ) ▶₀ #t.3 )
      case Init
      solve( Wrong( ) @ #i )
        case eventWrong_0_111111
        by solve( State_111111( ~prog_, ~prog_1111, x, y ) ▶₀ #i )
      next
        case eventWrong_0_121112
        by solve( State_121112( ~prog_, ~prog_1211, x ) ▶₀ #i )
      next
        case eventWrong_0_21111
        by solve( State_21111( ~prog_, ~prog_211, x, y ) ▶₀ #i )
      qed
    qed
  qed
qed

