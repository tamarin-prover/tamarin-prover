theory SoundnessSapicStateParallelBoundaries

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1, value/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma shared_reachable:
  exists-trace "∃ #i. Shared( value ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Shared( value ) @ #i)"
*/
simplify
solve( State_1111211( StateChannel, lock, s, value ) ▶₀ #i )
  case lookupsasv_0_111121
  solve( Insert( ~n.2, value ) @ #t2 )
    case insertsvalue_0_11111
    solve( State_11111( StateChannel, ~n.2 ) ▶₀ #t2 )
      case p_0_1111
      SOLVED // trace found
    qed
  qed
qed

lemma repeated_reachable:
  exists-trace "∃ #i. Repeated( value ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Repeated( value ) @ #i)"
*/
simplify
solve( State_211111111( StateChannel, lock, s, value ) ▶₀ #i )
  case lookupsasv_0_21111111
  solve( (#vr.2 < #t2)  ∥ (#vr.2 = #t2) )
    case case_1
    solve( Insert( ~n.2, value ) @ #t2 )
      case insertsvalue_0_211111
      solve( State_211111( StateChannel, ~n.2 ) ▶₀ #t2 )
        case p_1_21111
        SOLVED // trace found
      qed
    qed
  qed
qed

rule (modulo E) Init[color=#ffffff, process="|", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) p_0_[color=#ffffff, process="|", issapicrule,
                     role='Process']:
   [ State_( ) ] --> [ State_1( ), State_2( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Shared_0_1[color=#ffffff, process="Shared();",
                           issapicrule, role='Process']:
   [ State_1( ) ] --> [ State_11( ) ]

  /* has exactly the trivial AC variant */

