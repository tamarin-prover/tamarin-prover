theory SoundnessSapicProcessCallCapture

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma typed_distinct:
  exists-trace "∃ #i. Typed( 'a', 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Typed( 'a', 'b' ) @ #i)"
*/
simplify
solve( State_1111111111111111( 'a', 'b' ) ▶₀ #i )
  case inybitstring_0_111111111111111
  SOLVED // trace found
qed

