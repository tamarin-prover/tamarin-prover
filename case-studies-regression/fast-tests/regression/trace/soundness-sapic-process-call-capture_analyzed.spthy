lemma typed_argument_preserved:
  all-traces
  "∀ x y #i.
    (Typed( x, y ) @ #i) ⇒ (∃ #j. (TypedArgument( x ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i.
  (Typed( x, y ) @ #i) ∧ ∀ #j. (TypedArgument( x ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( State_1111111111111111( x, y ) ▶₀ #i )
  case inybitstring_0_111111111111111
  by contradiction /* from formulas */
qed

lemma compound_argument_preserved:
  all-traces
  "∀ x y z #i.
    (Pattern( x, y, z ) @ #i) ⇒
    (∃ a #j. ((PatternArgument( a ) @ #j) ∧ (x = <'tag', a>)) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ x y z #i.
  (Pattern( x, y, z ) @ #i)
 ∧
  ∀ a #j. (PatternArgument( a ) @ #j) ∧ (x = <'tag', a>) ⇒ ¬(#j < #i)"
*/
simplify
solve( State_111111111121111( z, y, y.1 ) ▶₀ #i )
  case inybitstringzbitstring_0_11111111112111
  by contradiction /* from formulas */
qed

