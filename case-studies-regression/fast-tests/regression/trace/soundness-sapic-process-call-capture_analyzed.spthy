lemma lookup_argument:
  exists-trace "∃ #i. Read( 'a', 'b' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Read( 'a', 'b' ) @ #i)"
*/
simplify
solve( Read( 'a', 'b' ) @ #i )
  case eventReadyybitstring_0_111111211111
  solve( State_111111211111( s, 'a', 'b' ) ▶₀ #i )
    case lookupsasybitstring_0_11111121111
    solve( (#vr.3 < #t2)  ∥ (#vr.3 = #t2) )
      case case_2
      solve( Insert( ~n, 'b' ) @ #t2 )
        case insertsb_0_11111121
        SOLVED // trace found
      qed
    qed
  qed
qed

