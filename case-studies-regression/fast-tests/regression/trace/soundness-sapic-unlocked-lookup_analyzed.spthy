  */

rule (modulo E) lookupsasw_1_111[color=#ffffff,
                                 process="lookup s.1 as w.1", no_derivcheck, issapicrule, role='Process']:
   [ State_111( StateChannel, s.1 ) ]
  --[ IsNotSet( s.1 ) ]->
   [ State_1112( StateChannel, s.1 ) ]

  /*
  rule (modulo AC) lookupsasw_1_111[color=#ffffff,
                                    process="lookup s.1 as w.1", no_derivcheck, issapicrule, role='Process']:
     [ State_111( StateChannel, s ) ]
    --[ IsNotSet( s ) ]->
     [ State_1112( StateChannel, s ) ]
  */

rule (modulo E) eventBw_0_1111[color=#ffffff, process="event B( w.1 );",
                               issapicrule, role='Process']:
   [ State_1111( StateChannel, s.1, w.1 ) ]
  --[ B( w.1 ) ]->
   [ State_11111( StateChannel, s.1, w.1 ) ]

  /*
  rule (modulo AC) eventBw_0_1111[color=#ffffff, process="event B( w.1 );",
