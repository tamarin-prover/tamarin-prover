    --[ NB( ) ]->
     [ State_11121( StateChannel, s ) ]
  */

rule (modulo E) p_0_11121[color=#ffffff, process="0", issapicrule,
                          role='Process']:
   [ State_11121( StateChannel, s.1 ) ] --> [ ]

  /*
  rule (modulo AC) p_0_11121[color=#ffffff, process="0", issapicrule,
                             role='Process']:
     [ State_11121( StateChannel, s ) ] --> [ ]
