theory SoundnessSapicChannelPattern

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma injection:
  exists-trace "∃ #i. Recv( 'adv' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Recv( 'adv' ) @ #i)"
*/
simplify
solve( State_11121( c, x, 'adv', z ) ▶₀ #i )
  case incy_1_1112
  solve( !KU( ~n ) @ #vk.1 )
    case outx_0_11
    SOLVED // trace found
  qed
qed

lemma only_ok:
  all-traces "∀ y #i. (Recv( y ) @ #i) ⇒ (y = 'ok')"
/*
guarded formula characterizing all counter-examples:
"∃ y #i. (Recv( y ) @ #i) ∧ ¬(y = 'ok')"
*/
simplify
solve( State_11121( c, x, y, z ) ▶₀ #i )
  case incy_1_1112_case_2
  solve( !KU( ~n ) @ #vk.1 )
    case outx_0_11
    SOLVED // trace found
  qed
qed

rule (modulo E) Init[color=#ffffff, process="new c.1;", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

