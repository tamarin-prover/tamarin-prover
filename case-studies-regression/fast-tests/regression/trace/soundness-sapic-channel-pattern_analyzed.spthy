     [ Let_11( <x, z>, c ) ] --> [ State_11( c, x, z ) ]
  */

rule (modulo E) outx_0_11[color=#ffffff, process="out(x.1);",
                          issapicrule, role='Process']:
   [ State_11( c.1, x.1, z.1 ) ]
  -->
   [ State_111( c.1, x.1, z.1 ), Out( x.1 ) ]

  /*
