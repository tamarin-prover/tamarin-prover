theory DiffDisequalityAttack

begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Produce:
   [ In( u ), In( v ) ] --> [ F( (u++v) ) ]

rule (modulo E) Consume:
   [ F( (x++y) ) ] --[ Choice( x, y ) ]-> [ Out( x ) ]

restriction Same [right]:
  "∀ a b #i. (Choice( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

  /*
  expanded formula:
  "∀ a b #i. (Choice( a, b ) @ #i) ⇒ (a = b)"
  */

diffLemma Observational_equivalence:
rule-equivalence
  case Rule_Consume
  backward-search
    case LHS
    step( simplify )
    step( solve( F( (x++y) ) ▶₀ #i ) )
      case Produce_case_1
      by ATTACK // trace found
    qed
  qed
qed

/* All wellformedness checks were successful. */

