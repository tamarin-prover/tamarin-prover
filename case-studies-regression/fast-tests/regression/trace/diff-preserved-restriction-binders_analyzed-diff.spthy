theory DiffPreservedRestrictionBinders

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) A:
   [ ] --[ A( ) ]-> [ ]

restriction Left [left]:
  "∀ #i #j. ((A( ) @ #i) ∧ (A( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((A( ) @ #i) ∧ (A( ) @ #j)) ⇒ (#i = #j)"
  */

restriction Right [right]:
  "∀ #k #l. ((A( ) @ #k) ∧ (A( ) @ #l)) ⇒ (#k = #l)"
  // safety formula

  /*
  expanded formula:
  "∀ #k #l. ((A( ) @ #k) ∧ (A( ) @ #l)) ⇒ (#k = #l)"
  */

diffLemma D:
rule-equivalence
  case Rule_A
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
next
  case Rule_Destrd_0_fst
