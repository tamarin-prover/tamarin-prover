  next
    case RHS
    step( simplify )
    by step( solve( !KD( <x, x.1> ) ▶₀ #i ) )
  qed
next
  case Rule_Equality
  backward-search
    case LHS
    step( simplify )
    by step( solve( !KD( x ) ▶₁ #i ) )
  next
    case RHS
    step( simplify )
    by step( solve( !KD( x ) ▶₁ #i ) )
  qed
next
  case Rule_Send
  backward-search
    case LHS
    step( simplify )
    MIRRORED
  next
    case RHS
    step( simplify )
    MIRRORED
  qed
qed

