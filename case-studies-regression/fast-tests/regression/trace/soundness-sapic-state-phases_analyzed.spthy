theory SoundnessSapicStatePhases

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma left_branch:
  exists-trace "∃ #i. Branch( 'left', 'left' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Branch( 'left', 'left' ) @ #i)"
*/
simplify
solve( Branch( 'left', 'left' ) @ #i )
  case eventBranchleftv_0_1111111111
  solve( State_1111111111( StateChannel, lock, choice, s, 'left' ) ▶₀ #i )
    case lookupsasv_0_111111111
    SOLVED // trace found
  qed
qed

lemma right_branch:
  exists-trace "∃ #i. Branch( 'right', 'right' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Branch( 'right', 'right' ) @ #i)"
*/
simplify
solve( Branch( 'right', 'right' ) @ #i )
  case eventBranchrightv_0_1111112111
  solve( State_1111112111( StateChannel, choice, lock, s, 'right' ) ▶₀ #i )
    case lookupsasv_0_111111211
    SOLVED // trace found
  qed
qed

lemma branch_value:
  all-traces "∀ label v #i. (Branch( label, v ) @ #i) ⇒ (label = v)"
/*
guarded formula characterizing all counter-examples:
"∃ label v #i. (Branch( label, v ) @ #i) ∧ ¬(label = v)"
*/
simplify
solve( Branch( label, v ) @ #i )
  case eventBranchleftv_0_1111111111
  solve( State_1111111111( StateChannel, lock, choice, s, v ) ▶₀ #i )
    case lookupsasv_0_111111111
    by contradiction /* from formulas */
  qed
next
  case eventBranchrightv_0_1111112111
  solve( State_1111112111( StateChannel, choice, lock, s, v ) ▶₀ #i )
    case lookupsasv_0_111111211
    by contradiction /* from formulas */
  qed
qed

lemma parallel_completed:
  exists-trace
  "∃ #i #j.
    (Parallel( 'left', 'value' ) @ #i) ∧ (Parallel( 'right', 'value' ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j.
  (Parallel( 'left', 'value' ) @ #i) ∧ (Parallel( 'right', 'value' ) @ #j)"
*/
simplify
solve( Parallel( 'left', 'value' ) @ #i )
  case eventParallelleftv_0_121111111
  solve( State_121111111( StateChannel, lock, s, 'value' ) ▶₀ #i )
    case lookupsasv_0_12111111
    solve( Parallel( 'right', 'value' ) @ #j )
      case eventParallelrightv_0_121111211
      solve( State_121111211( StateChannel, s, lock, 'value' ) ▶₀ #j )
        case lookupsasv_0_12111121
        solve( L_PureState( ~n.2, 'value' ) ▶₁ #vr )
          case insertsv_0_1211112111
          solve( L_PureState( ~n.2, 'value' ) ▶₁ #vr.10 )
            case insertsvalue_0_12111
            solve( L_CellLocked( ~n.2, ~n.3 ) ▶₁ #vr.12 )
              case lookupsasv_0_12111121
              SOLVED // trace found
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma parallel_value:
  all-traces "∀ label v #i. (Parallel( label, v ) @ #i) ⇒ (v = 'value')"
/*
guarded formula characterizing all counter-examples:
"∃ label v #i. (Parallel( label, v ) @ #i) ∧ ¬(v = 'value')"
*/
simplify
solve( Parallel( label, v ) @ #i )
  case eventParallelleftv_0_121111111
  solve( State_121111111( StateChannel, lock, s, v ) ▶₀ #i )
    case lookupsasv_0_12111111
    solve( L_PureState( ~n.2, v ) ▶₁ #vr )
      case insertsv_0_1211111111
      by contradiction /* cyclic */
    next
      case insertsv_0_1211112111
      solve( L_CellLocked( ~n.2, ~n.3 ) ▶₁ #vr.10 )
        case lookupsasv_0_12111121
        solve( L_PureState( ~n.2, v ) ▶₁ #vr.12 )
          case insertsv_0_1211111111
          by contradiction /* cyclic */
        next
          case insertsvalue_0_12111
          by contradiction /* from formulas */
        qed
      qed
    next
      case insertsvalue_0_12111
      by contradiction /* from formulas */
    qed
  qed
next
  case eventParallelrightv_0_121111211
  solve( State_121111211( StateChannel, s, lock, v ) ▶₀ #i )
    case lookupsasv_0_12111121
    solve( L_PureState( ~n.1, v ) ▶₁ #vr )
      case insertsv_0_1211111111
      solve( L_CellLocked( ~n.1, ~n.3 ) ▶₁ #vr.10 )
        case lookupsasv_0_12111111
        solve( L_PureState( ~n.1, v ) ▶₁ #vr.12 )
          case insertsv_0_1211112111
          by contradiction /* cyclic */
        next
          case insertsvalue_0_12111
          by contradiction /* from formulas */
        qed
      qed
    next
      case insertsv_0_1211112111
      by contradiction /* cyclic */
    next
      case insertsvalue_0_12111
      by contradiction /* from formulas */
    qed
  qed
qed

lemma stopped_reachable:
  exists-trace "∃ #i. Stopped( 'value' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Stopped( 'value' ) @ #i)"
*/
simplify
solve( State_2111111( StateChannel, s, lock, 'value' ) ▶₀ #i )
  case lookupsasv_0_211111
  SOLVED // trace found
qed

lemma stopped_value:
  all-traces "∀ v #i. (Stopped( v ) @ #i) ⇒ (v = 'value')"
/*
guarded formula characterizing all counter-examples:
"∃ v #i. (Stopped( v ) @ #i) ∧ ¬(v = 'value')"
*/
simplify
solve( State_2111111( StateChannel, s, lock, v ) ▶₀ #i )
  case lookupsasv_0_211111
  by contradiction /* from formulas */
qed

rule (modulo E) Init[color=#ffffff, process="|", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) p_0_[color=#ffffff, process="|", issapicrule,
                     role='Process']:
   [ State_( ) ] --> [ State_1( ), State_2( ) ]

  /* has exactly the trivial AC variant */

