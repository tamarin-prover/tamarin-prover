theory SoundnessSapicDestructorPatterns

begin

// Function signature and definition of the equational theory E

functions: absent/1 [destructor], alt/1, c/1, d/3 [destructor], fst/1,
           guard/0, overlap/2 [destructor], pair/2, snd/1, unused/1 [destructor]
equations:
    d(alt(x), <guard, y, y>, x) = x,
    d(c(x), <guard, y, y>, x) = x,
    fst(<x.1, x.2>) = x.1,
    overlap(c(x), y) = x,
    overlap(c(x), guard) = x,
    snd(<x.1, x.2>) = x.2,
    unused(c(x)) = c(x)

heuristic: p

lemma first_reachable:
  exists-trace "∃ #i. Result( 'First', 'ok' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Result( 'First', 'ok' ) @ #i)"
*/
simplify
solve( Result( 'First', 'ok' ) @ #i )
  case eventResultFirstxbitstring_0_111111111111
  solve( State_111111111111( 'ok' ) ▶₀ #i )
    case lettagxbitstringdctagokguardaatagok_4_11111111111
    SOLVED // trace found
  qed
qed

lemma first_no_failure:
  all-traces "∀ #i. (Failure( 'First' ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Failure( 'First' ) @ #i)"
*/
simplify
solve( Failure( 'First' ) @ #i )
  case eventFailureFirst_0_111111111112
  by solve( State_111111111112( ) ▶₀ #i )
qed

