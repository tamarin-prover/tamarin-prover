lemma correct_results:
  all-traces "∀ label x #i. (Result( label, x ) @ #i) ⇒ (x = 'ok')"
/*
guarded formula characterizing all counter-examples:
"∃ label x #i. (Result( label, x ) @ #i) ∧ ¬(x = 'ok')"
*/
simplify
solve( Result( label, x ) @ #i )
  case eventResultAuxiliaryxbitstring_0_1111111211
  by solve( State_1111111211( x ) ▶₀ #i )
next
  case eventResultConstantxbitstring_0_11111111211
  by solve( State_11111111211( x ) ▶₀ #i )
next
  case eventResultFirstxbitstring_0_111111111111
  solve( State_111111111111( x ) ▶₀ #i )
    case lettagxbitstringdctagokguardaatagok_4_11111111111
    by contradiction /* from formulas */
  qed
next
  case eventResultOutputxbitstring_0_111111211
  by solve( State_111111211( x ) ▶₀ #i )
next
  case eventResultOverlapxbitstring_0_1111211
  solve( State_1111211( x ) ▶₀ #i )
    case lettagxbitstringoverlapctagokguard_4_111121_case_1
    by contradiction /* from formulas */
  next
    case lettagxbitstringoverlapctagokguard_4_111121_case_2
    by contradiction /* from formulas */
  qed
next
  case eventResultPatternxbitstring_0_11111211
  by solve( State_11111211( x ) ▶₀ #i )
next
  case eventResultSecondxbitstring_0_111111111211
  solve( State_111111111211( x ) ▶₀ #i )
    case lettagxbitstringdalttagokguardaatagok_4_11111111121
    by contradiction /* from formulas */
  qed
qed

