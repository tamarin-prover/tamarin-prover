theory SoundnessSapicNestedDestructorFailureChain

begin

// Function signature and definition of the equational theory E

functions: c/1, d/1 [destructor], fst/1, pair/2, snd/1
equations: d(c(x)) = x, fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma finished:
  exists-trace "∃ #i. Finished( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Finished( ) @ #i)"
*/
simplify
solve( State_22222222( ) ▶₀ #i )
  case lettagxtagdbad_2_2222222
  SOLVED // trace found
qed

lemma no_success:
  all-traces "∀ #i. (Success( ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Success( ) @ #i)"
*/
simplify
solve( Success( ) @ #i )
  case eventSuccess_0_1
  by solve( State_1( x7 ) ▶₀ #i )
next
  case eventSuccess_0_21
  by solve( State_21( x6 ) ▶₀ #i )
next
  case eventSuccess_0_221
  by solve( State_221( x5 ) ▶₀ #i )
next
  case eventSuccess_0_2221
  by solve( State_2221( x4 ) ▶₀ #i )
next
  case eventSuccess_0_22221
  by solve( State_22221( x3 ) ▶₀ #i )
next
  case eventSuccess_0_222221
  by solve( State_222221( x2 ) ▶₀ #i )
next
  case eventSuccess_0_2222221
  by solve( State_2222221( x1 ) ▶₀ #i )
next
  case eventSuccess_0_22222221
  by solve( State_22222221( x0 ) ▶₀ #i )
qed

