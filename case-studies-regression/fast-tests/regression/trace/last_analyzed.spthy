  "∀ #i. (P( ) @ #i) ⇒ (last(#i))"
  */

lemma IllegalL:
  all-traces "∀ #i. (P( ) @ #i) ⇒ (last(#i))"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (P( ) @ #i) ∧ ¬(last(#i))"
