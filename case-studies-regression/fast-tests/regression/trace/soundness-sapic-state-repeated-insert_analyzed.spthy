theory SoundnessSapicStateRepeatedInsert

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma successive_values:
  exists-trace "∃ #i #j. ((B( 'a' ) @ #i) ∧ (B( 'b' ) @ #j)) ∧ (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j. (B( 'a' ) @ #i) ∧ (B( 'b' ) @ #j) ∧ #i < #j"
*/
simplify
solve( State_1112111( StateChannel, lock, s, 'a' ) ▶₀ #i )
  case lookupsasv_0_111211
  solve( State_1112111( StateChannel, lock, s, 'b' ) ▶₀ #j )
    case lookupsasv_0_111211
    solve( ((#vr.1 < #vr.11) ∧
            (∃ #t2.
              (Unlock_0( '0', ~n.1, ~n.2 ) @ #t2)
             ∧
              (#vr.1 < #t2) ∧
              (#t2 < #vr.11) ∧
              (∀ #t0 pp. (Unlock( pp, ~n.1, ~n.2 ) @ #t0) ⇒ #t0 = #t2) ∧
              (∀ pp lpp #t0.
                (Lock( pp, lpp, ~n.2 ) @ #t0)
               ⇒
                ((#t0 < #vr.1) ∨ (#t0 = #vr.1) ∨ (#t2 < #t0))) ∧
              (∀ pp lpp #t0.
                (Unlock( pp, lpp, ~n.2 ) @ #t0)
               ⇒
                ((#t0 < #vr.1) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
           (#vr.11 < #vr.1)  ∥ (#vr.1 = #vr.11) )
      case case_1
      solve( (#t2.2 < #t2.1)  ∥ (#t2.2 = #t2.1)  ∥ (#vr < #t2.2) )
        case case_3
        solve( State_111211111( StateChannel, ~n.1, ~n.2, v ) ▶₀ #t2 )
          case insertsv_0_11121111
          solve( (#vr.16 < #t2.1)  ∥ (#vr.16 = #t2.1) )
            case case_1
            solve( (#t2.2 < #t2.3)  ∥ (#t2.2 = #t2.3) )
              case case_2
              solve( Insert( ~n.2, 'a' ) @ #t2.2 )
                case insertsx_0_11111
                solve( State_11111( StateChannel, ~n.2, 'a' ) ▶₀ #t2.1 )
                  case inx_0_1111
                  solve( Insert( ~n.2, 'b' ) @ #t2.2 )
                    case insertsx_0_11111
                    solve( State_11111( StateChannel, ~n.2, 'b' ) ▶₀ #t2.2 )
                      case inx_0_1111
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

rule (modulo E) Init[color=#ffffff, process="new s.1;", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) news_0_[color=#ffffff, process="new s.1;", issapicrule,
                        role='Process']:
   [ State_( ), Fr( s.1 ) ] --> [ State_1( s.1 ) ]

  /*
