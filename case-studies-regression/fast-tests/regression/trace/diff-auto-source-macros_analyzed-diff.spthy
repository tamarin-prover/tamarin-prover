lemma got_tagged [left, left]:
  all-traces "∀ y #i. (Got( w(y) ) @ #i) ⇒ (∃ #j. Sent( y ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ y #i. (Got( <y, 'tag'> ) @ #i) ∧ ∀ #j. (Sent( y ) @ #j) ⇒ ⊥"
*/
simplify
solve( !Key( k ) ▶₀ #i )
  case Setup
  solve( !KU( senc(<y, 'tag'>, ~k) ) @ #vk )
    case Send
    by contradiction /* from formulas */
  next
    case c_senc
    by solve( !KU( ~k ) @ #vk.2 )
  qed
qed

lemma AUTO_typing_LHS [left, sources]:
  all-traces
  "(⊤) ∧
   (∀ x m #i.
     (AUTO_IN_TERM_1_0_0__Recv___AUTO_MEMBER_1( m, x ) @ #i) ⇒
     ((∃ #j. (!KU( x ) @ #j) ∧ (#j < #i)) ∨
      (∃ #j.
        (AUTO_OUT_TERM_1_0_0__Recv___AUTO_MEMBER_1( m ) @ #j) ∧ (#j < #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ x m #i.
  (AUTO_IN_TERM_1_0_0__Recv___AUTO_MEMBER_1( m, x ) @ #i)
 ∧
  (∀ #j. (!KU( x ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j.
    (AUTO_OUT_TERM_1_0_0__Recv___AUTO_MEMBER_1( m ) @ #j) ⇒ ¬(#j < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥
         (∃ #j. (!KU( x ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
         (∃ #j.
           (AUTO_OUT_TERM_1_0_0__Recv___AUTO_MEMBER_1( senc(x, k) ) @ #j)
          ∧
           (¬(last(#j))) ∧ (#j < #i)) )
    case case_1
    solve( !Key( k ) ▶₀ #i )
      case Setup
      solve( !KU( senc(x, ~k) ) @ #vk )
        case Recv
        solve( (∃ #j. (!KU( t ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.1))  ∥
               (∃ #j.
                 (AUTO_OUT_TERM_1_0_0__Recv___AUTO_MEMBER_1( senc(t, ~k.1) ) @ #j)
                ∧
                 (¬(last(#j))) ∧ (#j < #vr.1)) )
          case case_1
          by contradiction /* cyclic */
        next
          case case_2
          by contradiction /* impossible chain */
        qed
      next
        case Send
        by contradiction /* from formulas */
      next
        case c_senc
        by contradiction /* from formulas */
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

