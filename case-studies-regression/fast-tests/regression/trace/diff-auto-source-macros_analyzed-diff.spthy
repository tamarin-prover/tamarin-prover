theory MacroAuto

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

macros: w( x ) =  <x, 'tag'>

rule (modulo E) Setup:
   [ Fr( ~k ) ] --> [ !Key( ~k ) ]

rule (modulo E) Send:
   [ !Key( k ), Fr( ~m ) ] --[ Sent( ~m ) ]-> [ Out( senc(w(~m), k) ) ]
 left
  rule (modulo E) Send:
     [ !Key( k ), Fr( ~m ) ]
    --[ Sent( ~m ) ]->
     [ Out( senc(<~m, 'tag'>, k) ) ]
   variants
    rule (modulo AC) Send:
       [ !Key( k ), Fr( ~m ) ]
      --[
      AUTO_OUT_TERM_1_0_0__Recv___AUTO_MEMBER_1( senc(<~m, 'tag'>, k) ),
      Sent( ~m )
      ]->
       [ Out( senc(<~m, 'tag'>, k) ) ]
 right
  rule (modulo E) Send:
     [ !Key( k ), Fr( ~m ) ]
    --[ Sent( ~m ) ]->
     [ Out( senc(<~m, 'tag'>, k) ) ]
   variants
    rule (modulo AC) Send:
       [ !Key( k ), Fr( ~m ) ]
      --[
      AUTO_OUT_TERM_1_0_0__Recv___AUTO_MEMBER_2( senc(<~m, 'tag'>, k) ),
      Sent( ~m )
      ]->
       [ Out( senc(<~m, 'tag'>, k) ) ]

rule (modulo E) Recv:
   [ !Key( k ), In( senc(y, k) ) ] --[ Got( y ) ]-> [ Out( y ) ]
 left
  rule (modulo E) Recv:
     [ !Key( k ), In( senc(y, k) ) ] --[ Got( y ) ]-> [ Out( y ) ]
   variants
    rule (modulo AC) Recv:
       [ !Key( k ), In( senc(y, k) ) ]
      --[ AUTO_IN_TERM_1_0_0__Recv___AUTO_MEMBER_1( senc(y, k), y ), Got( y )
      ]->
       [ Out( y ) ]
 right
  rule (modulo E) Recv:
     [ !Key( k ), In( senc(y, k) ) ] --[ Got( y ) ]-> [ Out( y ) ]
   variants
    rule (modulo AC) Recv:
       [ !Key( k ), In( senc(y, k) ) ]
      --[ AUTO_IN_TERM_1_0_0__Recv___AUTO_MEMBER_2( senc(y, k), y ), Got( y )
      ]->
       [ Out( y ) ]

