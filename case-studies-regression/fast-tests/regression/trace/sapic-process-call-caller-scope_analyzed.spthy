qed

lemma argument_preserved:
  all-traces
  "∀ tag x y #i.
    (Local( tag, x, y ) @ #i) ⇒
    (∃ z #j. (Caller( tag, x, z ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ tag x y #i.
  (Local( tag, x, y ) @ #i)
 ∧
  ∀ z #j. (Caller( tag, x, z ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( Local( tag, x, y ) @ #i )
  case eventLocalearlieryy_0_1211111
  solve( State_1211111( x, y, y.1 ) ▶₀ #i )
    case iny_0_121111
    by contradiction /* from formulas */
  qed
next
  case eventLocalembeddedyy_0_112111
  solve( State_112111( x, y, y.1 ) ▶₀ #i )
    case iny_0_11211
    by contradiction /* from formulas */
  qed
next
  case eventLocalinputyy_0_11111111111
  solve( State_11111111111( x, y, y.1 ) ▶₀ #i )
    case iny_0_1111111111
    by contradiction /* from formulas */
  qed
next
  case eventLocalletyy_0_111121111
  solve( State_111121111( x, y, y.1 ) ▶₀ #i )
    case iny_0_11112111
    by contradiction /* from formulas */
  qed
next
  case eventLocallookupyy_0_1112111111
  solve( State_1112111111( x, y, y.1 ) ▶₀ #i )
    case iny_0_111211111
    by contradiction /* from formulas */
  qed
next
  case eventLocalnesteday_0_211111
  solve( State_211111( x, y ) ▶₀ #i )
    case iny_0_21111
    by contradiction /* from formulas */
  qed
next
  case eventLocaltypedyy_0_11111211111
  solve( State_11111211111( x, y, y.1 ) ▶₀ #i )
    case iny_0_1111121111
    by contradiction /* from formulas */
  qed
qed

