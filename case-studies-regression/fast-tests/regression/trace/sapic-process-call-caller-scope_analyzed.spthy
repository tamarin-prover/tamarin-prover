  (Local( 'embedded', 'a', 'c' ) @ #j)
 ∧
  #i < #j"
*/
simplify
solve( Caller( 'embedded', 'a', 'b' ) @ #i )
  case InyInyCallerembeddedyy_0_112
  solve( State_112( ) ▶₀ #i )
    case p_0_11
    solve( Local( 'embedded', 'a', 'c' ) @ #j )
      case eventLocalembeddedyy_0_112111
      solve( State_112111( 'a', y, 'c' ) ▶₀ #j )
        case iny_0_11211
        SOLVED // trace found
      qed
    qed
  qed
qed

