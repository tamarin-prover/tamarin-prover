theory SapicProcessCallCallerScope

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma caller_input:
  exists-trace
  "∃ #i #j.
    ((Caller( 'input', 'a', 'b' ) @ #i) ∧
     (Local( 'input', 'a', 'c' ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j.
  (Caller( 'input', 'a', 'b' ) @ #i) ∧ (Local( 'input', 'a', 'c' ) @ #j)
 ∧
  #i < #j"
*/
simplify
solve( Caller( 'input', 'a', 'b' ) @ #i )
  case eventCallerinputyy_0_11111111
  solve( State_11111111( 'a', 'b' ) ▶₀ #i )
    case iny_0_1111111
    solve( Local( 'input', 'a', 'c' ) @ #j )
      case eventLocalinputyy_0_11111111111
      solve( State_11111111111( 'a', y, 'c' ) ▶₀ #j )
        case iny_0_1111111111
        SOLVED // trace found
      qed
    qed
  qed
qed

lemma typed_caller_input:
  exists-trace
  "∃ #i #j.
    ((Caller( 'typed', 'a', 'b' ) @ #i) ∧
     (Local( 'typed', 'a', 'c' ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j.
  (Caller( 'typed', 'a', 'b' ) @ #i) ∧ (Local( 'typed', 'a', 'c' ) @ #j)
 ∧
  #i < #j"
*/
simplify
solve( Caller( 'typed', 'a', 'b' ) @ #i )
  case eventCallertypedyybitstring_0_11111211
  solve( State_11111211( 'a', 'b' ) ▶₀ #i )
    case inybitstring_0_1111121
    solve( Local( 'typed', 'a', 'c' ) @ #j )
      case eventLocaltypedyy_0_11111211111
      solve( State_11111211111( 'a', y, 'c' ) ▶₀ #j )
        case iny_0_1111121111
        SOLVED // trace found
      qed
    qed
  qed
qed

