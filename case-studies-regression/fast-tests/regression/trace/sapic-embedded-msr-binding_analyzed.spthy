theory SapicEmbeddedMSRBinding

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

rule (modulo E) init:
   [ Fr( b ) ] --[ Secret( b ) ]-> [ S( b ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) public_values:
   [ ] --> [ S( 'public' ), Arg( 'expected', 'value' ), Else( 'else' ) ]

  /* has exactly the trivial AC variant */

lemma binds_new_variable:
  exists-trace "∃ x #i #j. (Secret( x ) @ #i) ∧ (Bound( x ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i #j. (Secret( x ) @ #i) ∧ (Bound( x ) @ #j)"
*/
simplify
solve( State_1111111( x ) ▶₀ #j )
  case newx_0_111111
  solve( S( ~n ) ▶₁ #j )
    case init
    SOLVED // trace found
  qed
qed

lemma matches_public_value:
  exists-trace "∃ #i. Matched( 'public' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Matched( 'public' ) @ #i)"
*/
simplify
solve( State_1111211( 'public' ) ▶₀ #i )
  case inx_0_111121
  solve( S( 'public' ) ▶₁ #i )
    case public_values
    SOLVED // trace found
  qed
qed

lemma does_not_rebind_input:
  all-traces "∀ x #i. (Matched( x ) @ #i) ⇒ (x = 'public')"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Matched( x ) @ #i) ∧ ¬(x = 'public')"
*/
simplify
solve( State_1111211( x ) ▶₀ #i )
  case inx_0_111121
  solve( S( x ) ▶₁ #i )
    case init
    by contradiction /* cyclic */
  next
    case public_values
    by contradiction /* from formulas */
  qed
qed

lemma matches_argument:
  exists-trace "∃ #i. ArgumentMatch( 'ground', 'expected', 'value' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (ArgumentMatch( 'ground', 'expected', 'value' ) @ #i)"
*/
simplify
solve( ArgumentMatch( 'ground', 'expected', 'value' ) @ #i )
  case ArgexpectedyArgumentMatchgroundexpectedy_0_11121
  solve( State_11121( ) ▶₀ #i )
    case Argumentgroundexpected_0_1112
    solve( Arg( 'expected', 'value' ) ▶₁ #i )
      case public_values
      SOLVED // trace found
    qed
  qed
qed

lemma does_not_rebind_argument:
  all-traces "∀ x y #i. (ArgumentMatch( 'wrong', x, y ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i. (ArgumentMatch( 'wrong', x, y ) @ #i)"
*/
simplify
solve( ArgumentMatch( 'wrong', x, y ) @ #i )
  case ArgwrongyArgumentMatchwrongwrongy_0_1121
  solve( State_1121( ) ▶₀ #i )
    case Argumentwrongwrong_0_112
    by solve( Arg( 'wrong', y ) ▶₁ #i )
  qed
qed

lemma preserves_caller_argument:
  all-traces
  "∀ x y #i.
    (ArgumentMatch( 'caller', x, y ) @ #i) ⇒
    (∃ #j. (Requested( x ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i.
  (ArgumentMatch( 'caller', x, y ) @ #i)
 ∧
  ∀ #j. (Requested( x ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( ArgumentMatch( 'caller', x, y ) @ #i )
  case ArgxyArgumentMatchcallerxy_0_121111
  solve( State_121111( x ) ▶₀ #i )
    case Argumentcallerx_0_12111
    by contradiction /* from formulas */
  qed
qed

lemma binds_in_failure_branch:
  exists-trace "∃ #i. ElseBound( 'else' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (ElseBound( 'else' ) @ #i)"
*/
simplify
solve( State_212( ) ▶₀ #i )
  case letyexpectedunusedwrong_2_21
  solve( Else( 'else' ) ▶₁ #i )
    case public_values
    SOLVED // trace found
  qed
qed

