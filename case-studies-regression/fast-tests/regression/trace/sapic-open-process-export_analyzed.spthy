heuristic: p

lemma caller_binding:
  all-traces
  "∀ x #i.
    (Seen( x ) @ #i) ⇒ ((x = 'a') ∨ (∃ #j. (Created( x ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i.
  (Seen( x ) @ #i)
 ∧
  (¬(x = 'a')) ∧ (∀ #j. (Created( x ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( Seen( x ) @ #i )
  case eventSeena_0_211
  by contradiction /* from formulas */
next
  case eventSeenx_0_11111
  solve( State_11111( x ) ▶₀ #i )
    case P_0_1111
    by contradiction /* from formulas */
  qed
next
  case eventSeenx_0_12111
  solve( State_12111( x ) ▶₀ #i )
    case P_0_1211
    by contradiction /* from formulas */
  qed
qed

lemma distinct_callers:
  exists-trace
  "∃ x y #i #j #k #l.
    ((((Created( x ) @ #i) ∧ (Created( y ) @ #j)) ∧ (Seen( x ) @ #k)) ∧
     (Seen( y ) @ #l)) ∧
    (¬(x = y))"
/*
guarded formula characterizing all satisfying traces:
"∃ x y #i #j #k #l.
  (Created( x ) @ #i) ∧
  (Created( y ) @ #j) ∧
  (Seen( x ) @ #k) ∧
  (Seen( y ) @ #l)
 ∧
  ¬(x = y)"
*/
simplify
solve( Created( x ) @ #i )
  case eventCreatedx_0_111
  solve( State_111( x ) ▶₀ #i )
    case newx_0_11
    solve( Created( y ) @ #j )
      case eventCreatedx_0_121
      solve( State_121( y ) ▶₀ #j )
        case newx_0_12
        solve( Seen( ~n ) @ #k )
          case eventSeenx_0_11111
          solve( State_11111( ~n ) ▶₀ #k )
            case P_0_1111
            solve( Seen( ~n.1 ) @ #l )
              case eventSeenx_0_12111
              solve( State_12111( ~n.1 ) ▶₀ #l )
                case P_0_1211
                SOLVED // trace found
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma closed_wrapper:
  exists-trace "∃ #i. Seen( 'a' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Seen( 'a' ) @ #i)"
*/
simplify
solve( Seen( 'a' ) @ #i )
  case eventSeena_0_211
  solve( State_211( ) ▶₀ #i )
    case P_0_21
    SOLVED // trace found
  qed
qed

