theory SapicLookupDestructorProgress

begin

// Function signature and definition of the equational theory E

functions: box/1, fst/1, pair/2, snd/1, unbox/1 [destructor]
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    unbox(box(<x, y>)) = <x, y>

heuristic: p

lemma reachable:
  exists-trace "∃ #i. Seen( 'value', 'value' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Seen( 'value', 'value' ) @ #i)"
*/
simplify
solve( State_111( ~prog_, 'value', 'value', v ) ▶₀ #i )
  case letabunboxboxvv_3_11
  solve( (#vr.3 < #t2)  ∥ (#vr.3 = #t2) )
    case case_2
    solve( (∃ #t. (ProgressTo_1111( ~prog_ ) @ #t))  ∥
           (∃ #t. (ProgressTo_112( ~prog_ ) @ #t))  ∥
           (∃ #t. (ProgressTo_12( ~prog_ ) @ #t)) )
      case case_1
      solve( State_111( ~prog_, a, b, v ) ▶₀ #t.1 )
        case letabunboxboxvv_3_11
        solve( (#t2 < #t2.1)  ∥ (#t2 = #t2.1) )
          case case_2
          SOLVED // trace found
        qed
      qed
    qed
  qed
qed

lemma value_preserved:
  all-traces
  "∀ a b #i. (Seen( a, b ) @ #i) ⇒ ((a = 'value') ∧ (b = 'value'))"
/*
guarded formula characterizing all counter-examples:
"∃ a b #i. (Seen( a, b ) @ #i) ∧ ((¬(a = 'value')) ∨ (¬(b = 'value')))"
*/
simplify
solve( (¬(a = 'value'))  ∥ (¬(b = 'value')) )
  case case_1
  solve( State_111( ~prog_, a, b, v ) ▶₀ #i )
    case letabunboxboxvv_3_11
    by contradiction /* from formulas */
  qed
next
  case case_2
  solve( State_111( ~prog_, a, b, v ) ▶₀ #i )
    case letabunboxboxvv_3_11
    by contradiction /* from formulas */
  qed
qed

