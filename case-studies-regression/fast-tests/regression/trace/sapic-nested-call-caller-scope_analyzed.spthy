theory SapicNestedCallCallerScope

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma input_independent:
  exists-trace
  "∃ #i #j.
    ((Caller( 'input', 'a', 'b' ) @ #i) ∧
     (Local( 'input', 'a', 'c' ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j.
  (Caller( 'input', 'a', 'b' ) @ #i) ∧ (Local( 'input', 'a', 'c' ) @ #j)
 ∧
  #i < #j"
*/
simplify
solve( Caller( 'input', 'a', 'b' ) @ #i )
  case eventCallerinputay_0_111111111
  solve( State_111111111( 'a', 'b' ) ▶₀ #i )
    case iny_0_11111111
    solve( Local( 'input', 'a', 'c' ) @ #j )
      case eventLocalinputay_0_1111111111111
      solve( State_1111111111111( 'a', y, 'c' ) ▶₀ #j )
        case iny_0_111111111111
        SOLVED // trace found
      qed
    qed
  qed
qed

lemma typed_input_independent:
  exists-trace
  "∃ #i #j.
    ((Caller( 'typed', 'a', 'b' ) @ #i) ∧
     (Local( 'typed', 'a', 'c' ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j.
  (Caller( 'typed', 'a', 'b' ) @ #i) ∧ (Local( 'typed', 'a', 'c' ) @ #j)
 ∧
  #i < #j"
*/
simplify
solve( Caller( 'typed', 'a', 'b' ) @ #i )
  case eventCallertypedaybitstring_0_111111211
  solve( State_111111211( 'a', 'b' ) ▶₀ #i )
    case inybitstring_0_11111121
    solve( Local( 'typed', 'a', 'c' ) @ #j )
      case eventLocaltypeday_0_1111112111111
      solve( State_1111112111111( 'a', y, 'c' ) ▶₀ #j )
        case iny_0_111111211111
        SOLVED // trace found
      qed
    qed
  qed
qed

lemma deeper_call:
  exists-trace
  "∃ #i #j.
    ((Caller( 'deep', 'a', 'b' ) @ #i) ∧ (Local( 'deep', 'a', 'c' ) @ #j)) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j.
  (Caller( 'deep', 'a', 'b' ) @ #i) ∧ (Local( 'deep', 'a', 'c' ) @ #j)
 ∧
  #i < #j"
*/
simplify
solve( Caller( 'deep', 'a', 'b' ) @ #i )
  case eventCallerdeepay_0_111112111
  solve( State_111112111( 'a', y, 'b' ) ▶₀ #i )
    case iny_0_11111211
    solve( Local( 'deep', 'a', 'c' ) @ #j )
      case eventLocaldeepay_0_11111211111111
      solve( State_11111211111111( 'a', y.1, y.2, 'c' ) ▶₀ #j )
        case iny_0_1111121111111
        SOLVED // trace found
      qed
    qed
  qed
qed

