lemma fresh_values_distinct:
  exists-trace
  "∃ a b c #i #j.
    ((((Caller( 'fresh', a, b ) @ #i) ∧ (Local( 'fresh', a, c ) @ #j)) ∧
      (¬(a = c))) ∧
     (¬(b = c))) ∧
    (#i < #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ a b c #i #j.
  (Caller( 'fresh', a, b ) @ #i) ∧ (Local( 'fresh', a, c ) @ #j)
 ∧
  (¬(a = c)) ∧ (¬(b = c)) ∧ (#i < #j)"
*/
simplify
solve( Caller( 'fresh', a, b ) @ #i )
  case eventCallerfreshay_0_1211
  solve( State_1211( ~a, ~y ) ▶₀ #i )
    case newy_0_121
    solve( Local( 'fresh', ~a, c ) @ #j )
      case eventLocalfreshay_0_12111111
      solve( State_12111111( ~a, ~y.1, ~y.2 ) ▶₀ #j )
        case newy_0_1211111
        SOLVED // trace found
      qed
    qed
  qed
qed

lemma embedded_input:
  exists-trace "∃ #i. Local( 'embedded', 'a', 'c' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Local( 'embedded', 'a', 'c' ) @ #i)"
*/
simplify
solve( Local( 'embedded', 'a', 'c' ) @ #i )
  case InyLocalembeddeday_0_211111
  solve( State_211111( 'a', y ) ▶₀ #i )
    case Embeddeda_0_21111
    SOLVED // trace found
  qed
qed

lemma argument_preserved:
  all-traces
  "∀ tag x y #i.
    (Local( tag, x, y ) @ #i) ⇒
    (∃ z #j. (Caller( tag, x, z ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ tag x y #i.
  (Local( tag, x, y ) @ #i)
 ∧
  ∀ z #j. (Caller( tag, x, z ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( Local( tag, x, y ) @ #i )
  case InyLocalembeddeday_0_211111
  solve( State_211111( x, y ) ▶₀ #i )
    case Embeddeda_0_21111
    by contradiction /* from formulas */
  qed
next
  case eventLocaldeepay_0_11111211111111
  solve( State_11111211111111( x, y, y.1, y.2 ) ▶₀ #i )
    case iny_0_1111121111111
    by contradiction /* from formulas */
  qed
next
  case eventLocalfreshay_0_12111111
  solve( State_12111111( ~a, ~y, ~y.1 ) ▶₀ #i )
    case newy_0_1211111
    by contradiction /* from formulas */
  qed
next
  case eventLocalinputay_0_1111111111111
  solve( State_1111111111111( x, y, y.1 ) ▶₀ #i )
    case iny_0_111111111111
    by contradiction /* from formulas */
  qed
next
  case eventLocalletalocal_0_111211111
  solve( State_111211111( x, y ) ▶₀ #i )
    case LetValuea_0_11121111
    by contradiction /* from formulas */
  qed
next
  case eventLocallookupay_0_1121111111
  solve( State_1121111111( x, y, y.1 ) ▶₀ #i )
    case lookupcellasy_0_112111111
    by contradiction /* from formulas */
  qed
next
  case eventLocalpatternay_0_11112111111
  solve( State_11112111111( z, x, y, y.1 ) ▶₀ #i )
    case inyz_0_1111211111
    by contradiction /* from formulas */
  qed
next
  case eventLocaltypeday_0_1111112111111
  solve( State_1111112111111( x, y, y.1 ) ▶₀ #i )
    case iny_0_111111211111
    by contradiction /* from formulas */
  qed
qed

