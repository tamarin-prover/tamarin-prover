lemma AUTO_typing_LHS [left, sources]:
  all-traces
  "(⊤) ∧
   (∀ x m #i.
     (AUTO_IN_TERM_2_0_0_0__Forward___AUTO_MEMBER_1( m, x ) @ #i) ⇒
     ((∃ #j. (!KU( x ) @ #j) ∧ (#j < #i)) ∨
      (∃ #j.
        (AUTO_OUT_TERM_2_0_0_0__Forward___AUTO_MEMBER_1( m ) @ #j) ∧
        (#j < #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ x m #i.
  (AUTO_IN_TERM_2_0_0_0__Forward___AUTO_MEMBER_1( m, x ) @ #i)
 ∧
  (∀ #j. (!KU( x ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j.
    (AUTO_OUT_TERM_2_0_0_0__Forward___AUTO_MEMBER_1( m ) @ #j) ⇒ ¬(#j < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥
         (∃ #j. (!KU( x ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
         (∃ #j.
           (AUTO_OUT_TERM_2_0_0_0__Forward___AUTO_MEMBER_1( aenc(<x, 'tag'>, pk(k))
            ) @ #j)
          ∧
           (¬(last(#j))) ∧ (#j < #i)) )
    case case_1
    solve( !Key( $A, k ) ▶₀ #i )
      case Keys
      solve( !Pub( $B, p ) ▶₁ #i )
        case Keys
        solve( !KU( aenc(<x, 'tag'>, pk(~k)) ) @ #vk )
          case Forward_case_1
          solve( (∃ #j. (!KU( <x, 'tag'> ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.2))  ∥
                 (∃ #j.
                   (AUTO_OUT_TERM_2_0_0_0__Forward___AUTO_MEMBER_1( aenc(<<x, 'tag'>, 'tag'
                                                                         >,
                                                                         pk(~k.2))
                    ) @ #j)
                  ∧
                   (¬(last(#j))) ∧ (#j < #vr.2)) )
            case case_1
            by sorry /* bound 6 hit */
          qed
        next
          case Forward_case_2
          solve( (∃ #j. (!KU( x.1 ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.2))  ∥
                 (∃ #j.
                   (AUTO_OUT_TERM_2_0_0_0__Forward___AUTO_MEMBER_1( aenc(<x.1, 'tag'>,
                                                                         pk(~k.3))
                    ) @ #j)
                  ∧
                   (¬(last(#j))) ∧ (#j < #vr.2)) )
            case case_1
            by sorry /* bound 6 hit */
          next
            case case_2
            by sorry /* bound 6 hit */
          qed
        next
          case Send
          by contradiction /* from formulas */
        next
          case c_aenc
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

