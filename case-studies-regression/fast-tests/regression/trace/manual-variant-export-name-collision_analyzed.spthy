     [ In( y ) ] --[ Normal( y ), Added( y ) ]-> [ ]

rule (modulo E) Trivial___VARIANT_1:
   [ ] --[ OtherNormal( ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma original:
  exists-trace "∃ #i. (Original( 'a' ) @ #i) ∧ (Annotated( 'a' ) @ #i)"
