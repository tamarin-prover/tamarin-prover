     [ In( x ) ] --[ Original( x ), Annotated( x ) ]-> [ Out( x ) ]

rule (modulo E) R___VARIANT_1:
   [ ] --[ Other( ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Trivial:
   [ In( x ) ] --[ Normal( x ) ]-> [ ]
