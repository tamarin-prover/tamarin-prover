theory SoundnessSapicDestructorVariableClash

begin

// Function signature and definition of the equational theory E

functions: adec/2 [destructor], aenc/2, fst/1, pair/2, pk/1, snd/1
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma dec_reach:
  exists-trace "∃ #i. Dec( 's' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Dec( 's' ) @ #i)"
*/
simplify
solve( State_211111( 's', sk, x ) ▶₀ #i )
  case letmadecxsk_3_21111
  solve( !KU( pk(~n) ) @ #vk.2 )
    case outpksk_0_211
    SOLVED // trace found
  qed
qed

lemma no_dec:
  all-traces "∀ m #i. (Dec( m ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ m #i. (Dec( m ) @ #i)"
*/
simplify
solve( State_211111( m, sk, x ) ▶₀ #i )
  case letmadecxsk_3_21111
  solve( !KU( pk(~n) ) @ #vk.2 )
    case outpksk_0_211
    SOLVED // trace found
  qed
qed

