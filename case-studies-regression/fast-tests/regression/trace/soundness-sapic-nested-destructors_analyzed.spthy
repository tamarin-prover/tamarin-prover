lemma no_failed_success:
  all-traces "∀ label #i. (Success( label ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ label #i. (Success( label ) @ #i)"
*/
simplify
solve( Success( label ) @ #i )
  case eventSuccessleft_0_11111111211
  by solve( State_11111111211( x ) ▶₀ #i )
next
  case eventSuccessmatched_0_1211
  by solve( State_1211( ) ▶₀ #i )
next
  case eventSuccessnested_0_111111111211
  by solve( State_111111111211( x ) ▶₀ #i )
next
  case eventSuccesspattern_0_111211
  by solve( State_111211( x ) ▶₀ #i )
next
  case eventSuccessright_0_1111111211
  by solve( State_1111111211( x ) ▶₀ #i )
next
  case eventSuccessunused_0_111111111111
  by solve( State_111111111111( x ) ▶₀ #i )
qed

