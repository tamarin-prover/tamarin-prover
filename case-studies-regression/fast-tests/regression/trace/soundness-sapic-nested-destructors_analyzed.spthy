simplify
solve( State_2111( s, s ) ▶₀ #i )
  case lettagxtagdcdestructor_6_211
  SOLVED // trace found
qed

lemma scope_preserved:
  all-traces "∀ s x #i. (ScopeResult( s, x ) @ #i) ⇒ (s = x)"
