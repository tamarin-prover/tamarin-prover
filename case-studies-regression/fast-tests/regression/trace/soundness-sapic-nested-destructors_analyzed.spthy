theory SoundnessSapicNestedDestructors

begin

// Function signature and definition of the equational theory E

functions: c1/1, c2/1, d/1 [destructor], fst/1, pair/2, snd/1
equations:
    d(c1(x)) = x,
    d(c2(x)) = x,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

lemma unused_fails:
  exists-trace "∃ #i. Failure( 'unused' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Failure( 'unused' ) @ #i)"
*/
simplify
solve( Failure( 'unused' ) @ #i )
  case eventFailureunused_0_111111111112
  solve( State_111111111112( ) ▶₀ #i )
    case letxdbadtag_3_11111111111
    SOLVED // trace found
  qed
qed

