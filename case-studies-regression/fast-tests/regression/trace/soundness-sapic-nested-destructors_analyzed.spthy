lemma siblings_result:
  all-traces "∀ x #i. (Result( 'siblings', x ) @ #i) ⇒ (x = <'a', 'b'>)"
/*
guarded formula characterizing all counter-examples:
"∃ x #i. (Result( 'siblings', x ) @ #i) ∧ ¬(x = <'a', 'b'>)"
*/
simplify
solve( Result( 'siblings', x ) @ #i )
  case eventResultsiblingsx_0_111111211
  solve( State_111111211( x ) ▶₀ #i )
    case letxdcadcb_11_11111121
    by contradiction /* from formulas */
  qed
qed

