theory SoundnessSapicDestructorGeneratedBinders

begin

// Function signature and definition of the equational theory E

functions: d/1 [destructor], e/1 [destructor], fst/1, pair/2, snd/1
equations:
    d(<x, StateChannel>) = x,
    e(<x, lock>) = x,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2

heuristic: p

/* looping facts with injective instances: L_CellLocked/2, L_PureState/2
*/

lemma state_success_reachable:
  exists-trace "∃ #i. Success( 'state', 'ok' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Success( 'state', 'ok' ) @ #i)"
*/
simplify
solve( Success( 'state', 'ok' ) @ #i )
  case eventSuccessstatey_0_11111111
  solve( State_11111111( StateChannel, 'ok', StateChannel.1,
                         StateChannel.2, StateChannel.3, StateChannel.4
         ) ▶₀ #i )
    case letydoktag_3_1111111
    SOLVED // trace found
  qed
qed

lemma lock_success_reachable:
  exists-trace "∃ #i. Success( 'lock', 'ok' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Success( 'lock', 'ok' ) @ #i)"
*/
simplify
solve( Success( 'lock', 'ok' ) @ #i )
  case eventSuccesslockz_0_11121111
  solve( State_11121111( 'ok', StateChannel, StateChannel.1,
                         StateChannel.2, lock, lock.1, lock.2
         ) ▶₀ #i )
    case letzeoktag_3_1112111
    SOLVED // trace found
  qed
qed

lemma no_state_success:
  all-traces "∀ y #i. (Success( 'state', y ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ y #i. (Success( 'state', y ) @ #i)"
*/
simplify
solve( Success( 'state', y ) @ #i )
  case eventSuccessstatey_0_11111111
  solve( State_11111111( StateChannel, y, StateChannel.1, StateChannel.2,
                         StateChannel.3, StateChannel.4
         ) ▶₀ #i )
    case letydoktag_3_1111111
    SOLVED // trace found
  qed
qed

lemma no_lock_success:
  all-traces "∀ z #i. (Success( 'lock', z ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ z #i. (Success( 'lock', z ) @ #i)"
*/
simplify
solve( Success( 'lock', z ) @ #i )
  case eventSuccesslockz_0_11121111
  solve( State_11121111( z, StateChannel, StateChannel.1, StateChannel.2,
                         lock, lock.1, lock.2
         ) ▶₀ #i )
    case letzeoktag_3_1112111
    SOLVED // trace found
  qed
qed

lemma state_failure_unreachable:
  all-traces "∀ #i. (Fail( 'state' ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Fail( 'state' ) @ #i)"
*/
simplify
solve( Fail( 'state' ) @ #i )
  case eventFailstate_0_11111112
  by solve( State_11111112( StateChannel, StateChannel.1, StateChannel.2,
                            StateChannel.3, StateChannel.4
            ) ▶₀ #i )
qed

lemma lock_failure_unreachable:
  all-traces "∀ #i. (Fail( 'lock' ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ #i. (Fail( 'lock' ) @ #i)"
*/
simplify
solve( Fail( 'lock' ) @ #i )
  case eventFaillock_0_11121112
  by solve( State_11121112( StateChannel, StateChannel.1, StateChannel.2,
                            lock, lock.1, lock.2
            ) ▶₀ #i )
qed

