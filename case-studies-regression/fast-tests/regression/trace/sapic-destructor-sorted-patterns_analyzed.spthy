theory SapicDestructorSortedPatterns

begin

// Function signature and definition of the equational theory E

builtins: natural-numbers
functions: c/1, d/1 [destructor], fst/1, pair/2, snd/1
equations: d(c(~x)) = ~x, fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

heuristic: p

lemma fresh_success:
  exists-trace "∃ y #i. Seen( 'fresh', y ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ y #i. (Seen( 'fresh', y ) @ #i)"
*/
simplify
solve( Seen( 'fresh', y ) @ #i )
  case eventSeenfreshy_0_11111
  solve( State_11111( n, y ) ▶₀ #i )
    case letydcn_3_1111
    SOLVED // trace found
  qed
qed

lemma fresh_failure:
  exists-trace "∃ #i. Miss( 'fresh' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Miss( 'fresh' ) @ #i)"
*/
simplify
solve( Miss( 'fresh' ) @ #i )
  case eventMissfresh_0_11112
  by solve( State_11112( n ) ▶₀ #i )
qed

lemma public_success:
  exists-trace "∃ y #i. Seen( 'public', y ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ y #i. (Seen( 'public', y ) @ #i)"
*/
simplify
solve( Seen( 'public', y ) @ #i )
  case eventSeenpublicy_0_11121
  by solve( State_11121( n, y ) ▶₀ #i )
qed

lemma public_failure:
  exists-trace "∃ #i. Miss( 'public' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Miss( 'public' ) @ #i)"
*/
simplify
solve( Miss( 'public' ) @ #i )
  case eventMisspublic_0_11122
  solve( State_11122( n ) ▶₀ #i )
    case letydca_2_1112
    SOLVED // trace found
  qed
qed

lemma term_failure:
  exists-trace "∃ #i. Miss( 'term' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Miss( 'term' ) @ #i)"
*/
simplify
solve( Miss( 'term' ) @ #i )
  case eventMissterm_0_1122
  solve( State_1122( n ) ▶₀ #i )
    case letydcca_2_112
    SOLVED // trace found
  qed
qed

lemma nat_failure:
  exists-trace "∃ #i. Miss( 'nat' ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Miss( 'nat' ) @ #i)"
*/
simplify
solve( Miss( 'nat' ) @ #i )
  case eventMissnat_0_122
  solve( State_122( n ) ▶₀ #i )
    case letydc_2_12
    SOLVED // trace found
  qed
qed

lemma no_term_success:
  all-traces "∀ y #i. (Seen( 'term', y ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ y #i. (Seen( 'term', y ) @ #i)"
*/
simplify
solve( Seen( 'term', y ) @ #i )
  case eventSeentermy_0_1121
  by solve( State_1121( n, y ) ▶₀ #i )
qed

lemma no_nat_success:
  all-traces "∀ y #i. (Seen( 'nat', y ) @ #i) ⇒ (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ y #i. (Seen( 'nat', y ) @ #i)"
*/
simplify
solve( Seen( 'nat', y ) @ #i )
  case eventSeennaty_0_121
  by solve( State_121( n, y ) ▶₀ #i )
qed

rule (modulo E) Init[color=#ffffff, process="new n.1;", issapicrule,
                     role='Process']:
   [ ] --[ Init( ) ]-> [ State_( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) newn_0_[color=#ffffff, process="new n.1;", issapicrule,
                        role='Process']:
   [ State_( ), Fr( n.1 ) ] --> [ State_1( n.1 ) ]

  /*
  rule (modulo AC) newn_0_[color=#ffffff, process="new n.1;", issapicrule,
                           role='Process']:
     [ State_( ), Fr( n ) ] --> [ State_1( n ) ]
  */

