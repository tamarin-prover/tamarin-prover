                               process="let y.1=d(c(n.1))", no_derivcheck, issapicrule, role='Process']:
   [ Let_11111( c(~x.5), n.1 ) ] --> [ Let_111101( ~x.5, n.1 ) ]

  /*
  rule (modulo AC) letydcn_1_1111[color=#ffffff,
                                  process="let y.1=d(c(n.1))", no_derivcheck, issapicrule, role='Process']:
     [ Let_11111( c(~x), n ) ] --> [ Let_111101( ~x, n ) ]
  */

restriction Restr_letydcn_2_1111_1:
  "∀ x #NOW.
    (Restr_letydcn_2_1111_1( x ) @ #NOW) ⇒ (∀ ~x.1. (c(~x.1) = x) ⇒ (⊥))"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW.
    (Restr_letydcn_2_1111_1( x ) @ #NOW) ⇒ (∀ ~x.1. (c(~x.1) = x) ⇒ (⊥))"
  */

