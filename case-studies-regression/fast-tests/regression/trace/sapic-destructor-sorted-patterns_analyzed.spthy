                               process="let y.1=d(c(n.1))", issapicrule, role='Process']:
   [ Let_11111( c(n.1), n.1 ) ]
  --[ Restr_letydcn_2_1111_1( c(n.1) ) ]->
   [ State_11112( n.1 ) ]

  /*
  rule (modulo AC) letydcn_2_1111[color=#ffffff,
                                  process="let y.1=d(c(n.1))", issapicrule, role='Process']:
     [ Let_11111( c(n), n ) ]
    --[ Restr_letydcn_2_1111_1( c(n) ) ]->
     [ State_11112( n ) ]
  */

