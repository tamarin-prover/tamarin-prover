{
  "tests": [
    {
      "name": "typed-roundtrip",
      "args": ["--quit-on-warning"],
      "checks": ["roundtrip"],
      "roundtrip_module": "spthytyped"
    },
    {
      "name": "typed-patterns",
      "args": ["--output-module=spthytyped", "--quit-on-warning"],
      "matches": [
        {"regex": "pat_x", "max": 0, "theory_only": true},
        {"regex": "in\\(<'a',\\s*'b'>\\)", "min": 1, "max": 1, "theory_only": true},
        {"regex": "in\\('c'\\)", "min": 2, "max": 2, "theory_only": true},
        {"regex": "in\\('d'\\)", "min": 1, "max": 1, "theory_only": true},
        {"regex": "let\\s+Value\\s*\\(", "min": 1, "max": 1, "theory_only": true},
        {"regex": "Value\\('e'\\)", "min": 1, "theory_only": true}
      ]
    }
  ]
}
