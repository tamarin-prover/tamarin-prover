{
  "tests": [
    {
      "name": "export-roundtrip",
      "args": [
        "--diff",
        "--quit-on-warning"
      ],
      "checks": [
        "roundtrip"
      ]
    },
    {
      "name": "duplicate-declaration-printing",
      "args": [
        "--diff",
        "--quit-on-warning"
      ],
      "matches": [
        {
          "regex": "^\\s*rule \\(modulo E\\) Both:",
          "min": 1,
          "max": 1,
          "theory_only": true
        },
        {
          "regex": "^\\s*rule \\(modulo E\\) Automatic:",
          "min": 1,
          "max": 1,
          "theory_only": true
        }
      ]
    }
  ]
}
