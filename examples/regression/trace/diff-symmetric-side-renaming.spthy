// Every AC variable permutation gives the same side rule. Check one correspondence
// without enumerating permutations that cannot change the restored parent slots.
theory DiffSymmetricSideRenaming begin
builtins: multiset
rule R: [] --> [Out($a0 ++ $a1 ++ $a2 ++ $a3 ++ $a4 ++ $a5 ++ $a6 ++ $a7)]
left rule R: [] --> [Out($z0 ++ $z1 ++ $z2 ++ $z3 ++ $z4 ++ $z5 ++ $z6 ++ $z7)]
right rule R: [] --> [Out($a0 ++ $a1 ++ $a2 ++ $a3 ++ $a4 ++ $a5 ++ $a6 ++ $a7)]
end
