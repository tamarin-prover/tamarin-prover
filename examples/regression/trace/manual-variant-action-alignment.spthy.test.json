{
  "tests": [
    {
      "name": "alignment-roundtrip",
      "args": [
        "--quit-on-warning"
      ],
      "checks": [
        "roundtrip"
      ],
      "timeout": 15
    },
    {
      "name": "reject-late-conflict",
      "args": [
        "-DLATE_CONFLICT",
        "--quit-on-warning"
      ],
      "exit_code": 1,
      "contains": [
        "cannot confirm manual variants",
        "Unsupported rule semantics - aborting before proof search."
      ],
      "timeout": 15
    },
    {
      "name": "reject-missing-action",
      "args": [
        "-DMISSING_ACTION",
        "--quit-on-warning"
      ],
      "exit_code": 1,
      "contains": [
        "cannot confirm manual variants",
        "Unsupported rule semantics - aborting before proof search."
      ],
      "timeout": 15
    },
    {
