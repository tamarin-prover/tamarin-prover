{
  "tests": [
    {
      "name": "covered-product",
      "args": [
        "--prove",
        "--quit-on-warning"
      ],
      "contains": [
        "witness (exists-trace): verified",
        "no_added (all-traces): falsified"
      ]
    },
    {
      "name": "export-roundtrip",
      "args": [
        "--quit-on-warning"
      ],
      "checks": [
        "roundtrip",
        "partial-evaluation"
      ]
    }
  ]
}
