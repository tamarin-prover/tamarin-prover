{
  "tests": [
    {
      "name": "typed-roundtrip",
      "args": ["--quit-on-warning"],
      "checks": ["roundtrip"],
      "roundtrip_module": "spthytyped"
    },
    {
      "name": "typed-locations",
      "args": ["--output-module=spthytyped", "--quit-on-warning"],
      "matches": [
        {"regex": "\\blet\\b", "max": 0, "theory_only": true},
        {"regex": "@'outer'", "min": 1, "max": 1, "theory_only": true},
        {"regex": "@'inner'", "min": 1, "max": 1, "theory_only": true},
        {"regex": "new (x\\.[0-9]+);\\s*\\(event Caller\\(\\s*report\\(\\1\\)\\s*\\)\\)@\\1", "min": 1, "max": 1, "theory_only": true}
      ]
    }
  ]
}
