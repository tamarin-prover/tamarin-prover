{
  "tests": [
    {
      "name": "export-roundtrip",
      "args": [
        "--diff",
        "--quit-on-warning",
        "--auto-sources",
        "--bound=6"
      ],
      "checks": [
        "roundtrip",
        "partial-evaluation"
      ]
    },
    {
      "name": "singleton-name-and-actions",
      "args": [
        "--diff",
        "--quit-on-warning",
        "--auto-sources",
        "--bound=6"
      ],
      "matches": [
        {
          "regex": "^\\s*rule \\(modulo AC\\) Send:",
          "min": 2,
          "max": 2,
          "theory_only": true
        },
        {
          "regex": "^\\s*rule \\(modulo AC\\) Send___",
          "max": 0,
          "theory_only": true
        },
        {
          "regex": "First\\( ~n \\)",
          "min": 2,
          "max": 2,
          "theory_only": true
        },
        {
          "regex": "AUTO_OUT_TERM_2_0_0_0__Forward(?:___AUTO_MEMBER_[0-9]+)?\\(\\s*aenc\\(<~n,",
          "min": 2,
          "max": 2,
          "theory_only": true
        },
        {
          "regex": "^\\s*rule \\(modulo E\\) Send___AUTO_MEMBER_1:",
          "min": 1,
          "max": 1,
          "theory_only": true
        }
      ]
    }
  ]
}
