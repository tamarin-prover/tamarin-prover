{
  "tests": [
    {
      "name": "typed-roundtrip",
      "args": ["--quit-on-warning"],
      "checks": ["roundtrip"],
      "roundtrip_module": "spthytyped"
    },
    {
      "name": "typed-captures",
      "args": ["--output-module=spthytyped", "--quit-on-warning"],
      "matches": [
        {"regex": "\\bP\\s*\\(", "max": 0, "theory_only": true},
        {"regex": "new (x\\.[0-9]+);\\s*event Created\\(\\s*\\1\\s*\\);\\s*event Seen\\(\\s*\\1\\s*\\)", "min": 2, "max": 2, "theory_only": true},
        {"regex": "let\\s+Wrapped\\s*\\(", "min": 1, "max": 1, "theory_only": true}
      ]
    }
  ]
}
