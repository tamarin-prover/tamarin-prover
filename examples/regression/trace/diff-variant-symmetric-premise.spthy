theory DiffVariantSymmetricPremise
begin
builtins: multiset
// These symmetric message variables all occur in premises, so no mirror slot
// depends on their correspondence. Extra permutations cannot change the vector.
rule S: [In(x0 ++ x1 ++ x2 ++ x3 ++ x4 ++ x5 ++ x6 ++ x7)] --> []
left rule S: [In(x0 ++ x1 ++ x2 ++ x3 ++ x4 ++ x5 ++ x6 ++ x7)] --> []
 variants rule (modulo AC) S:
   [In(z0 ++ z1 ++ z2 ++ z3 ++ z4 ++ z5 ++ z6 ++ z7)] --> []
right rule S: [In(x0 ++ x1 ++ x2 ++ x3 ++ x4 ++ x5 ++ x6 ++ x7)] --> []
end
