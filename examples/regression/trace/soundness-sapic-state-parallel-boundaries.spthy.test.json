{
  "tests": [
    {
      "name": "parallel-initialization",
      "args": [
        "--prove"
      ],
      "matches": [
        {
          "regex": "\\bL_PureState\\(",
          "theory_only": true,
          "min": 1
        }
      ],
      "contains": [
        "shared_reachable (exists-trace): verified",
        "repeated_reachable (exists-trace): verified"
      ]
    },
    {
      "name": "replicated-initialization",
      "args": [
        "--prove",
        "-DREPEATED_ONLY"
      ],
      "matches": [
        {
          "regex": "\\bL_PureState\\(",
          "max": 0,
          "theory_only": true
        }
      ],
      "contains": [
        "repeated_reachable (exists-trace): verified"
      ]
    }
  ]
}
