{
  "tests": [
    {
      "name": "proverif",
      "args": [
        "--output-module=proverif",
        "--quit-on-warning",
        "-DPROCESS"
      ],
      "matches": [
        {
          "regex": "free (?:v'a|v'a_2e_b|v'a_5f_b|v'a_5f_2e_5f_b|v'one|v'zero|v'g)(?::bitstring)?\\.",
          "min": 7,
          "max": 7
        },
        {
          "regex": "=(?:v'a|v'a_2e_b|v'a_5f_b|v'a_5f_2e_5f_b|v'one|v'zero|v'g)(?![A-Za-z0-9_])",
          "min": 7,
          "max": 7
        },
        {
          "regex": "out\\(att,\\s*(?:v'a|v'a_2e_b|v'a_5f_b|v'a_5f_2e_5f_b|v'one|v'zero|v'g)\\)",
          "min": 7,
          "max": 7
        },
        {
          "regex": "free v'a_5f_2(?::bitstring)?\\.",
          "min": 1,
          "max": 1
        },
        {
          "regex": "=v'a_5f_2(?![A-Za-z0-9_])",
          "min": 1,
          "max": 1
        },
        {
          "regex": "out\\(att,va_5f(?:_\\d+)?\\)",
          "min": 1,
          "max": 1
        }
      ]
    },
    {
      "name": "proverifequiv",
      "args": [
        "--output-module=proverifequiv",
        "--quit-on-warning"
      ],
      "matches": [
        {
          "regex": "free (?:v'a|v'a_2e_b|v'a_5f_b|v'a_5f_2e_5f_b|v'one|v'zero|v'g)(?::bitstring)?\\.",
          "min": 7,
          "max": 7
        },
        {
          "regex": "=(?:v'a|v'a_2e_b|v'a_5f_b|v'a_5f_2e_5f_b|v'one|v'zero|v'g)(?![A-Za-z0-9_])",
          "min": 14,
          "max": 14
        },
        {
          "regex": "out\\(att,\\s*(?:v'a|v'a_2e_b|v'a_5f_b|v'a_5f_2e_5f_b|v'one|v'zero|v'g)\\)",
          "min": 14,
          "max": 14
        },
        {
          "regex": "free v'a_5f_2(?::bitstring)?\\.",
          "min": 1,
          "max": 1
        },
        {
          "regex": "=v'a_5f_2(?![A-Za-z0-9_])",
          "min": 2,
          "max": 2
        },
        {
          "regex": "out\\(att,va_5f(?:_\\d+)?\\)",
          "min": 2,
          "max": 2
        }
      ]
    },
    {
      "name": "deepsec",
      "args": [
        "--output-module=deepsec",
        "--quit-on-warning"
