{
  "tests": [
    {
      "name": "typed-export",
      "args": ["--output-module=spthytyped", "--quit-on-warning"],
      "matches": [
        {"regex": "let\\s+P\\s*\\(\\s*\\)", "min": 1, "max": 1, "theory_only": true},
        {"regex": "x\\.[0-9]+:a", "min": 3, "max": 3, "theory_only": true}
      ]
    }
  ]
}
