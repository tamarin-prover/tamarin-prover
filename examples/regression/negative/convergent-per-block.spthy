theory ConvergentPerBlock begin

/* [convergent] only exempts the equations of its own block from the subterm
   check, independently of the order of the blocks. */

functions: h/1, k/1, g/1

#ifdef MARKED_FIRST
equations [convergent]: g(x) = k(x)
#endif
#ifdef UNMARKED
equations: h(x) = k(x)
#endif
#ifdef MARKED_LAST
equations [convergent]: g(x) = k(x)
#endif

rule A: [ In(x) ] --[ Seen(x) ]-> [ ]

end
