lemma rand_autn_src [right, sources]:
  all-traces
  "∀ RAND AUTN #i.
    (Out_Src( RAND, AUTN ) @ #i) ⇒
    (∃ #j. (Src( RAND, AUTN ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ RAND AUTN #i.
  (Out_Src( RAND, AUTN ) @ #i)
 ∧
  ∀ #j. (Src( RAND, AUTN ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

