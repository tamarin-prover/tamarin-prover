     (Learn_H_ySG( H2, S, <'ySG', ySG> ) @ #m2))"
/*
guarded formula characterizing all satisfying traces:
"(∀ #s1 #s2. (Setup( ) @ #s1) ∧ (Setup( ) @ #s2) ⇒ #s1 = #s2) ∧
 (∃ #i #j1 #j2 #k1 #k2 #l #m1 #m2 S H1 H2 D1 D2 x1 x2 ySG.
   (Comm_S_Ys( S, <'ys', add(h(<H1, x1>), h(<H2, x2>))> ) @ #i) ∧
