lemma secret_x [right]:
  all-traces
  "∀ D x #i. (Secret( D, x ) @ #i) ⇒ (¬(∃ #j. K( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ D x #i. (Secret( D, x ) @ #i) ∧ ∃ #j. (K( x ) @ #j)"
*/
by sorry

lemma secret_x [left]:
  all-traces
  "∀ D x #i. (Secret( D, x ) @ #i) ⇒ (¬(∃ #j. K( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ D x #i. (Secret( D, x ) @ #i) ∧ ∃ #j. (K( x ) @ #j)"
*/
by sorry

lemma agreementHwrtS [right]:
  all-traces
  "(∀ H S x #i.
     (Learn_H_Ys( H, S, x ) @ #i) ⇒
     (∃ #j. (Comm_S_Ys( S, x ) @ #j) ∧ (#j < #i))) ∧
   (∀ H S x #i.
     (Learn_H_ySG( H, S, x ) @ #i) ⇒
     (∃ #j. (Comm_S_ySG( S, x ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"((∃ H S x #i.
    (Learn_H_Ys( H, S, x ) @ #i)
   ∧
    ∀ #j. (Comm_S_Ys( S, x ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ H S x #i.
    (Learn_H_ySG( H, S, x ) @ #i)
   ∧
    ∀ #j. (Comm_S_ySG( S, x ) @ #j) ⇒ ¬(#j < #i)))"
*/
by sorry

