    ) @ #k2) ∧
   (Comm_S_ySG( S, <'ySG', ySG> ) @ #l) ∧
   (Learn_H_ySG( H1, S, <'ySG', ySG> ) @ #m1) ∧
   (Learn_H_ySG( H2, S, <'ySG', ySG> ) @ #m2)
  ∧
   ¬(H1 = H2))"
*/
by sorry

lemma individualVerifiability_votercode [right]:
  all-traces
  "∀ H D yD #h1 S yOther #h2.
    ((Learn_H_yD( H, D, yD ) @ #h1) ∧
     (Learn_H_Ys( H, S, <'ys', add(yD, yOther)> ) @ #h2)) ⇒
    (∃ x BB y2 #b1.
      (BB_Ys( BB, 'ys', add(y2, yD) ) @ #b1) ∧ (yD = h(<H, x>)))"
/*
guarded formula characterizing all counter-examples:
"∃ H D yD #h1 S yOther #h2.
  (Learn_H_yD( H, D, yD ) @ #h1) ∧
  (Learn_H_Ys( H, S, <'ys', add(yD, yOther)> ) @ #h2)
 ∧
  ∀ x BB y2 #b1.
   (BB_Ys( BB, 'ys', add(y2, yD) ) @ #b1) ∧ (yD = h(<H, x>)) ⇒ ⊥"
*/
by sorry

