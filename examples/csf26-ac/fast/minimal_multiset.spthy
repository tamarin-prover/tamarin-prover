theory minimal_multiset begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1, add/2 [AC], unionUD/1 [destructor]
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    unionUD(add(x, y)) = x







rule (modulo E) A:
   [ Fr( ~x ) ] --> [ Out( add($A, ~x) ), S( ~x ) ]

rule (modulo E) B:
   [ S( ~x ), In( ~x ) ] --[ Reach( ) ]-> [ ]

lemma Reachable:
  exists-trace "∃ #i. Reach( ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ #i. (Reach( ) @ #i)"
*/
by sorry

end