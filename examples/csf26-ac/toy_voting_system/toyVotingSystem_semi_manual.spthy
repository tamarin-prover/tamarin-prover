theory toyVotingSystem begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: comb/2, dec/2, enc/3, fst/1, pair/2, pdec/2, pk/1,
           reenc/3, sign/2, snd/1, transform/1, true/0, verify/3, add/2[AC],
           radd/2[AC]
equations:
    comb(pdec(c, sk1), pdec(c, sk2)) = pdec(c, add(sk1, sk2)),
    dec(enc(m, pk(k), r), k) = m,
    fst(<x.1, x.2>) = x.1,
    reenc(enc(m, pk(sk), r1), r2, pk(sk))
  = enc(m, pk(sk), radd(r1, r2)),
    snd(<x.1, x.2>) = x.2,
    transform(pdec(c, k)) = dec(c, k),
    verify(sign(m, k), m, pk(k)) = true

tactic: sourceLemmas
presort: s
prio: {id}
  regex"^AUTO_OUT_TERM_.*" & not regex".*KU\(.*\).*"
prio: {id}
  regex".*AUTO_OUT_TERM_.*"
prio: {id}
  regex"AUTO_OUT_FACT_.*"
prio: {id}
  regex"!Auth\(.*\).*"







rule (modulo E) gen:
   [ Fr( ~k1 ), Fr( ~k2 ) ]
  -->
   [
   !Key( add(~k1, ~k2) ), !AuthKey1( ~k1 ), !AuthKey2( ~k2 ),
   Out( pk(add(~k1, ~k2)) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) genVoterOther:
   [ Fr( ~k ) ] --> [ !VoterKeyOther( ~k ), Out( pk(~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) genVoterDiff:
   [ Fr( ~k ) ] --> [ !VoterKeyDiff( ~k ), Out( pk(~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) genMixnet:
   [ Fr( ~k ) ] --> [ !MixnetKey( ~k ), Out( pk(~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) authentic_channel_send:
   [ AuthSend( A, B, m ) ]
  --[ AuthChan_Out( A, B, m ) ]->
   [ !Auth( A, m ), Out( m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) authentic_channel_receive:
   [ !Auth( A, m ), In( B ) ]
  --[
  AUTO_OUT_FACT_1_authorityK2( A, B, m ),
  AUTO_OUT_FACT_1_authorityK1( A, B, m ), AuthChan_In( A, B, m )
  ]->
   [ AuthRecv( A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) voteOther:
   [ !Key( authorityk ), Fr( ~r1 ), !VoterKeyOther( ~k ) ]
  --[
  AUTO_OUT_TERM_1_2_1_0_0__authority( enc('B', pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_2_2_1_0_0__authority( enc('B', pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_1_2_0_0_0__authority( enc('B', pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_2_2_0_0_0__authority( enc('B', pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_1_1_0_0__mixnet___VARIANT_4( enc('B',
                                                     pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_1_0_0__mixnet___VARIANT_4( enc('B',
                                                   pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_0_1_0_0__mixnet___VARIANT_4( enc('B',
                                                     pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_0_0_0__mixnet___VARIANT_4( enc('B',
                                                   pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_1_1_0_0__mixnet___VARIANT_3( enc('B',
                                                     pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_1_0_0__mixnet___VARIANT_3( enc('B',
                                                   pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_0_1_0_0__mixnet___VARIANT_2( enc('B',
                                                     pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_0_0_0__mixnet___VARIANT_2( enc('B',
                                                   pk(authorityk), ~r1)
  ),
  VoterA( <enc('B', pk(authorityk), ~r1), 
           sign(enc('B', pk(authorityk), ~r1), ~k)>
  )
  ]->
   [
   Out( <enc('B', pk(authorityk), ~r1), 
         sign(enc('B', pk(authorityk), ~r1), ~k)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) voteDiff:
   [ !Key( authorityk ), Fr( ~r1 ), !VoterKeyDiff( ~k ) ]
  --[
  AUTO_OUT_TERM_1_2_1_0_0__authority( enc('A', pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_2_2_1_0_0__authority( enc('A', pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_1_2_0_0_0__authority( enc('A', pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_2_2_0_0_0__authority( enc('A', pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_1_1_0_0__mixnet___VARIANT_4( enc('A',
                                                     pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_1_0_0__mixnet___VARIANT_4( enc('A',
                                                   pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_0_1_0_0__mixnet___VARIANT_4( enc('A',
                                                     pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_0_0_0__mixnet___VARIANT_4( enc('A',
                                                   pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_1_1_0_0__mixnet___VARIANT_3( enc('A',
                                                     pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_1_0_0__mixnet___VARIANT_3( enc('A',
                                                   pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_0_1_0_0__mixnet___VARIANT_2( enc('A',
                                                     pk(authorityk), ~r1)
  ),
  AUTO_OUT_TERM_5_0_0_0_0__mixnet___VARIANT_2( enc('A',
                                                   pk(authorityk), ~r1)
  ),
  VoterB( <enc('A', pk(authorityk), ~r1), 
           sign(enc('A', pk(authorityk), ~r1), ~k)>
  )
  ]->
   [
   Out( <enc('A', pk(authorityk), ~r1), 
         sign(enc('A', pk(authorityk), ~r1), ~k)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) mixnet:
   [
   !VoterKeyOther( kA ), !VoterKeyDiff( kB ), !Key( authorityk ),
   Fr( ~r11 ), Fr( ~r12 ),
   In( <<voteA, sign(voteA, kA)>, voteB, sign(voteB, kB)> )
   ]
  --[
  Mixnet( (reenc(voteA, ~r11, pk(authorityk))++
           reenc(voteB, ~r12, pk(authorityk)))
  ),
  Registered( <voteA, sign(voteA, kA)> ),
  Registered( <voteB, sign(voteB, kB)> )
  ]->
   [
   AuthSend( 'Mixnet', 'AuthK1',
             (reenc(voteA, ~r11, pk(authorityk))++
              reenc(voteB, ~r12, pk(authorityk)))
   ),
   AuthSend( 'Mixnet', 'AuthK2',
             (reenc(voteA, ~r11, pk(authorityk))++
              reenc(voteB, ~r12, pk(authorityk)))
   )
   ]
 variants
  rule (modulo AC) mixnet___VARIANT_1:
     [
     !VoterKeyOther( kA ), !VoterKeyDiff( kB ), !Key( authorityk.4 ),
     Fr( ~r11.2 ), Fr( ~r12.3 ),
     In( <<voteA.5, sign(voteA.5, kA)>, voteB.6, sign(voteB.6, kB)> )
     ]
    --[
    Mixnet( (reenc(voteA.5, ~r11.2, pk(authorityk.4))++
             reenc(voteB.6, ~r12.3, pk(authorityk.4)))
    ),
    Registered( <voteA.5, sign(voteA.5, kA)> ),
    Registered( <voteB.6, sign(voteB.6, kB)> )
    ]->
     [
     AuthSend( 'Mixnet', 'AuthK1',
               (reenc(voteA.5, ~r11.2, pk(authorityk.4))++
                reenc(voteB.6, ~r12.3, pk(authorityk.4)))
     ),
     AuthSend( 'Mixnet', 'AuthK2',
               (reenc(voteA.5, ~r11.2, pk(authorityk.4))++
                reenc(voteB.6, ~r12.3, pk(authorityk.4)))
     )
     ]
  ,
  rule (modulo AC) mixnet___VARIANT_2:
     [
     !VoterKeyOther( kA ), !VoterKeyDiff( kB ), !Key( authorityk.4 ),
     Fr( ~r11.2 ), Fr( ~r12.3 ),
     In( <
          <enc(x.6, pk(authorityk.4), x.7), 
           sign(enc(x.6, pk(authorityk.4), x.7), kA)>, 
          voteB.5, sign(voteB.5, kB)>
     )
     ]
    --[
    AUTO_OUT_TERM_1_2_1_0_0__authority( enc(x.6, pk(authorityk.4),
                                            radd(~r11.2, x.7))
    ),
    AUTO_OUT_TERM_2_2_1_0_0__authority( enc(x.6, pk(authorityk.4),
                                            radd(~r11.2, x.7))
    ),
    AUTO_OUT_TERM_1_2_0_0_0__authority( enc(x.6, pk(authorityk.4),
                                            radd(~r11.2, x.7))
    ),
    AUTO_OUT_TERM_2_2_0_0_0__authority( enc(x.6, pk(authorityk.4),
                                            radd(~r11.2, x.7))
    ),
    AUTO_IN_TERM_5_0_0_1_0_0__mixnet___VARIANT_2( enc(x.6,
                                                      pk(authorityk.4), x.7),
                                                  x.6
    ),
    AUTO_IN_TERM_5_0_0_0_0__mixnet___VARIANT_2( enc(x.6,
                                                    pk(authorityk.4), x.7),
                                                x.6
    ),
    Mixnet( (enc(x.6, pk(authorityk.4), radd(~r11.2, x.7))++
             reenc(voteB.5, ~r12.3, pk(authorityk.4)))
    ),
    Registered( <enc(x.6, pk(authorityk.4), x.7), 
                 sign(enc(x.6, pk(authorityk.4), x.7), kA)>
    ),
    Registered( <voteB.5, sign(voteB.5, kB)> )
    ]->
     [
     AuthSend( 'Mixnet', 'AuthK1',
               (enc(x.6, pk(authorityk.4), radd(~r11.2, x.7))++
                reenc(voteB.5, ~r12.3, pk(authorityk.4)))
     ),
     AuthSend( 'Mixnet', 'AuthK2',
               (enc(x.6, pk(authorityk.4), radd(~r11.2, x.7))++
                reenc(voteB.5, ~r12.3, pk(authorityk.4)))
     )
     ]
  ,
  rule (modulo AC) mixnet___VARIANT_3:
     [
     !VoterKeyOther( kA ), !VoterKeyDiff( kB ), !Key( authorityk.4 ),
     Fr( ~r11.2 ), Fr( ~r12.3 ),
     In( <<voteA.5, sign(voteA.5, kA)>, 
          enc(x.6, pk(authorityk.4), x.7), 
          sign(enc(x.6, pk(authorityk.4), x.7), kB)>
     )
     ]
    --[
    AUTO_OUT_TERM_1_2_1_0_0__authority( enc(x.6, pk(authorityk.4),
                                            radd(~r12.3, x.7))
    ),
    AUTO_OUT_TERM_2_2_1_0_0__authority( enc(x.6, pk(authorityk.4),
                                            radd(~r12.3, x.7))
    ),
    AUTO_OUT_TERM_1_2_0_0_0__authority( enc(x.6, pk(authorityk.4),
                                            radd(~r12.3, x.7))
    ),
    AUTO_OUT_TERM_2_2_0_0_0__authority( enc(x.6, pk(authorityk.4),
                                            radd(~r12.3, x.7))
    ),
    AUTO_IN_TERM_5_0_1_1_0_0__mixnet___VARIANT_3( enc(x.6,
                                                      pk(authorityk.4), x.7),
                                                  x.6
    ),
    AUTO_IN_TERM_5_0_1_0_0__mixnet___VARIANT_3( enc(x.6,
                                                    pk(authorityk.4), x.7),
                                                x.6
    ),
    Mixnet( (enc(x.6, pk(authorityk.4), radd(~r12.3, x.7))++
             reenc(voteA.5, ~r11.2, pk(authorityk.4)))
    ),
    Registered( <voteA.5, sign(voteA.5, kA)> ),
    Registered( <enc(x.6, pk(authorityk.4), x.7), 
                 sign(enc(x.6, pk(authorityk.4), x.7), kB)>
    )
    ]->
     [
     AuthSend( 'Mixnet', 'AuthK1',
               (enc(x.6, pk(authorityk.4), radd(~r12.3, x.7))++
                reenc(voteA.5, ~r11.2, pk(authorityk.4)))
     ),
     AuthSend( 'Mixnet', 'AuthK2',
               (enc(x.6, pk(authorityk.4), radd(~r12.3, x.7))++
                reenc(voteA.5, ~r11.2, pk(authorityk.4)))
     )
     ]
  ,
  rule (modulo AC) mixnet___VARIANT_4:
     [
     !VoterKeyOther( kA ), !VoterKeyDiff( kB ), !Key( authorityk.4 ),
     Fr( ~r11.2 ), Fr( ~r12.3 ),
     In( <
          <enc(x.5, pk(authorityk.4), x.6), 
           sign(enc(x.5, pk(authorityk.4), x.6), kA)>, 
          enc(x.7, pk(authorityk.4), x.8), 
          sign(enc(x.7, pk(authorityk.4), x.8), kB)>
     )
     ]
    --[
    AUTO_OUT_TERM_1_2_1_0_0__authority( enc(x.5, pk(authorityk.4),
                                            radd(~r11.2, x.6))
    ),
    AUTO_OUT_TERM_1_2_1_0_0__authority( enc(x.7, pk(authorityk.4),
                                            radd(~r12.3, x.8))
    ),
    AUTO_OUT_TERM_2_2_1_0_0__authority( enc(x.5, pk(authorityk.4),
                                            radd(~r11.2, x.6))
    ),
    AUTO_OUT_TERM_2_2_1_0_0__authority( enc(x.7, pk(authorityk.4),
                                            radd(~r12.3, x.8))
    ),
    AUTO_OUT_TERM_1_2_0_0_0__authority( enc(x.5, pk(authorityk.4),
                                            radd(~r11.2, x.6))
    ),
    AUTO_OUT_TERM_1_2_0_0_0__authority( enc(x.7, pk(authorityk.4),
                                            radd(~r12.3, x.8))
    ),
    AUTO_OUT_TERM_2_2_0_0_0__authority( enc(x.5, pk(authorityk.4),
                                            radd(~r11.2, x.6))
    ),
    AUTO_OUT_TERM_2_2_0_0_0__authority( enc(x.7, pk(authorityk.4),
                                            radd(~r12.3, x.8))
    ),
    AUTO_IN_TERM_5_0_1_1_0_0__mixnet___VARIANT_4( enc(x.7,
                                                      pk(authorityk.4), x.8),
                                                  x.7
    ),
    AUTO_IN_TERM_5_0_1_0_0__mixnet___VARIANT_4( enc(x.7,
                                                    pk(authorityk.4), x.8),
                                                x.7
    ),
    AUTO_IN_TERM_5_0_0_1_0_0__mixnet___VARIANT_4( enc(x.5,
                                                      pk(authorityk.4), x.6),
                                                  x.5
    ),
    AUTO_IN_TERM_5_0_0_0_0__mixnet___VARIANT_4( enc(x.5,
                                                    pk(authorityk.4), x.6),
                                                x.5
    ),
    Mixnet( (enc(x.5, pk(authorityk.4), radd(~r11.2, x.6))++
             enc(x.7, pk(authorityk.4), radd(~r12.3, x.8)))
    ),
    Registered( <enc(x.5, pk(authorityk.4), x.6), 
                 sign(enc(x.5, pk(authorityk.4), x.6), kA)>
    ),
    Registered( <enc(x.7, pk(authorityk.4), x.8), 
                 sign(enc(x.7, pk(authorityk.4), x.8), kB)>
    )
    ]->
     [
     AuthSend( 'Mixnet', 'AuthK1',
               (enc(x.5, pk(authorityk.4), radd(~r11.2, x.6))++
                enc(x.7, pk(authorityk.4), radd(~r12.3, x.8)))
     ),
     AuthSend( 'Mixnet', 'AuthK2',
               (enc(x.5, pk(authorityk.4), radd(~r11.2, x.6))++
                enc(x.7, pk(authorityk.4), radd(~r12.3, x.8)))
     )
     ]

rule (modulo E) authorityK1:
   [ !AuthKey1( sk1 ), AuthRecv( 'Mixnet', 'AuthK1', (Amix++Bmix) ) ]
  --[
  AUTO_IN_FACT_1_authorityK1( 'Mixnet', 'AuthK1', (Amix++Bmix) ),
  PartialDec1( (pdec(Amix, sk1)++pdec(Bmix, sk1)) )
  ]->
   [
   AuthSend( 'AuthK1', 'AuthFinal', (pdec(Amix, sk1)++pdec(Bmix, sk1))
   )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) authorityK2:
   [ !AuthKey2( sk2 ), AuthRecv( 'Mixnet', 'AuthK2', (Amix++Bmix) ) ]
  --[
  AUTO_IN_FACT_1_authorityK2( 'Mixnet', 'AuthK2', (Amix++Bmix) ),
  PartialDec2( (pdec(Amix, sk2)++pdec(Bmix, sk2)) )
  ]->
   [
   AuthSend( 'AuthK2', 'AuthFinal', (pdec(Amix, sk2)++pdec(Bmix, sk2))
   )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) authority:
   [
   !Key( add(k1, k2) ),
   AuthRecv( 'AuthK1', 'AuthFinal',
             (pdec(enc(voteA, pk(add(k1, k2)), rA), k1)++
              pdec(enc(voteB, pk(add(k1, k2)), rB), k1))
   ),
   AuthRecv( 'AuthK2', 'AuthFinal',
             (pdec(enc(voteA, pk(add(k1, k2)), rA), k2)++
              pdec(enc(voteB, pk(add(k1, k2)), rB), k2))
   )
   ]
  --[
  AUTO_IN_TERM_1_2_1_0_0__authority( enc(voteB, pk(add(k1, k2)), rB),
                                     voteB
  ),
  AUTO_IN_TERM_2_2_1_0_0__authority( enc(voteB, pk(add(k1, k2)), rB),
                                     voteB
  ),
  AUTO_IN_TERM_1_2_0_0_0__authority( enc(voteA, pk(add(k1, k2)), rA),
                                     voteA
  ),
  AUTO_IN_TERM_2_2_0_0_0__authority( enc(voteA, pk(add(k1, k2)), rA),
                                     voteA
  ),
  Final( (voteA++voteB) ), VotePublished( voteA ),
  VotePublished( voteB )
  ]->
   [ Out( (voteA++voteB) ) ]

  /* has exactly the trivial AC variant */

lemma exec:
  exists-trace
  "∃ vA vB pak r1 r11 r2 r12 kA kB sk1 sk2 #g #hh #i #j #k #l.
    (((((((((((VoterA( <enc(vA, pak, r1), sign(enc(vA, pak, r1), kA)>
               ) @ #g) ∧
              (VoterB( <enc(vB, pak, r2), sign(enc(vB, pak, r2), kB)> ) @ #hh)) ∧
             (Mixnet( (enc(vA, pak, radd(r1, r11))++enc(vB, pak, radd(r12, r2)))
              ) @ #i)) ∧
            (PartialDec1( (pdec(enc(vA, pak, radd(r1, r11)), sk1)++
                           pdec(enc(vB, pak, radd(r12, r2)), sk1))
             ) @ #j)) ∧
           (PartialDec2( (pdec(enc(vA, pak, radd(r1, r11)), sk2)++
                          pdec(enc(vB, pak, radd(r12, r2)), sk2))
            ) @ #k)) ∧
          (Final( (vA++vB) ) @ #l)) ∧
         (#g < #i)) ∧
        (#hh < #i)) ∧
       (#i < #j)) ∧
      (#i < #k)) ∧
     (#j < #l)) ∧
    (#k < #l)"
/*
guarded formula characterizing all satisfying traces:
"∃ vA vB pak r1 r11 r2 r12 kA kB sk1 sk2 #g #hh #i #j #k #l.
  (VoterA( <enc(vA, pak, r1), sign(enc(vA, pak, r1), kA)> ) @ #g) ∧
  (VoterB( <enc(vB, pak, r2), sign(enc(vB, pak, r2), kB)> ) @ #hh) ∧
  (Mixnet( (enc(vA, pak, radd(r1, r11))++enc(vB, pak, radd(r12, r2)))
   ) @ #i) ∧
  (PartialDec1( (pdec(enc(vA, pak, radd(r1, r11)), sk1)++
                 pdec(enc(vB, pak, radd(r12, r2)), sk1))
   ) @ #j) ∧
  (PartialDec2( (pdec(enc(vA, pak, radd(r1, r11)), sk2)++
                 pdec(enc(vB, pak, radd(r12, r2)), sk2))
   ) @ #k) ∧
  (Final( (vA++vB) ) @ #l)
 ∧
  (#g < #i) ∧
  (#hh < #i) ∧
  (#i < #j) ∧
  (#i < #k) ∧
  (#j < #l) ∧
  (#k < #l)"
*/
by sorry

lemma eligibility:
  all-traces
  "∀ vA #j.
    (VotePublished( vA ) @ #j) ⇒
    (∃ pak r1 kA #i.
      (Registered( <enc(vA, pak, r1), sign(enc(vA, pak, r1), kA)>
       ) @ #i) ∧
      (#i < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ vA #j.
  (VotePublished( vA ) @ #j)
 ∧
  ∀ pak r1 kA #i.
   (Registered( <enc(vA, pak, r1), sign(enc(vA, pak, r1), kA)> ) @ #i)
  ⇒
   ¬(#i < #j)"
*/
by sorry































lemma AUTO_typing [sources]:
  all-traces
  "((((((((((((((⊤) ∧
                (∀ x m #i.
                  (AUTO_IN_TERM_5_0_0_0_0__mixnet___VARIANT_2( m, x ) @ #i) ⇒
                  ((∃ #j. (!KU( x ) @ #j) ∧ (#j < #i)) ∨
                   (∃ #j.
                     (AUTO_OUT_TERM_5_0_0_0_0__mixnet___VARIANT_2( m ) @ #j) ∧
