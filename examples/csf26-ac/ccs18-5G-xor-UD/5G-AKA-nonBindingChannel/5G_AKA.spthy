"∃ a b t #i.
  (Commit( a, b, <'UE', 'HSS', 'supi', t> ) @ #i)
 ∧
  (∀ UE1 UE2 UE3 #j #k #l.
    (Start_UE_Session( UE1 ) @ #j) ∧
    (Start_UE_Session( UE2 ) @ #k) ∧
    (Start_UE_Session( UE3 ) @ #l)
