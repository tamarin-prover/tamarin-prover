theory CH07_UK1 begin

builtins: hashing, multiset
functions: rot/2, lh/1, rh/1, xorr/2[AC], zeroo/0
equations: xorr(xorr(x,y),x) = y,
	   xorr(x,x) = zeroo,
	   xorr(x,zeroo) = x

rule setup:
   let data1 = <~k1,~id1>
       data2 = <~k2,~id2>
       datab = diff(data1, data2)
   in
   [ Fr( ~k1 )
   , Fr( ~id1 )
   , Fr( ~k2 )
   , Fr( ~id2 ) 
   ]
--[ OnlyOnce('setup') ]->
   [ TagRun(data1, 'learning')
   , TagRun(data2, 'learning')
   , TagRun(datab, 'guessing')
   ]

rule reader1:
   [ Fr( ~r1 ) ]
 --[ Challenge( ~r1, 'Reader' ) ]->
   [ Out( ~r1 )
   , Initiated( ~r1 ) 
   ]

rule tag1:
   let hash = h(xorr(r1,~r2,~k)) in
   [ In( r1 )
   , Fr( ~r2 )
   , TagRun( <~k, ~id>, phase )
   ]
 --[ Response( ~k, 'Tag' )
   , Challenge(~r2, 'Tag') 
   , Phase(phase)
   ]->
   [ Out( <~r2,lh(xorr(rot(~id,hash),hash))>)
   , TagState(~k, ~id, r1, ~r2, hash, phase)
   ]

rule reader2:
   [ Initiated( ~r1 )
   , ReaderRun( <~k, ~id>, phase)
   , In( <r2, lh(xorr(rot(~id,hash),hash))> ) 
   ]
 --[ Alive( ~k, 'Tag' )
   , Response(~k, 'Reader') 
   , Eq( h(xorr(~r1,r2,~k)), hash ) 
   , Phase(phase)
   ]->
   [ Out( rh(xorr(rot(~id,hash),hash)) ) ]

rule tag2:
   [ In( rh(xorr(rot(~id,hash),hash)) )
   , TagState(~k, ~id, r1, ~r2, hash, phase)
   ]
 --[ Alive( ~k, 'Reader' ), Phase(phase) ]->
   [ ]

restriction equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"

restriction unique:
  "∀ x #i #j. ((OnlyOnce(x) @ #i) ∧ (OnlyOnce(x) @ #j)) ⇒ (#i = #j)"

// FINDS PROOF AUTOMATICALLY [left+right]
lemma executable:
  exists-trace "∃ x #j. ((Response( x, 'Tag' ) @ #j))"

// Observational Equivalence: PROVEN automatically, <=10 minutes

end
