theory LD07_UK2 begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, h/1, pair/2, snd/1, xorr/2 [AC], zeroo/0
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    xorr(xorr(x, y), x) = y,
    xorr(x, x) = zeroo,
    xorr(x, zeroo) = x







rule (modulo E) Setup:
   [ Fr( ~k0 ), Fr( ~k1 ), Fr( ~k2 ), Fr( ~r ), Fr( ~secondTag ) ]
  --[ Setup( diff(~k0, ~secondTag) ), OnlyOnce( 'setup' ) ]->
   [
   Out( <~r, h(xorr(~k0, ~k1, ~r)), xorr(~k1, ~k2), h(xorr(~k0, ~k2))>
   ),
   Tag( diff(~k0, ~secondTag),
        diff(xorr(~k0, ~k2), xorr(~k2, ~secondTag))
   )
   ]

rule (modulo E) tag1:
   [ In( r1 ), Tag( ~k, x ) ]
  --[
  Response( ~k, 'Tag' ), Challenge( x, 'Tag' ), Tag( ~k, x ),
  Running( ~k, 'Tag', x ), OnlyOnce( 'tag1' )
  ]->
   [ Out( h(xorr(r1, x)) ), Tag( ~k, x ), TagRunning( ~k, x ) ]

rule (modulo E) tag2:
   [ In( <newkey, newhash> ), TagRunning( ~k, x ) ]
  --[
  Update( ~k, xorr(newkey, x), 'Tag' ),
  Eq( h(xorr(newkey, x)), newhash ), Alive( ~k, 'Reader' ),
  OnlyOnce( 'tag2' )
  ]->
   [ Tag( ~k, xorr(newkey, x) ) ]

restriction equality [right]:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction equality [left]:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction unique [right]:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction unique [left]:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma executable [right]:
  exists-trace
  "∃ x y #i #j.
    ((Response( x, 'Tag' ) @ #i) ∧ (Update( x, y, 'Tag' ) @ #j)) ∧
    (¬(∃ #l. (Response( x, 'Tag' ) @ #l) ∧ (¬(#i = #l))))"
/*
guarded formula characterizing all satisfying traces:
"∃ x y #i #j.
  (Response( x, 'Tag' ) @ #i) ∧ (Update( x, y, 'Tag' ) @ #j)
 ∧
  ∀ #l. (Response( x, 'Tag' ) @ #l) ⇒ #i = #l"
*/
by sorry

lemma executable [left]:
  exists-trace
  "∃ x y #i #j.
    ((Response( x, 'Tag' ) @ #i) ∧ (Update( x, y, 'Tag' ) @ #j)) ∧
    (¬(∃ #l. (Response( x, 'Tag' ) @ #l) ∧ (¬(#i = #l))))"
/*
guarded formula characterizing all satisfying traces:
"∃ x y #i #j.
  (Response( x, 'Tag' ) @ #i) ∧ (Update( x, y, 'Tag' ) @ #j)
 ∧
  ∀ #l. (Response( x, 'Tag' ) @ #l) ⇒ #i = #l"
*/
by sorry

end