theory CH07_UK2 begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, h/1, lh/1, pair/2, rh/1, rot/2, snd/1,
           xorr/2 [AC], zeroo/0
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    xorr(xorr(x, y), x) = y,
    xorr(x, x) = zeroo,
    xorr(x, zeroo) = x







rule (modulo E) setup:
   [ Fr( ~k1 ), Fr( ~id1 ), Fr( ~k2 ), Fr( ~id2 ) ]
  --[ OnlyOnce( 'setup' ) ]->
   [
   Transcript( <~k1, ~id1>, 'learning' ),
   Reader( (<~k1, ~id1>++<~k2, ~id2>), 'guessing' ),
   TagRun( diff(<~k1, ~id1>, <~k2, ~id2>), 'guessing' )
   ]

rule (modulo E) transcript:
   [ Transcript( <~k, ~id>, phase ), Fr( ~r1 ), Fr( ~r2 ) ]
  --[ Phase( phase ) ]->
   [
   Out( ~r1 ),
   Out( <~r2, ~r2, 
         lh(xorr(h(xorr(~k, ~r1, ~r2)), rot(~id, h(xorr(~k, ~r1, ~r2)))))>
   ),
   Out( rh(xorr(h(xorr(~k, ~r1, ~r2)),
                rot(~id, h(xorr(~k, ~r1, ~r2)))))
   )
   ]

rule (modulo E) initiatereader:
   [ Reader( (d1++d2), phase ), Fr( ~r0 ) ]
  --[ Phase( phase ) ]->
   [ ReaderRun( d1, phase ) ]

rule (modulo E) reader1:
   [ Fr( ~r1 ) ]
  --[ Challenge( ~r1, 'Reader' ) ]->
   [ Out( ~r1 ), Initiated( ~r1 ) ]

rule (modulo E) tag1:
   [ In( r1 ), Fr( ~r2 ), TagRun( <~k, ~id>, phase ) ]
  --[ Response( ~k, 'Tag' ), Challenge( ~r2, 'Tag' ), Phase( phase )
  ]->
   [
   Out( <~r2, 
         lh(xorr(h(xorr(~k, ~r2, r1)), rot(~id, h(xorr(~k, ~r2, r1)))))>
   ),
   TagState( ~k, ~id, r1, ~r2, h(xorr(~k, ~r2, r1)), phase )
   ]

rule (modulo E) reader2:
   [
   Initiated( ~r1 ), ReaderRun( <~k, ~id>, phase ),
   In( <r2, lh(xorr(hash, rot(~id, hash)))> )
   ]
  --[
  Alive( ~k, 'Tag' ), Response( ~k, 'Reader' ),
  Eq( h(xorr(~k, ~r1, r2)), hash ), Phase( phase )
  ]->
   [ Out( rh(xorr(hash, rot(~id, hash))) ) ]

rule (modulo E) tag2:
   [
   In( rh(xorr(hash, rot(~id, hash))) ),
   TagState( ~k, ~id, r1, ~r2, hash, phase )
   ]
  --[ Alive( ~k, 'Reader' ), Phase( phase ) ]->
   [ ]

restriction equality [right]:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction equality [left]:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction unique [right]:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction unique [left]:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma executable [right]:
  exists-trace "∃ x #j. Response( x, 'Tag' ) @ #j"
/*
guarded formula characterizing all satisfying traces:
"∃ x #j. (Response( x, 'Tag' ) @ #j)"
*/
by sorry

lemma executable [left]:
  exists-trace "∃ x #j. Response( x, 'Tag' ) @ #j"
/*
guarded formula characterizing all satisfying traces:
"∃ x #j. (Response( x, 'Tag' ) @ #j)"
*/
by sorry

end
