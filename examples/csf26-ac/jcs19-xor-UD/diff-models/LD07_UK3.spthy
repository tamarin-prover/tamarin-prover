theory LD07_UK3 begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: fst/1, h/1, pair/2, snd/1, xorr/2 [AC], zeroo/0
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    xorr(xorr(x, y), x) = y,
    xorr(x, x) = zeroo,
    xorr(x, zeroo) = x







rule (modulo E) SetupLearning:
   [ Fr( ~k ), Fr( ~k1 ) ]
  --[ Setup( ~k ), OnlyOnce( 'setup' ) ]->
   [ Tag( ~k, xorr(~k, ~k1) ) ]

rule (modulo E) tag1:
   [ In( r1 ), Tag( ~k, x ) ]
  --[
  Response( ~k, 'Tag' ), Challenge( x, 'Tag' ), Tag( ~k, x ),
  Running( ~k, 'Tag', x )
  ]->
   [ Out( h(xorr(r1, x)) ), Tag( ~k, x ) ]

rule (modulo E) tag2:
   [ Fr( ~k2 ), Fr( ~k3 ), In( <newKey, newhash> ), Tag( ~k, x ) ]
  --[
  Eq( h(xorr(newKey, x)), newhash ), Alive( ~k, 'Reader' ),
  Update( x, newKey, 'Tag' )
  ]->
   [ Tag( diff(~k, ~k2), diff(xorr(newKey, x), xorr(~k2, ~k3)) ) ]

restriction equality [right]:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction equality [left]:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction unique [right]:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction unique [left]:
  "∀ x #i #j.
    ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma executable [right]:
  exists-trace
  "∃ x y #i #j.
    (((Challenge( x, 'Tag' ) @ #i) ∧ (Update( x, y, 'Tag' ) @ #j)) ∧
     (¬(y = zeroo))) ∧
    (¬(∃ #l. (Challenge( x, 'Tag' ) @ #l) ∧ (¬(#i = #l))))"
/*
guarded formula characterizing all satisfying traces:
"∃ x y #i #j.
  (Challenge( x, 'Tag' ) @ #i) ∧ (Update( x, y, 'Tag' ) @ #j)
 ∧
  (¬(y = zeroo)) ∧ (∀ #l. (Challenge( x, 'Tag' ) @ #l) ⇒ #i = #l)"
*/
by sorry

lemma executable [left]:
  exists-trace
  "∃ x y #i #j.
    (((Challenge( x, 'Tag' ) @ #i) ∧ (Update( x, y, 'Tag' ) @ #j)) ∧
     (¬(y = zeroo))) ∧
    (¬(∃ #l. (Challenge( x, 'Tag' ) @ #l) ∧ (¬(#i = #l))))"
/*
guarded formula characterizing all satisfying traces:
"∃ x y #i #j.
  (Challenge( x, 'Tag' ) @ #i) ∧ (Update( x, y, 'Tag' ) @ #j)
 ∧
  (¬(y = zeroo)) ∧ (∀ #l. (Challenge( x, 'Tag' ) @ #l) ⇒ #i = #l)"
*/
by sorry

end
