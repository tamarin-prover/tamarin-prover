theory LAK06 begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, snd/1, xorr/2 [AC], zeroo/0
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    xorr(xorr(x, y), x) = y,
    xorr(x, x) = zeroo,
    xorr(x, zeroo) = x









rule (modulo E) setup:
   [ Fr( ~k ) ]
  --[ OnlyOnce( 'setup' ), Create( ~k ) ]->
   [ !Reader( ~k ), !Tag( ~k ) ]

rule (modulo E) initiatereader:
   [ !Reader( ~k ), Fr( ~r0 ) ]
  --[ OnlyOnce( 'initiareader' ) ]->
   [ ReaderState1( ~k, ~r0 ), Out( ~r0 ) ]

rule (modulo E) tag1:
   [ !Tag( ~k ), Fr( ~r1 ), In( r0 ) ]
  --[ Running( <'R', 'T', ~k, r0, ~r1> ) ]->
   [ TagState1( ~k, ~r1, r0 ), Out( <~r1, h(xorr(~k, ~r1, r0))> ) ]

rule (modulo E) acceptreader:
   [ ReaderState1( ~k, ~r0 ), In( <r1, h(xorr(~k, ~r0, r1))> ) ]
  --[
  Commit( <'R', 'T', ~k, ~r0, r1> ),
  Running( <'T', 'R', ~k, ~r0, r1> )
  ]->
   [ Out( h(xorr(~k, ~r0, h(xorr(~k, ~r0, r1)))) ) ]

rule (modulo E) accepttag:
   [
   TagState1( ~k, ~r1, r0 ),
   In( h(xorr(~k, r0, h(xorr(~k, ~r1, r0)))) )
   ]
  --[ Commit( <'T', 'R', ~k, r0, ~r1> ), FinTag( ) ]->
   [ ]

lemma executable:
  exists-trace
  "(∃ #i. FinTag( ) @ #i) ∧
   (∀ x #i1 #i2.
     ((OnlyOnce( x ) @ #i1) ∧ (OnlyOnce( x ) @ #i2)) ⇒ (#i1 = #i2))"
/*
guarded formula characterizing all satisfying traces:
"(∃ #i. (FinTag( ) @ #i)) ∧
 (∀ x #i1 #i2.
   (OnlyOnce( x ) @ #i1) ∧ (OnlyOnce( x ) @ #i2) ⇒ #i1 = #i2)"
*/
by sorry

lemma helpingSecrecy [reuse]:
  all-traces "∀ k #i. (Create( k ) @ #i) ⇒ (¬(∃ #j. K( k ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ k #i. (Create( k ) @ #i) ∧ ∃ #j. (K( k ) @ #j)"
*/
by sorry

lemma noninjectiveagreementTAG [use_induction]:
  all-traces
  "∀ t #i.
    (Commit( <'T', 'R', t> ) @ #i) ⇒
    (∃ #j. Running( <'T', 'R', t> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ t #i.
  (Commit( <'T', 'R', t> ) @ #i)
 ∧
  ∀ #j. (Running( <'T', 'R', t> ) @ #j) ⇒ ⊥"
*/
by sorry

lemma noninjectiveagreementREADER [use_induction]:
  all-traces
  "∀ t #i.
    (Commit( <'R', 'T', t> ) @ #i) ⇒
    (∃ #j. Running( <'R', 'T', t> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ t #i.
  (Commit( <'R', 'T', t> ) @ #i)
 ∧
  ∀ #j. (Running( <'R', 'T', t> ) @ #j) ⇒ ⊥"
*/
by sorry

end
