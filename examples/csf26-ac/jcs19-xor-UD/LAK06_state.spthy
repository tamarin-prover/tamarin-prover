rule (modulo E) setup:
   [ Fr( ~k ), Fr( ~id ) ]
  --[
  OnlyOnce( '2Users' ), Update( h(h(~k)), 'T' ),
  Update( h(~k), 'R1' ), Update( h(h(~k)), 'R2' ), Setup( )
  ]->
   [
   !Reader( ~id ), !Tag( ~id ), ReaderK( ~id, h(~k), h(h(~k)) ),
   TagK( ~id, h(h(~k)) )
   ]

rule (modulo E) initiatereader:
   [ !Reader( ~id ), Fr( ~r0 ) ]
  -->
   [ ReaderState1( ~id, ~r0 ), Out( ~r0 ) ]

rule (modulo E) tag1:
   [ !Tag( ~id ), TagK( ~id, k ), Fr( ~r1 ), In( r0 ) ]
  --[
  Running( <'R', 'T', k, r0, ~r1> ), Key( k, 'T' ),
  OutH( xorr(~r1, k, r0) )
  ]->
   [
   TagState1( ~id, k, ~r1, r0, h(xorr(~r1, k, r0)) ),
   Out( <~r1, h(xorr(~r1, k, r0))> ), TagK( ~id, k )
   ]

rule (modulo E) acceptreaderNew:
   [
   ReaderState1( ~id, ~r0 ), In( <r1, h(xorr(~r0, k, r1))> ),
   ReaderK( ~id, k0, k )
   ]
  --[
  Commit( <'R', 'T', k, ~r0, r1> ),
  Running( <'T', 'R', k, ~r0, r1> ), Key( k0, 'R1' ), Key( k, 'R2' ),
  Update( k, 'R1' ), Update( h(k), 'R2' ),
  OutH( h(xorr(~r0, k, h(xorr(~r0, k, r1)))) )
  ]->
   [
   Out( h(xorr(~r0, k, h(xorr(~r0, k, r1)))) ),
   ReaderK( ~id, k, h(k) )
   ]

rule (modulo E) acceptreaderOld:
   [
   ReaderState1( ~id, ~r0 ), In( <r1, h(xorr(~r0, k0, r1))> ),
   ReaderK( ~id, k0, k )
   ]
  --[
  Commit( <'R', 'T', k0, ~r0, r1> ),
  Running( <'T', 'R', k0, ~r0, r1> ), Key( k0, 'R1' ),
  Key( k, 'R2' ), OutH( h(xorr(~r0, k0, h(xorr(~r0, k0, r1)))) )
  ]->
   [
   Out( h(xorr(~r0, k0, h(xorr(~r0, k0, r1)))) ),
   ReaderK( ~id, k0, k )
   ]

rule (modulo E) accepttag:
   [
   TagState1( ~id, k, ~r1, r0, m ), In( h(xorr(k, m, r0)) ),
   TagK( ~id, k )
   ]
  --[
  Commit( <'T', 'R', k, r0, ~r1> ), FinTag( ), Key( k, 'T' ),
  Update( h(k), 'T' )
  ]->
   [ TagK( ~id, h(k) ) ]

restriction onylOnce:
  "∀ x #i1 #i2.
    ((OnlyOnce( x ) @ #i1) ∧ (OnlyOnce( x ) @ #i2)) ⇒ (#i1 = #i2)"
  // safety formula

lemma helpingUpdateKey [use_induction, reuse,
                        heuristic={helpingUpdateKey}]:
  all-traces
  "∀ k r #i.
    (Key( k, r ) @ #i) ⇒ (∃ #j. (Update( k, r ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ k r #i.
  (Key( k, r ) @ #i) ∧ ∀ #j. (Update( k, r ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma helpingStackHash [use_induction, reuse]:
  all-traces
  "(∀ k r #i. (Key( k, r ) @ #i) ⇒ (∃ k0. k = h(k0))) ∧
   (∀ k r #i. (Update( k, r ) @ #i) ⇒ (∃ k0. k = h(k0)))"
/*
guarded formula characterizing all counter-examples:
"((∃ k r #i. (Key( k, r ) @ #i) ∧ ∀ k0. (k = h(k0)) ⇒ ⊥) ∨
  (∃ k r #i. (Update( k, r ) @ #i) ∧ ∀ k0. (k = h(k0)) ⇒ ⊥))"
*/
by sorry

lemma helpingSecrecy [use_induction, reuse,
                      heuristic={helpingSecrecy}]:
  all-traces
  "∀ k r #i. (Key( k, r ) @ #i) ⇒ (¬(∃ #j. !KU( k ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ k r #i. (Key( k, r ) @ #i) ∧ ∃ #j. (!KU( k ) @ #j)"
*/
by sorry

lemma executable [heuristic={other}]:
  exists-trace
  "(∃ #i. FinTag( ) @ #i) ∧
   (∀ x #i1 #i2.
     ((OnlyOnce( x ) @ #i1) ∧ (OnlyOnce( x ) @ #i2)) ⇒ (#i1 = #i2))"
/*
guarded formula characterizing all satisfying traces:
"(∃ #i. (FinTag( ) @ #i)) ∧
 (∀ x #i1 #i2.
   (OnlyOnce( x ) @ #i1) ∧ (OnlyOnce( x ) @ #i2) ⇒ #i1 = #i2)"
*/
by sorry

lemma noninjectiveagreementTAG [use_induction,
                                heuristic={noninjectiveagreementTAG}]:
  all-traces
  "∀ t #i.
    (Commit( <'T', 'R', t> ) @ #i) ⇒
    (∃ #j. Running( <'T', 'R', t> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ t #i.
  (Commit( <'T', 'R', t> ) @ #i)
 ∧
  ∀ #j. (Running( <'T', 'R', t> ) @ #j) ⇒ ⊥"
*/
by sorry

lemma noninjectiveagreementREADER [use_induction,
                                   heuristic={other}]:
  all-traces
  "∀ t #i.
    (Commit( <'R', 'T', t> ) @ #i) ⇒
    (∃ #j. Running( <'R', 'T', t> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ t #i.
  (Commit( <'R', 'T', t> ) @ #i)
 ∧
  ∀ #j. (Running( <'R', 'T', t> ) @ #j) ⇒ ⊥"
*/
