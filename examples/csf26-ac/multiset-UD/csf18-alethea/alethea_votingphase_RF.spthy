rule (modulo E) ChanOut_S:
   [ Out_S( $A, $B, x ) ]
  --[ ChanOut_S( $A, $B, x ) ]->
   [ !Sec( $A, $B, x ) ]

rule (modulo E) ChanIn_S:
   [ !Sec( $A, $B, x ) ]
  --[ ChanIn_S( $A, $B, x ) ]->
   [ In_S( $A, $B, x ) ]

rule (modulo E) ChanOut_A:
   [ Out_A( $A, x ) ]
  --[ ChanOut_A( $A, x ) ]->
   [ !Auth( $A, x ), Out( <$A, x> ) ]

rule (modulo E) ChanIn_A:
   [ !Auth( $A, x ) ] --[ ChanIn_A( $A, x ) ]-> [ In_A( $A, x ) ]

rule (modulo E) publickeyinfrastructure:
   [ Fr( ~skX ) ]
  --[ LongtermKey( $X, ~skX ) ]->
   [ !Ltk( $X, ~skX ), !Pk( $X, pk(~skX) ), Out( pk(~skX) ) ]

rule (modulo E) Setup:
   [ !Ltk( 'S', ~skS ), Fr( ~x1 ), Fr( ~x2 ) ]
  --[
  Setup( ), SKS( ~skS ), HV( '1', h(<~x1, $ind1>) ),
  HV( '2', h(<~x2, $ind2>) ), HY( '1', h(~x1) ), HY( '2', h(~x2) ),
  V( '1', diff($vote1, $vote2) ), V( '2', diff($vote2, $vote1) ),
  Vote( 'H1', diff($vote1, $vote2) ),
  Vote( 'H2', diff($vote2, $vote1) )
  ]->
   [
   AgSt_S0( 'S',
            <~skS, 'H1', 'H2', 'D1', 'D2', ~x1, ~x2, $ind1, $ind2>
   ),
   AgSt_D0( 'D1', <'S', 'H1', pk(~skS), ~x1, $ind1> ),
   AgSt_D0( 'D2', <'S', 'H2', pk(~skS), ~x2, $ind2> ),
   Out_A( 'S', <'ySG', add(h(<'H1', ~x1>), h(<'H2', ~x2>))> ),
   AgSt_H1( 'H1', <'D1', 'S', diff($vote1, $vote2), h(<'H1', ~x1>)> ),
   AgSt_H1( 'H2', <'D2', 'S', diff($vote2, $vote1), h(<'H2', ~x2>)> ),
   Out_S( 'H1', 'D1', diff($vote1, $vote2) ),
   Out_S( 'H2', 'D2', diff($vote2, $vote1) ),
   Out( <'D1', 'S', $vote1, h(<'H1', ~x1>)> )
   ]

rule (modulo E) D_1:
   [ AgSt_D0( $D, <$S, $H, pkS, ~x, $ind> ), In_S( $H, $D, vote ) ]
  --[ Secret_x( ~x ) ]->
   [
   Out_S( $D, $H,
          <$H, 
           <cp(<vote, h(<~x, $ind>)>, pkS), cp(<h(<$H, ~x>), h(~x)>, pkS)>, 
           $ind>
   )
   ]

rule (modulo E) H_2:
   [ AgSt_H1( $H, <$D, $S, vote, y> ), In_S( $D, $H, <$H, code, ind> )
   ]
  --[
  MyCode( $H, code ), Comm_H_C( $H, $S, code ),
  Comm_H_V( $H, $S, vote )
  ]->
   [ AgSt_H2( $H, <$D, $S, vote, y, ind, code> ), Out( <code, ind> ) ]

rule (modulo E) S:
   [
   AgSt_S0( $S, <~skS, $H1, $H2, $D1, $D2, ~x1, ~x2, $ind1, $ind2> ),
   In( <
        <cp(<$vote1, h(<~x1, $ind1>)>, pk(~skS)), 
         cp(<h(<$H1, ~x1>), h(~x1)>, pk(~skS))>, 
        $ind1>
   ),
   In( <
        <cp(<$vote2, h(<~x2, $ind2>)>, pk(~skS)), 
         cp(<h(<$H2, ~x2>), h(~x2)>, pk(~skS))>, 
        $ind2>
   )
   ]
  --[
  Learn_S_C( $S, $H1,
             <cp(<$vote1, h(<~x1, $ind1>)>, pk(~skS)), 
              cp(<h(<$H1, ~x1>), h(~x1)>, pk(~skS))>
  ),
  Learn_S_C( $S, $H2,
             <cp(<$vote2, h(<~x2, $ind2>)>, pk(~skS)), 
              cp(<h(<$H2, ~x2>), h(~x2)>, pk(~skS))>
  ),
  Learn_S_V( $S, $H1, $vote1 ), Learn_S_V( $S, $H2, $vote2 ),
  Comm_S_C( $S,
            <cp(<$vote1, h(<~x1, $ind1>)>, pk(~skS)), 
             cp(<h(<$H1, ~x1>), h(~x1)>, pk(~skS))>
  ),
  Comm_S_C( $S,
            <cp(<$vote2, h(<~x2, $ind2>)>, pk(~skS)), 
             cp(<h(<$H2, ~x2>), h(~x2)>, pk(~skS))>
  ),
  BB_V( '1', 'BB', $vote1 ), BB_V( '2', 'BB', $vote2 ),
  BB_pV( '1', 'BB', <$vote1, h(<~x1, $ind1>)> ),
  BB_pV( '2', 'BB', <$vote2, h(<~x2, $ind2>)> ),
  BB_pY( '1', 'BB', <h(<$H1, ~x1>), h(~x1)> ),
  BB_pY( '2', 'BB', <h(<$H2, ~x2>), h(~x2)> ),
  BB_C( '1', 'BB',
        <cp(<$vote1, h(<~x1, $ind1>)>, pk(~skS)), 
         cp(<h(<$H1, ~x1>), h(~x1)>, pk(~skS))>
  ),
  BB_C( '2', 'BB',
        <cp(<$vote2, h(<~x2, $ind2>)>, pk(~skS)), 
         cp(<h(<$H2, ~x2>), h(~x2)>, pk(~skS))>
  ),
  BB_Cs( 'BB',
         <'codes', 
          add(<cp(<$vote1, h(<~x1, $ind1>)>, pk(~skS)), 
               cp(<h(<$H1, ~x1>), h(~x1)>, pk(~skS))>,
              <cp(<$vote2, h(<~x2, $ind2>)>, pk(~skS)), 
               cp(<h(<$H2, ~x2>), h(~x2)>, pk(~skS))>)
         >
  ),
  BB_proofV( 'BB',
             PeqPVote(<cp(<$vote1, h(<~x1, $ind1>)>, pk(~skS)), 
                       cp(<$vote2, h(<~x2, $ind2>)>, pk(~skS))>,
                      <<$vote1, h(<~x1, $ind1>)>, $vote2, h(<~x2, $ind2>)>, ~skS)
  ),
  BB_proofY( 'BB',
             PeqPY(<cp(<h(<$H1, ~x1>), h(~x1)>, pk(~skS)), 
                    cp(<h(<$H2, ~x2>), h(~x2)>, pk(~skS))>,
                   <<h(<$H1, ~x1>), h(~x1)>, h(<$H2, ~x2>), h(~x2)>, ~skS)
  )
  ]->
   [
   Out_A( $S, <'votes', add($vote1, $vote2)> ),
   Out_A( $S,
          <'pVs', add(<$vote1, h(<~x1, $ind1>)>, <$vote2, h(<~x2, $ind2>)>)>
   ),
   Out_A( $S,
          <'pYs', add(<h(<$H1, ~x1>), h(~x1)>, <h(<$H2, ~x2>), h(~x2)>)>
   ),
   Out_A( $S, <'yPrime', add(h(<$H1, ~x1>), h(<$H2, ~x2>))> ),
   Out_A( $S,
          <'codes', 
           add(<cp(<$vote1, h(<~x1, $ind1>)>, pk(~skS)), 
                cp(<h(<$H1, ~x1>), h(~x1)>, pk(~skS))>,
               <cp(<$vote2, h(<~x2, $ind2>)>, pk(~skS)), 
                cp(<h(<$H2, ~x2>), h(~x2)>, pk(~skS))>)
          >
   ),
   Out_A( $S,
          <'proofV', 
           PeqPVote(<cp(<$vote1, h(<~x1, $ind1>)>, pk(~skS)), 
                     cp(<$vote2, h(<~x2, $ind2>)>, pk(~skS))>,
                    <<$vote1, h(<~x1, $ind1>)>, $vote2, h(<~x2, $ind2>)>, ~skS)
          >
   ),
   Out_A( $S,
          <'proofY', 
           PeqPY(<cp(<h(<$H1, ~x1>), h(~x1)>, pk(~skS)), 
                  cp(<h(<$H2, ~x2>), h(~x2)>, pk(~skS))>,
                 <<h(<$H1, ~x1>), h(~x1)>, h(<$H2, ~x2>), h(~x2)>, ~skS)
          >
   )
   ]

rule (modulo E) H_3:
   [
   AgSt_H2( $H, <$D, $S, vote, y, ind, code> ),
   In_A( $S, <'codes', add(codeBBOther, mycodeBB)> )
   ]
  --[ Learn_H_C( $H, $S, mycodeBB ) ]->
   [ ]

restriction OneSetup [right]:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction OneSetup [left]:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma secret_skS [right, sources]:
  all-traces "∀ skS #i. (SKS( skS ) @ #i) ⇒ (¬(∃ #j. K( skS ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ skS #i. (SKS( skS ) @ #i) ∧ ∃ #j. (K( skS ) @ #j)"
*/
by sorry

lemma secret_skS [left, sources]:
  all-traces "∀ skS #i. (SKS( skS ) @ #i) ⇒ (¬(∃ #j. K( skS ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ skS #i. (SKS( skS ) @ #i) ∧ ∃ #j. (K( skS ) @ #j)"
*/
by sorry

lemma functional [right]:
  exists-trace
  "∃ #i #j #k H1 H2 S vote1 vote2 fstcode1 sndcode1 fstcode2 sndcode2
     skS hV1 hV2 y1 y2 hY1 hY2 #l #m #s.
    (((((((((((((((((((((((¬(H1 = H2)) ∧ (¬(vote1 = vote2))) ∧
                         (Comm_H_C( H1, S, <fstcode1, sndcode1> ) @ #i)) ∧
                        (Comm_H_V( H1, S, vote1 ) @ #i)) ∧
                       (Comm_H_C( H2, S, <fstcode2, sndcode2> ) @ #j)) ∧
                      (Comm_H_V( H2, S, vote2 ) @ #j)) ∧
                     (HV( '1', hV1 ) @ #s)) ∧
                    (V( '1', vote1 ) @ #s)) ∧
                   (HV( '2', hV2 ) @ #s)) ∧
                  (V( '2', vote2 ) @ #s)) ∧
                 (HY( '1', hY1 ) @ #s)) ∧
                (HY( '2', hY2 ) @ #s)) ∧
               (BB_C( '1', 'BB', <fstcode1, sndcode1> ) @ #k)) ∧
              (BB_C( '2', 'BB', <fstcode2, sndcode2> ) @ #k)) ∧
             (BB_V( '1', 'BB', vote1 ) @ #k)) ∧
            (BB_V( '2', 'BB', vote2 ) @ #k)) ∧
           (BB_pV( '1', 'BB', <vote1, hV1> ) @ #k)) ∧
          (BB_pV( '2', 'BB', <vote2, hV2> ) @ #k)) ∧
         (BB_proofV( 'BB',
                     PeqPVote(<fstcode1, fstcode2>, <<vote1, hV1>, vote2, hV2>, skS)
          ) @ #k)) ∧
        (BB_pY( '1', 'BB', <y1, hY1> ) @ #k)) ∧
       (BB_pY( '2', 'BB', <y2, hY2> ) @ #k)) ∧
      (BB_proofY( 'BB',
                  PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS)
       ) @ #k)) ∧
     (Learn_H_C( H1, S, <fstcode1, sndcode1> ) @ #l)) ∧
    (Learn_H_C( H2, S, <fstcode2, sndcode2> ) @ #m)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j #k H1 H2 S vote1 vote2 fstcode1 sndcode1 fstcode2 sndcode2
   skS hV1 hV2 y1 y2 hY1 hY2 #l #m #s.
  (Comm_H_C( H1, S, <fstcode1, sndcode1> ) @ #i) ∧
  (Comm_H_V( H1, S, vote1 ) @ #i) ∧
  (Comm_H_C( H2, S, <fstcode2, sndcode2> ) @ #j) ∧
  (Comm_H_V( H2, S, vote2 ) @ #j) ∧
  (HV( '1', hV1 ) @ #s) ∧
  (V( '1', vote1 ) @ #s) ∧
  (HV( '2', hV2 ) @ #s) ∧
  (V( '2', vote2 ) @ #s) ∧
  (HY( '1', hY1 ) @ #s) ∧
  (HY( '2', hY2 ) @ #s) ∧
  (BB_C( '1', 'BB', <fstcode1, sndcode1> ) @ #k) ∧
