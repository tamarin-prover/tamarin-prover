rule (modulo E) ChanOut_S:
   [ Out_S( $A, $B, x ) ]
  --[ ChanOut_S( $A, $B, x ) ]->
   [ !Sec( $A, $B, x ) ]

rule (modulo E) ChanIn_S:
   [ !Sec( $A, $B, x ) ]
  --[ ChanIn_S( $A, $B, x ) ]->
   [ In_S( $A, $B, x ) ]

rule (modulo E) ChanOut_A:
   [ Out_A( $A, x ) ]
  --[ ChanOut_A( $A, x ) ]->
   [ !Auth( $A, x ), Out( <$A, x> ) ]

rule (modulo E) ChanIn_A:
   [ !Auth( $A, x ) ] --[ ChanIn_A( $A, x ) ]-> [ In_A( $A, x ) ]

rule (modulo E) publickeyinfrastructure:
   [ Fr( ~skX ) ]
  --[ LongtermKey( $X, ~skX ) ]->
   [ !Ltk( $X, ~skX ), !Pk( $X, pk(~skX) ), Out( pk(~skX) ) ]

rule (modulo E) Setup:
   [ !Ltk( 'S', ~skS ), Fr( ~x1 ), Fr( ~x2 ) ]
  --[
  Setup( ), HV( '1', h(<~x1, $ind1>) ), HV( '2', h(<~x2, $ind2>) ),
  HY( '1', h(~x1) ), HY( '2', h(~x2) ), V( '1', 'empty' ),
  V( '2', $v2 ), X( ~x1, ~x2 )
  ]->
   [
   AgSt_H0( 'H1', <'D1', 'S', 'BB', 'empty', h(<'H1', ~x1>)> ),
   AgSt_H0( 'H2', <'D2', 'S', 'BB', $v2, h(<'H2', ~x2>)> ),
   AgSt_D0( 'D1', <'S', 'BB', 'H1', pk(~skS), ~x1, $ind1> ),
   AgSt_D0( 'D2', <'S', 'BB', 'H2', pk(~skS), ~x2, $ind2> ),
   AgSt_BB0( 'BB', <'ySG', add(h(<'H1', ~x1>), h(<'H2', ~x2>))> ),
   AgSt_Au( 'A', 'S' ),
   Out_A( 'BB', <'ySG', add(h(<'H1', ~x1>), h(<'H2', ~x2>))> ),
   Out( <~skS, 'H1', 'H2', 'D1', 'D2', ~x1, ~x2, $ind1, $ind2, 'BB'> )
   ]

rule (modulo E) H_1:
   [ AgSt_H0( $H, <$D, $S, $BB, vote, y> ) ]
  --[ Vote( $H, vote ) ]->
   [ AgSt_H1( $H, <$D, $S, $BB, vote, y> ), Out_S( $H, $D, vote ) ]

rule (modulo E) D_1:
   [ AgSt_D0( $D, <$S, $BB, $H, pkS, ~x, $ind> ), In_S( $H, $D, vote )
   ]
  -->
   [
   Out_S( $D, $H,
          <$H, 
           <cp(<vote, h(<~x, $ind>)>, pkS), cp(<h(<$H, ~x>), h(~x)>, pkS)>, 
           $ind>
   )
   ]

rule (modulo E) H_2_abstain:
   [
   AgSt_H1( $H, <$D, $S, $BB, 'empty', y> ),
   In_S( $D, $H, <$H, code, ind> )
   ]
  --[ MyCode( $H, code ) ]->
   [ AgSt_H2( $H, <$D, $S, $BB, 'empty', y, ind, code> ) ]

rule (modulo E) H_2:
   [
   AgSt_H1( $H, <$D, $S, $BB, vote, y> ),
   In_S( $D, $H, <$H, code, ind> )
   ]
  --[ MyCode( $H, code ), Comm_H_V( $H, $S, vote ) ]->
   [
   AgSt_H2( $H, <$D, $S, $BB, vote, y, ind, code> ),
   Out( <code, ind> )
   ]

rule (modulo E) BB:
   [
   AgSt_BB0( $BB, ySG ), In( <'votes', add($vote1, $vote2)> ),
   In( <'pVs', add(pV1, pV2)> ), In( <'pYs', add(pY1, pY2)> ),
   In( <'yPrime', add(yPrime1, yPrime2)> ),
   In( <'codes', add(code1, code2)> ), In( <'proofV', proofV> ),
   In( <'proofY', proofY> )
   ]
  --[
  BB_V( '1', $BB, $vote1 ), BB_V( '2', $BB, $vote2 ),
  BB_pV( '1', $BB, pV1 ), BB_pV( '2', $BB, pV2 ),
  BB_yPrime( '1', $BB, yPrime1 ), BB_yPrime( '2', $BB, yPrime2 ),
  BB_pY( '1', $BB, pY1 ), BB_pY( '2', $BB, pY2 ),
  BB_C( '1', $BB, code1 ), BB_C( '2', $BB, code2 ),
  BB_Cs( $BB, <'codes', add(code1, code2)> ),
  BB_proofV( $BB, proofV ), BB_proofY( $BB, proofY )
  ]->
   [
   Out_A( $BB, <'votes', add($vote1, $vote2)> ),
   Out_A( $BB, <'pVs', add(pV1, pV2)> ),
   Out_A( $BB, <'pYs', add(pY1, pY2)> ),
   Out_A( $BB, <'yPrime', add(yPrime1, yPrime2)> ),
   Out_A( $BB, <'codes', add(code1, code2)> ),
   Out_A( $BB, <'proofV', proofV> ), Out_A( $BB, <'proofY', proofY> )
   ]

rule (modulo E) auditor:
   [
   AgSt_Au( $A, $S ), In_A( $BB, <'ySG', add(y1, y2)> ),
   In_A( $BB, <'yPrime', add(y1, y2)> ),
   In_A( $BB, <'votes', add(v1, v2)> ),
   In_A( $BB, <'pVs', add(<v1, hV1>, <v2, hV2>)> ),
   In_A( $BB, <'pYs', add(<y1, hY1>, <y2, hY2>)> ),
   In_A( $BB,
         <'codes', add(<fstcode1, sndcode1>, <fstcode2, sndcode2>)>
   ),
   In_A( $BB, <'proofV', proofV> ), In_A( $BB, <'proofY', proofY> )
   ]
  --[
  Learn_A_Vs( $S, $A, <'votes', add(v1, v2)> ),
  Learn_A_YSGs( $S, $A, <'ySG', add(y1, y2)> ),
  Learn_A_Cs( $S, $A,
              <'codes', add(<fstcode1, sndcode1>, <fstcode2, sndcode2>)>
  ),
  VerProofV( $A, $BB, proofV, <fstcode1, fstcode2>,
             <<v1, hV1>, v2, hV2>
  ),
  VerProofY( $A, $BB, proofY, <sndcode1, sndcode2>,
             <<y1, hY1>, y2, hY2>
  )
  ]->
   [ ]

rule (modulo E) H_3:
   [
   AgSt_H2( $H, <$D, $S, $BB, vote, y, ind, code> ),
   In_A( $BB, <'codes', add(codeBBOther, mycodeBB)> )
   ]
  --[ Learn_H_C( $H, $S, mycodeBB ) ]->
   [ ]

restriction OneSetup:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction NotSendEmpty:
  "∀ #i H S. (Comm_H_V( H, S, 'empty' ) @ #i) ⇒ (⊥)"
  // safety formula

lemma functional [heuristic={functional}]:
  exists-trace
  "∃ #i1 #i2 #j1 #j2 H1 H2 S vote2 fstcode1 sndcode1 fstcode2
     sndcode2 #s hV1 hV2 hY1 hY2 x1 x2 #adv1 #adv2 #k BB skS y1 y2 A #a
     #l #m.
    ((((((((((((((((((((((((((((¬(H1 = H2)) ∧ (¬('empty' = vote2))) ∧
                              (Vote( H1, 'empty' ) @ #i1)) ∧
                             (Vote( H2, vote2 ) @ #i2)) ∧
                            (MyCode( H1, <fstcode1, sndcode1> ) @ #j1)) ∧
                           (MyCode( H2, <fstcode2, sndcode2> ) @ #j2)) ∧
                          (HV( '1', hV1 ) @ #s)) ∧
                         (V( '1', 'empty' ) @ #s)) ∧
                        (HV( '2', hV2 ) @ #s)) ∧
                       (V( '2', vote2 ) @ #s)) ∧
                      (HY( '1', hY1 ) @ #s)) ∧
                     (HY( '2', hY2 ) @ #s)) ∧
                    (X( x1, x2 ) @ #s)) ∧
                   (K( x1 ) @ #adv1)) ∧
                  (K( x2 ) @ #adv2)) ∧
                 (BB_C( '1', BB, <fstcode1, sndcode1> ) @ #k)) ∧
                (BB_C( '2', BB, <fstcode2, sndcode2> ) @ #k)) ∧
               (BB_V( '1', BB, 'empty' ) @ #k)) ∧
              (BB_V( '2', BB, vote2 ) @ #k)) ∧
             (BB_pV( '1', BB, <'empty', hV1> ) @ #k)) ∧
            (BB_pV( '2', BB, <vote2, hV2> ) @ #k)) ∧
           (BB_proofV( BB,
                       PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS)
            ) @ #k)) ∧
          (BB_pY( '1', BB, <y1, hY1> ) @ #k)) ∧
         (BB_pY( '2', BB, <y2, hY2> ) @ #k)) ∧
        (BB_proofY( BB,
                    PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS)
         ) @ #k)) ∧
       (Learn_H_C( H1, S, <fstcode1, sndcode1> ) @ #l)) ∧
      (Learn_H_C( H2, S, <fstcode2, sndcode2> ) @ #m)) ∧
     (VerProofV( A, BB,
                 PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS),
                 <fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>
      ) @ #a)) ∧
    (VerProofY( A, BB,
                PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS),
                <sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>
     ) @ #a)"
/*
guarded formula characterizing all satisfying traces:
"∃ #i1 #i2 #j1 #j2 H1 H2 S vote2 fstcode1 sndcode1 fstcode2
   sndcode2 #s hV1 hV2 hY1 hY2 x1 x2 #adv1 #adv2 #k BB skS y1 y2 A #a
   #l #m.
  (Vote( H1, 'empty' ) @ #i1) ∧
  (Vote( H2, vote2 ) @ #i2) ∧
  (MyCode( H1, <fstcode1, sndcode1> ) @ #j1) ∧
  (MyCode( H2, <fstcode2, sndcode2> ) @ #j2) ∧
  (HV( '1', hV1 ) @ #s) ∧
  (V( '1', 'empty' ) @ #s) ∧
  (HV( '2', hV2 ) @ #s) ∧
  (V( '2', vote2 ) @ #s) ∧
  (HY( '1', hY1 ) @ #s) ∧
  (HY( '2', hY2 ) @ #s) ∧
  (X( x1, x2 ) @ #s) ∧
  (K( x1 ) @ #adv1) ∧
  (K( x2 ) @ #adv2) ∧
  (BB_C( '1', BB, <fstcode1, sndcode1> ) @ #k) ∧
  (BB_C( '2', BB, <fstcode2, sndcode2> ) @ #k) ∧
  (BB_V( '1', BB, 'empty' ) @ #k) ∧
  (BB_V( '2', BB, vote2 ) @ #k) ∧
  (BB_pV( '1', BB, <'empty', hV1> ) @ #k) ∧
  (BB_pV( '2', BB, <vote2, hV2> ) @ #k) ∧
  (BB_proofV( BB,
              PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS)
   ) @ #k) ∧
  (BB_pY( '1', BB, <y1, hY1> ) @ #k) ∧
  (BB_pY( '2', BB, <y2, hY2> ) @ #k) ∧
  (BB_proofY( BB,
              PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS)
   ) @ #k) ∧
  (Learn_H_C( H1, S, <fstcode1, sndcode1> ) @ #l) ∧
  (Learn_H_C( H2, S, <fstcode2, sndcode2> ) @ #m) ∧
  (VerProofV( A, BB,
              PeqPVote(<fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>, skS),
              <fstcode1, fstcode2>, <<'empty', hV1>, vote2, hV2>
   ) @ #a) ∧
  (VerProofY( A, BB,
              PeqPY(<sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>, skS),
              <sndcode1, sndcode2>, <<y1, hY1>, y2, hY2>
   ) @ #a)
 ∧
  (¬(H1 = H2)) ∧ (¬('empty' = vote2))"
*/
by sorry

lemma indivVerif [heuristic={indivVerif}]:
  all-traces
  "∀ H S vote fstcode sndcode #i2 #i #j.
    (((Vote( H, vote ) @ #i2) ∧
      (MyCode( H, <fstcode, sndcode> ) @ #i)) ∧
     (Learn_H_C( H, S, <fstcode, sndcode> ) @ #j)) ⇒
    (∃ BB #k hV pkS codeOther.
      (BB_Cs( BB, <'codes', add(codeOther, <fstcode, sndcode>)> ) @ #k) ∧
      (fstcode = cp(<vote, hV>, pkS)))"
/*
guarded formula characterizing all counter-examples:
"∃ H S vote fstcode sndcode #i2 #i #j.
  (Vote( H, vote ) @ #i2) ∧
  (MyCode( H, <fstcode, sndcode> ) @ #i) ∧
  (Learn_H_C( H, S, <fstcode, sndcode> ) @ #j)
 ∧
  ∀ BB #k hV pkS codeOther.
   (BB_Cs( BB, <'codes', add(codeOther, <fstcode, sndcode>)> ) @ #k) ∧
   (fstcode = cp(<vote, hV>, pkS))
  ⇒
   ⊥"
*/
by sorry

lemma Universal_VerProofV_v1 [heuristic={Universal_VerProofV_v1}]:
  all-traces
  "∀ S A x1 x2 skS #a #i BB v1 v2 codes.
    (((Learn_A_Vs( S, A, <'votes', add(v1, v2)> ) @ #a) ∧
      (Learn_A_Cs( S, A, <'codes', codes> ) @ #a)) ∧
     (VerProofV( A, BB,
                 PeqPVote(<cp(x1, pk(skS)), cp(x2, pk(skS))>, <x1, x2>, skS),
                 <cp(x1, pk(skS)), cp(x2, pk(skS))>, <x1, x2>
      ) @ #i)) ⇒
    (∃ #b hV1 hV2 sndcode1 sndcode2 n1 n2.
      (((BB_Cs( BB, <'codes', codes> ) @ #b) ∧
        (BB_V( n1, BB, v1 ) @ #b)) ∧
       (BB_V( n2, BB, v2 ) @ #b)) ∧
      (codes =
       add(<cp(<v1, hV1>, pk(skS)), sndcode1>,
           <cp(<v2, hV2>, pk(skS)), sndcode2>)))"
