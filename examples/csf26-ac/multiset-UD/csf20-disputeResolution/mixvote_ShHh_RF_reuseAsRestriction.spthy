theory mixvote_ShHh_RF_reuseAsRestriction begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, decp/2, encp/3, fst/1, h/1, pair/2,
           pk/1, sg/2, snd/1, ver/2, verzkp/4, zkp/3, add/2 [AC],
           unionUD/1 [destructor]
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    decp(encp(x, r, pk(sk)), sk) = x,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    ver(sg(m, sk), pk(sk)) = m,
    unionUD(add(x, y)) = x

