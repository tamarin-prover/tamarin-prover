lemma functional [right]:
  exists-trace
  "∃ H1 H2 v1 v2 #i #j #k #i2 #j2 #k2 b1 b2 S #s1 #s2 skS #o #o2 #p
     #q BB #r #s.
    (((((((((((((((¬(H1 = H2)) ∧ (¬(v1 = v2))) ∧
                 (Vote( H1, v1 ) @ #i)) ∧
                (D1( ) @ #j)) ∧
               (Ballot( H1, b1 ) @ #k)) ∧
              (Vote( H2, v2 ) @ #i2)) ∧
             (D1( ) @ #j2)) ∧
            (Ballot( H2, b2 ) @ #k2)) ∧
           (Learn_S_ballot( S, b1 ) @ #s1)) ∧
          (Learn_S_ballot( S, b2 ) @ #s2)) ∧
         (Evidence( b1, sg(b1, skS) ) @ #o)) ∧
        (Evidence( b2, sg(b2, skS) ) @ #o2)) ∧
       (BB_rec( BB, <'b', add(b1, b2)> ) @ #p)) ∧
      (BB_tal( BB, <'v', add(v1, v2)> ) @ #q)) ∧
     (Verify( H1, b1, add(b1, b2) ) @ #r)) ∧
    (Verify( H2, b2, add(b1, b2) ) @ #s)"
/*
guarded formula characterizing all satisfying traces:
"∃ H1 H2 v1 v2 #i #j #k #i2 #j2 #k2 b1 b2 S #s1 #s2 skS #o #o2 #p
   #q BB #r #s.
  (Vote( H1, v1 ) @ #i) ∧
  (D1( ) @ #j) ∧
  (Ballot( H1, b1 ) @ #k) ∧
  (Vote( H2, v2 ) @ #i2) ∧
  (D1( ) @ #j2) ∧
  (Ballot( H2, b2 ) @ #k2) ∧
  (Learn_S_ballot( S, b1 ) @ #s1) ∧
  (Learn_S_ballot( S, b2 ) @ #s2) ∧
  (Evidence( b1, sg(b1, skS) ) @ #o) ∧
  (Evidence( b2, sg(b2, skS) ) @ #o2) ∧
  (BB_rec( BB, <'b', add(b1, b2)> ) @ #p) ∧
  (BB_tal( BB, <'v', add(v1, v2)> ) @ #q) ∧
  (Verify( H1, b1, add(b1, b2) ) @ #r) ∧
  (Verify( H2, b2, add(b1, b2) ) @ #s)
 ∧
  (¬(H1 = H2)) ∧ (¬(v1 = v2))"
*/
by sorry

